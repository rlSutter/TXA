! stdlib.txa - the TXA standard library.  A game starts with
!   INCLUDE "DSK1.STDLIB"
! and supplies ROUTINE Initialise, which sets location (and anything
! else the game needs before the first look).

INCLUDE "DSK1.LIBDEFS"
INCLUDE "DSK1.PARSER"
INCLUDE "DSK1.VERBS"
INCLUDE "DSK1.VERBS2"
INCLUDE "DSK1.TURN"

ROUTINE Main
  Initialise()
  MOVE player TO location
  MoveFloating()
  PRINT
  BuildScope()
  LookSub()
  lastscore = score
  ShowStatus()
  WHILE deadflag = 0
    IF ReadLine()
      ! an undo snapshot before every command but UNDO itself; when UNDO
      ! comes back here, UNDOSAVE gives 2 and the old command is not run
      IF WordAt(0) = 'undo'
        RunLine()
      ELSEIF UNDOSAVE() = 2
        PRINT "[Previous turn undone.]"
        BuildScope()
        ShowStatus()
      ELSE
        RunLine()
      END
    END
  END
  IF deadflag = 1
    PRINT
    PRINT "*** You have died ***"
  ELSEIF deadflag = 2
    PRINT
    PRINT "*** You have won ***"
  END
  IF max_score > 0 AND deadflag < 3
    PRINT
    WRITE "In that game you scored ", score, " out of a possible ", max_score, ", in ", turns + 1, " turn"
    IF turns <> 0
      WRITE "s"
    END
    PRINT "."
  END
END
