! libdefs.txa - the TXA standard library: names everything else uses.
!
! Attributes, properties, globals, the player, and the twelve compass
! directions.  A game INCLUDEs "DSK1.STDLIB", which includes this file
! first.

ATTRIBUTE light lit open openable locked lockable container supporter
ATTRIBUTE transparent scenery static worn wearable edible animate
ATTRIBUTE concealed visited switchable on plural proper female male neuter
ATTRIBUTE moved general     ! moved: has been carried (INITIAL no longer shows); general: the game's own

PROPERTY DESC INITIAL N S E W NE NW SE SW UP DOWN INSIDE OUTSIDE
PROPERTY DOOR_TO WITH_KEY CAPACITY BEFORE AFTER LIFE ORDERS
PROPERTY DIR            ! on a compass object: its number, 1-12 (see GoSub)
PROPERTY CANT_GO        ! a room: said instead of "You can't go that way."
PROPERTY EACH_TURN      ! a room: run (or printed) at the end of every turn there
PROPERTY DAEMON         ! a routine run every turn while StartDaemon is in force
PROPERTY TIME_LEFT      ! a timer's turns to go (give the object TIME_LEFT 0)
PROPERTY TIME_OUT       ! run when the timer reaches 0

GLOBAL player = Yourself      ! the object the player is
GLOBAL location               ! the room the player is in
GLOBAL actor                  ! who is doing the action (the player, or an order's character)
GLOBAL noun                   ! the action's first object
GLOBAL second                 ! its second object
GLOBAL action                 ! the action's number (##Take ...)
GLOBAL deadflag               ! 0 playing, 1 dead, 2 won: ends the game
GLOBAL turns                  ! commands carried out
GLOBAL itobj                  ! what IT means
GLOBAL themobj                ! THEM
GLOBAL himobj                 ! HIM
GLOBAL herobj                 ! HER
GLOBAL lastaction             ! for AGAIN
GLOBAL score                  ! points scored
GLOBAL max_score              ! the most there are (0: the game keeps no score)
GLOBAL lastscore              ! score at the last notification
GLOBAL notify_on = 1          ! say when the score changes (NOTIFY turns it off)
GLOBAL lookmode = 1           ! 1 brief, 2 verbose, 3 superbrief
GLOBAL beforehook             ! a routine the game sets to see every action first
GLOBAL afterhook              ! one that sees every action that has happened
GLOBAL endturnhook            ! one run at the end of every turn

OBJECT Yourself "yourself"
  NAME "me" "myself" "self" "yourself"
  HAS animate proper concealed
  DESC "As good-looking as ever."
END

! The compass: always in scope, so N, GO NORTH and so on parse.  DIR is
! the direction's number, which GoSub turns into the exit property.
OBJECT CompassN "north"
  NAME "n" "north"
  HAS scenery proper
  DIR 1
END
OBJECT CompassS "south"
  NAME "s" "south"
  HAS scenery proper
  DIR 2
END
OBJECT CompassE "east"
  NAME "e" "east"
  HAS scenery proper
  DIR 3
END
OBJECT CompassW "west"
  NAME "w" "west"
  HAS scenery proper
  DIR 4
END
OBJECT CompassNE "northeast"
  NAME "ne" "northeast"
  HAS scenery proper
  DIR 5
END
OBJECT CompassNW "northwest"
  NAME "nw" "northwest"
  HAS scenery proper
  DIR 6
END
OBJECT CompassSE "southeast"
  NAME "se" "southeast"
  HAS scenery proper
  DIR 7
END
OBJECT CompassSW "southwest"
  NAME "sw" "southwest"
  HAS scenery proper
  DIR 8
END
OBJECT CompassU "up"
  NAME "u" "up" "upward" "upwards"
  HAS scenery proper
  DIR 9
END
OBJECT CompassD "down"
  NAME "d" "down" "downward" "downwards"
  HAS scenery proper
  DIR 10
END
OBJECT CompassIn "inside"
  NAME "in" "inside"
  HAS scenery proper
  DIR 11
END
OBJECT CompassOut "outside"
  NAME "out" "outside"
  HAS scenery proper
  DIR 12
END
