! turn.txa - the end of a turn: daemons, timers, scoring, the status line.
!
! A turn is a command that is not a "meta" command (SCORE, VERBOSE, QUIT
! and the like take no time).  At its end: every daemon runs, every
! timer counts down (running TIME_OUT at 0), the room's EACH_TURN runs,
! then the game's endturnhook, then a note if the score changed, and the
! status line is redrawn.

ARRAY daemons 32        ! objects whose DAEMON runs every turn
ARRAY timers 32         ! objects counting down TIME_LEFT
GLOBAL ndaemons
GLOBAL ntimers

ROUTINE StartDaemon o
  LOCAL k
  WHILE k < ndaemons
    IF daemons(k) = o
      RETURN
    END
    k = k + 1
  END
  IF ndaemons < 32
    daemons(ndaemons) = o
    ndaemons = ndaemons + 1
  END
END

ROUTINE StopDaemon o
  ndaemons = DropFrom(daemons, ndaemons, o)
END

! StartTimer(o, t): o.TIME_OUT runs t turns from now (o needs TIME_LEFT).
ROUTINE StartTimer o, t
  LOCAL k
  o.TIME_LEFT = t
  WHILE k < ntimers
    IF timers(k) = o
      RETURN
    END
    k = k + 1
  END
  IF ntimers < 32
    timers(ntimers) = o
    ntimers = ntimers + 1
  END
END

ROUTINE StopTimer o
  ntimers = DropFrom(timers, ntimers, o)
END

! remove o from the first n elements of array arr (by number); the new n
ROUTINE DropFrom arr, n, o
  LOCAL k, j
  WHILE k < n
    IF AGET(arr, k) = o
      j = k
      WHILE j < n - 1
        APUT(arr, j, AGET(arr, j + 1))
        j = j + 1
      END
      RETURN n - 1
    END
    k = k + 1
  END
  RETURN n
END

ROUTINE IsMeta a
  IF a = ##Score OR a = ##Verbose OR a = ##Brief OR a = ##Superbrief
    RETURN TRUE
  END
  IF a = ##Quit OR a = ##Notify OR a = ##Save OR a = ##Restore
    RETURN TRUE
  END
  IF a = ##Undo OR a = ##Restart OR a = ##Version OR a = ##Pictures
    RETURN TRUE
  END
  RETURN a = ##Music OR a = ##Sounds
END

ROUTINE EndTurn
  LOCAL k, o, f
  turns = turns + 1
  k = 0
  WHILE k < ndaemons
    o = daemons(k)
    o.DAEMON()
    k = k + 1
  END
  k = 0
  WHILE k < ntimers
    o = timers(k)
    o.TIME_LEFT = o.TIME_LEFT - 1
    IF o.TIME_LEFT <= 0
      StopTimer(o)
      o.TIME_OUT()
    ELSE
      k = k + 1
    END
  END
  location.EACH_TURN()
  IF endturnhook
    f = endturnhook
    f()
  END
  IF score <> lastscore AND notify_on
    FRESHLINE()
    PRINT
    IF score > lastscore
      WRITE "[Your score has just gone up by ", score - lastscore, " point"
    ELSE
      WRITE "[Your score has just gone down by ", lastscore - score, " point"
    END
    IF score - lastscore <> 1 AND lastscore - score <> 1
      WRITE "s"
    END
    PRINT ".]"
  END
  lastscore = score
  ShowStatus()
END

ROUTINE ShowStatus
  LOCAL r, s
  r = location
  IF NOT IsLit()
    r = 0
  END
  s = -1
  IF max_score > 0
    s = score
  END
  STATUS(r, s, turns)
END

! TitlePage(title, byline, blurb): a title page before the game.  The
! screen cleared, the title in bold, the byline and blurb under it, all
! centred (STYLE 8: the engine knows the screen's width), "Press any key
! to begin." at the foot; a key clears the screen again.  Call it from
! Initialise.  byline or blurb may be 0 to leave them out.  (When
! pictures and music arrive, the title page will show and play the
! game's title picture and music if it names them.)
ROUTINE TitlePage title, byline, blurb
  LOCAL k
  CLS()
  IF title_music
    PlayMusic(title_music)
  END
  IF title_picture
    ShowPicture(title_picture)   ! the text window is then 17 rows, under it
    k = 7
  END
  WHILE k < 8
    PRINT
    k = k + 1
  END
  STYLE(9)
  PRINT (string) title
  STYLE(8)
  IF byline
    PRINT
    PRINT (string) byline
  END
  IF blurb
    PRINT
    PRINT (string) blurb
  END
  PRINT
  IF title_picture = 0
    PRINT
    PRINT
  END
  PRINT "Press any key to begin."
  STYLE(0)
  READKEY()
  IF title_picture
    ShowPicture(0)
  END
  IF title_music
    PlayMusic(0)
  END
  CLS()
END

! PlayMusic(n): tune n (0: none), remembered in tunenum so a restored or
! undone game plays it again; with MUSIC OFF only the remembering.  The
! tune already playing goes on.  An engine without sound stays silent.
ROUTINE PlayMusic n
  tunenum = n
  IF music_on
    MUSIC(n)
  ELSE
    MUSIC(0)
  END
END

! PlaySound(n): effect n, once, over the music (not with SOUNDS OFF).
ROUTINE PlaySound n
  IF sounds_on
    SOUND(n)
  END
END

! RoomMusic: the room's own tune (its TUNE), or none.  DescribeRoom calls it.
ROUTINE RoomMusic
  IF PROPLEN(location, TUNE) > 0
    PlayMusic(location.TUNE)
  ELSE
    PlayMusic(0)
  END
END

! ShowPicture(n): show picture n (0: none), remembering it in picnum so a
! restored or undone game can show it again; with PICTURES OFF only the
! remembering happens.  An engine without pictures shows nothing.
ROUTINE ShowPicture n
  picnum = n
  IF pictures_on
    PICTURE n
  ELSE
    PICTURE 0
  END
END

! RoomPicture: the room's own picture (its PIC), or none in a room without
! one or in the dark.  DescribeRoom calls it.
ROUTINE RoomPicture
  IF IsLit() AND PROPLEN(location, PIC) > 0
    ShowPicture(location.PIC)
  ELSE
    ShowPicture(0)
  END
END

! EndScreen: the end of the game (deadflag 1 died, 2 won), after the last
! move's own text.  The banner (endmessage, or "You have won" / "You have
! died") and the score, centred; end_picture if the game names one; then
! the player chooses: RESTART, RESTORE a saved game, UNDO the last move
! (after a death, the move that killed them), or QUIT, which ends the
! game.  A game may REPLACE it.  (QUIT typed during play skips it.)
ROUTINE EndScreen
  LOCAL w
  IF end_picture
    ShowPicture(end_picture)
  END
  IF end_music
    PlayMusic(end_music)
  END
  PRINT
  STYLE(9)
  IF endmessage
    PRINT "*** ", (string) endmessage, " ***"
  ELSEIF deadflag = 1
    PRINT "*** You have died ***"
  ELSE
    PRINT "*** You have won ***"
  END
  STYLE(8)
  IF max_score > 0
    PRINT
    WRITE "In that game you scored ", score, " out of a possible ", max_score, ", in ", turns, " turn"
    IF turns <> 1
      WRITE "s"
    END
    PRINT "."
  END
  STYLE(0)
  WHILE TRUE
    PRINT
    PRINT "Would you like to RESTART, RESTORE a saved game, UNDO your last move, or QUIT?"
    WRITE "> "
    IF READ(text2, parse2) > 0
      w = parse2(1)
      IF w = 'restart'
        RESTART()
      ELSEIF w = 'restore'
        WRITE "Restore which file? (Enter for SAVE1) "
        AskFile()
        IF RESTORE(text2) = 0
          PRINT "Restore failed."
        END
      ELSEIF w = 'undo'
        IF UNDO() = 0
          PRINT "You can't undo that."
        END
      ELSEIF w = 'quit' OR w = 'q'
        RETURN
      END
    END
  END
END
