! verbs.txa - the standard library's verbs: grammar and action routines.
!
! M2 carries enough verbs to exercise the parser; M3 brings the full
! Infocom set, light, doors, containers in depth, and the rest.

VERB "look" "l"
  -> Look
  "at" noun -> Examine
  "in" noun -> Search
  "inside" noun -> Search
END
VERB "examine" "x" "inspect" "describe"
  noun -> Examine
END
VERB "search"
  noun -> Search
END
VERB "inventory" "i" "inv"
  -> Inv
END
VERB "take" "get" "carry"
  "in" noun -> Enter
  "into" noun -> Enter
  "on" noun -> Enter
  "out" -> Exit
  "off" -> Exit
  "off" noun -> TakeOff
  "out" "of" noun -> Exit
  multi -> Take
  "up" multi -> Take
  multi "up" -> Take
  multiinside "from" noun -> Remove
  multiinside "off" noun -> Remove
END
VERB "pick"
  "up" multi -> Take
  multi "up" -> Take
END
VERB "drop" "discard"
  multiheld -> Drop
END
VERB "put" "place" "insert"
  multiheld "in" container -> Insert
  multiheld "into" container -> Insert
  multiheld "inside" container -> Insert
  multiheld "on" noun -> PutOn
  multiheld "onto" noun -> PutOn
  "down" multiheld -> Drop
  multiheld "down" -> Drop
END
VERB "give" "offer" "hand"
  held "to" creature -> Give
  creature held -> Give REVERSE
END
VERB "ask"
  creature "about" topic -> Ask
END
VERB "tell"
  creature "about" topic -> Tell
END
VERB "open"
  noun -> Open
  noun "with" held -> Unlock
END
VERB "unlock"
  noun "with" held -> Unlock
END
VERB "lock"
  noun "with" held -> Lock
END
VERB "empty"
  noun -> Empty
  noun "out" -> Empty
END
VERB "enter"
  noun -> Enter
END
VERB "exit" "leave"
  -> Exit
  noun -> Exit
END
VERB "stand"
  -> Exit
  "up" -> Exit
END
VERB "close" "shut"
  noun -> Close
END
VERB "go" "walk" "run"
  noun -> Go
  "through" noun -> Enter
  "into" noun -> Enter
  "in" noun -> Enter
  "out" -> Exit
END
VERB "sit" "lie"
  "on" noun -> Enter
  "in" noun -> Enter
  "down" "on" noun -> Enter
END
VERB "wait" "z"
  -> Wait
END
VERB "quit" "q"
  -> Quit
END
VERB "score"
  -> Score
END
VERB "verbose" "long"
  -> Verbose
END
VERB "brief" "normal"
  -> Brief
END
VERB "superbrief" "short"
  -> Superbrief
END
VERB "notify"
  -> Notify
  "on" -> Notify
  "off" -> Notify
END
VERB "turn" "switch"
  "on" noun -> SwitchOn
  noun "on" -> SwitchOn
  "off" noun -> SwitchOff
  noun "off" -> SwitchOff
END

! ---- listing ---------------------------------------------------------------
! "a lamp, some coins and Ada": the children of obj that are not scenery,
! concealed or the player.  Returns how many.
ROUTINE ListContents obj
  LOCAL c, n, total
  FOR EACH c IN obj
    IF Listable(c)
      total = total + 1
    END
  END
  FOR EACH c IN obj
    IF Listable(c)
      IF n > 0
        IF n = total - 1
          WRITE " and "
        ELSE
          WRITE ", "
        END
      END
      WRITE (a) c
      n = n + 1
    END
  END
  RETURN total
END

ROUTINE Listable c
  RETURN c <> player AND c HASNT scenery AND c HASNT concealed
END

! ---- actions ---------------------------------------------------------------
ROUTINE LookSub
  DescribeRoom(TRUE)
END

! The room: its name in bold, its description (always for LOOK; on the
! first visit, or every time in VERBOSE; never in SUPERBRIEF), then what
! is in it: first the INITIAL paragraph of each object that has one and
! has never been moved, then "You can see ... here." for the rest, then
! what is on each supporter and in each open container.
ROUTINE DescribeRoom full
  LOCAL o, n, initials
  STYLE(1)
  IF NOT IsLit()
    PRINT "Darkness"
    STYLE(0)
    PRINT "It is pitch dark, and you can't see a thing."
    RETURN
  END
  WRITE (name) location
  STYLE(0)
  IF PARENT(player) <> location
    WRITE " (", (string) InOrOn(PARENT(player)), " ", (the) PARENT(player), ")"
  END
  PRINT
  IF full OR lookmode = 2 OR (lookmode = 1 AND location HASNT visited)
    IF location.DESC()
      FRESHLINE()
    END
  END
  FOR EACH o IN location
    IF Listable(o) AND ShowsInitial(o)
      o.INITIAL()
      FRESHLINE()
      initials = initials + 1
    END
  END
  n = 0
  FOR EACH o IN location
    IF Listable(o) AND NOT ShowsInitial(o)
      n = n + 1
    END
  END
  IF n
    IF initials
      WRITE "You can also see "
    ELSE
      WRITE "You can see "
    END
    ListWhere(location, FALSE)
    PRINT " here."
  END
  FOR EACH o IN location          ! (scenery too: what is on a fixed table shows)
    IF o <> player AND o HASNT concealed
      DescribeContents(o)
    END
  END
  GIVE location visited
END

ROUTINE ShowsInitial o
  RETURN PROPLEN(o, INITIAL) > 0 AND o HASNT moved
END

! "On the oak table is a brass lamp." / "In the box are some coins."
ROUTINE DescribeContents o
  LOCAL n, c
  IF o HASNT supporter AND (o HASNT container OR (o HASNT open AND o HASNT transparent))
    RETURN
  END
  FOR EACH c IN o
    IF Listable(c)
      n = n + 1
    END
  END
  IF n = 0
    RETURN
  END
  IF o HAS supporter
    WRITE "On "
  ELSE
    WRITE "In "
  END
  WRITE (the) o
  IF n = 1 AND OnlyChildSingular(o)
    WRITE " is "
  ELSE
    WRITE " are "
  END
  ListWhere(o, TRUE)
  PRINT "."
END

ROUTINE OnlyChildSingular o
  LOCAL c
  FOR EACH c IN o
    IF Listable(c)
      RETURN c HASNT plural
    END
  END
  RETURN TRUE
END

! "a lamp, some coins and Ada": the listable children of obj (all of
! them, or with all = FALSE those not shown by an INITIAL paragraph)
ROUTINE ListWhere obj, all
  LOCAL c, n, total
  FOR EACH c IN obj
    IF Listable(c) AND (all OR NOT ShowsInitial(c))
      total = total + 1
    END
  END
  FOR EACH c IN obj
    IF Listable(c) AND (all OR NOT ShowsInitial(c))
      IF n > 0
        IF n = total - 1
          WRITE " and "
        ELSE
          WRITE ", "
        END
      END
      WRITE (a) c
      n = n + 1
    END
  END
  RETURN total
END

ROUTINE ExamineSub
  IF NOT IsLit()
    PRINT "It is too dark to see."
    RETURN
  END
  IF noun.DESC()
    FRESHLINE()
  ELSE
    PRINT "You see nothing special about ", (the) noun, "."
  END
END

ROUTINE SearchSub
  IF NOT IsLit()
    PRINT "It is too dark to see."
    RETURN
  END
  IF noun HAS container OR noun HAS supporter
    IF noun HAS container AND noun HASNT open AND noun HASNT transparent
      PRINT (The) noun, " is closed."
      RETURN
    END
    IF CHILD(noun)
      WRITE "In ", (the) noun, " you can see "
      ListContents(noun)
      PRINT "."
    ELSE
      PRINT "There is nothing in ", (the) noun, "."
    END
    RETURN
  END
  PRINT "You find nothing of interest."
END

ROUTINE InvSub
  IF CHILD(player) = 0
    PRINT "You are empty-handed."
    RETURN
  END
  PRINT "You are carrying:"
  InvList(player, 1)
END

! one line an object, indented by depth; what is in or on it below it
ROUTINE InvList obj, depth
  LOCAL c, k
  FOR EACH c IN obj
    k = 0
    WHILE k < depth
      WRITE "  "
      k = k + 1
    END
    WRITE (a) c
    IF c HAS worn
      WRITE " (being worn)"
    END
    IF c HAS container AND c HAS openable
      IF c HAS open
        IF CHILD(c) = 0
          WRITE " (which is open but empty)"
        END
      ELSE
        WRITE " (which is closed)"
      END
    END
    IF c HAS light AND c HAS switchable
      WRITE " (providing light)"
    END
    PRINT
    IF c HAS supporter OR (c HAS container AND (c HAS open OR c HAS transparent))
      InvList(c, depth + 1)
    END
  END
END

ROUTINE TakeSub
  IF noun = player
    PRINT "You are always self-possessed."
  ELSEIF noun IN player
    PRINT "You already have ", (the) noun, "."
  ELSEIF noun HAS animate
    PRINT "I don't suppose ", (the) noun, " would care for that."
  ELSEIF noun HAS static OR noun HAS scenery
    PRINT "That's fixed in place."
  ELSEIF PARENT(noun) HAS animate AND PARENT(noun) <> player
    PRINT "That seems to belong to ", (the) PARENT(noun), "."
  ELSEIF noun = PARENT(player)
    PRINT "You'll have to get off ", (the) noun, " first."
  ELSEIF IsInside(player, noun)
    PRINT "You can't take something you're in."
  ELSE
    MOVE noun TO player
    GIVE noun moved
    IF AfterRules()
      RETURN
    END
    PRINT "Taken."
  END
END

ROUTINE RemoveSub
  IF noun NOTIN second
    PRINT (The) noun, " isn't there."
    RETURN
  END
  TakeSub()
END

ROUTINE DropSub
  IF noun NOTIN player
    PRINT "You haven't got ", (the) noun, "."
    RETURN
  END
  MOVE noun TO location
  IF AfterRules()
    RETURN
  END
  PRINT "Dropped."
END

ROUTINE InsertSub
  IF noun NOTIN player
    PRINT "You haven't got ", (the) noun, "."
  ELSEIF second HASNT container
    PRINT "That can't contain things."
  ELSEIF second HASNT open
    PRINT (The) second, " is closed."
  ELSEIF noun = second OR IsInside(second, noun)
    PRINT "You can't put something inside itself."
  ELSEIF Full(second)
    PRINT "There is no more room in ", (the) second, "."
  ELSE
    MOVE noun TO second
    IF AfterRules()
      RETURN
    END
    PRINT "You put ", (the) noun, " into ", (the) second, "."
  END
END

ROUTINE PutOnSub
  IF noun NOTIN player
    PRINT "You haven't got ", (the) noun, "."
  ELSEIF second HASNT supporter
    PRINT "Putting things on ", (the) second, " would achieve nothing."
  ELSEIF noun = second OR IsInside(second, noun)
    PRINT "You can't put something on top of itself."
  ELSEIF Full(second)
    PRINT "There is no more room on ", (the) second, "."
  ELSE
    MOVE noun TO second
    IF AfterRules()
      RETURN
    END
    PRINT "You put ", (the) noun, " on ", (the) second, "."
  END
END

! is a somewhere inside b (in it, or in something in it ...)?
ROUTINE IsInside a, b
  LOCAL p
  p = PARENT(a)
  WHILE p
    IF p = b
      RETURN TRUE
    END
    p = PARENT(p)
  END
  RETURN FALSE
END

! has container c as many things as its CAPACITY allows?  (no CAPACITY:
! never full)
ROUTINE Full c
  LOCAL n, x
  IF PROPLEN(c, CAPACITY) = 0
    RETURN FALSE
  END
  FOR EACH x IN c
    n = n + 1
  END
  RETURN n >= c.CAPACITY
END

ROUTINE EmptySub
  LOCAL x, n
  IF noun HASNT container AND noun HASNT supporter
    PRINT (The) noun, " can't contain things."
  ELSEIF noun HAS container AND noun HASNT open
    PRINT (The) noun, " is closed."
  ELSEIF CHILD(noun) = 0
    PRINT (The) noun, " is empty already."
  ELSE
    x = CHILD(noun)
    WHILE x
      n = SIBLING(x)
      MOVE x TO PARENT(player)
      x = n
    END
    IF AfterRules()
      RETURN
    END
    PRINT "You empty ", (the) noun, "."
  END
END

ROUTINE GiveSub
  IF second.LIFE()
    RETURN
  END
  PRINT (The) second, " doesn't seem interested."
END

ROUTINE AskSub
  IF noun.LIFE()
    RETURN
  END
  PRINT "There is no reply."
END

ROUTINE TellSub
  IF noun.LIFE()
    RETURN
  END
  PRINT "This provokes no reaction."
END

ROUTINE OpenSub
  IF noun HASNT openable
    PRINT "That's not something you can open."
  ELSEIF noun HAS open
    PRINT "It's already open."
  ELSEIF noun HAS locked
    PRINT "It seems to be locked."
  ELSE
    GIVE noun open
    IF AfterRules()
      RETURN
    END
    PRINT "You open ", (the) noun, "."
  END
END

ROUTINE UnlockSub
  IF noun HASNT lockable
    PRINT "That doesn't seem to be something you can unlock."
  ELSEIF noun HASNT locked
    PRINT "It's unlocked at the moment."
  ELSEIF noun.WITH_KEY <> second
    PRINT "That doesn't seem to fit the lock."
  ELSE
    GIVE noun NOT locked
    IF AfterRules()
      RETURN
    END
    PRINT "You unlock ", (the) noun, "."
  END
END

ROUTINE LockSub
  IF noun HASNT lockable
    PRINT "That doesn't seem to be something you can lock."
  ELSEIF noun HAS locked
    PRINT "It's locked at the moment."
  ELSEIF noun HAS open
    PRINT "First you'll have to close ", (the) noun, "."
  ELSEIF noun.WITH_KEY <> second
    PRINT "That doesn't seem to fit the lock."
  ELSE
    GIVE noun locked
    IF AfterRules()
      RETURN
    END
    PRINT "You lock ", (the) noun, "."
  END
END

ROUTINE CloseSub
  IF noun HASNT openable
    PRINT "That's not something you can close."
  ELSEIF noun HASNT open
    PRINT "It's already closed."
  ELSE
    GIVE noun NOT open
    IF AfterRules()
      RETURN
    END
    PRINT "You close ", (the) noun, "."
  END
END

! The exit in direction d (1-12, the compass objects' DIR) of the room:
! run, so an exit routine decides, an exit string prints itself.
ROUTINE ExitOf r, d
  IF d = 1
    RETURN r.N()
  ELSEIF d = 2
    RETURN r.S()
  ELSEIF d = 3
    RETURN r.E()
  ELSEIF d = 4
    RETURN r.W()
  ELSEIF d = 5
    RETURN r.NE()
  ELSEIF d = 6
    RETURN r.NW()
  ELSEIF d = 7
    RETURN r.SE()
  ELSEIF d = 8
    RETURN r.SW()
  ELSEIF d = 9
    RETURN r.UP()
  ELSEIF d = 10
    RETURN r.DOWN()
  ELSEIF d = 11
    RETURN r.INSIDE()
  END
  RETURN r.OUTSIDE()
END

! GO: the compass object's direction gives the exit.  0 means no way; 1
! means an exit string or routine has already said why not (1 is the
! player object, never a destination).
ROUTINE GoSub
  LOCAL dest
  IF noun.DIR = 0
    PRINT "You can't go that way."
    RETURN
  END
  dest = ExitOf(location, noun.DIR)
  IF dest = 0
    IF location.CANT_GO()
      FRESHLINE()
    ELSE
      PRINT "You can't go that way."
    END
    RETURN
  END
  IF dest = 1
    FRESHLINE()
    RETURN
  END
  GoTo(dest)
END

! Through door d (or to room dest if it is not a door): a closed door
! stops the player; otherwise DOOR_TO says where it leads.
ROUTINE GoTo dest
  IF PARENT(player) <> location
    PRINT "You'll have to get ", (string) OffOrOut(PARENT(player)), " ", (the) PARENT(player), " first."
    RETURN
  END
  IF dest HAS door
    IF dest HASNT open
      IF dest HAS locked
        PRINT (The) dest, " seems to be locked."
      ELSE
        PRINT "You can't, since ", (the) dest, " is closed."
      END
      RETURN
    END
    dest = DoorLeads(dest)
    IF dest <= 1
      FRESHLINE()
      RETURN
    END
  END
  MOVE player TO dest
  location = dest
  MoveFloating()
  BuildScope()
  DescribeRoom(FALSE)
END

! where door d leads from here: DOOR_TO with two rooms gives the one the
! player is not in; one room, or a routine, says itself
ROUTINE DoorLeads d
  IF PROPLEN(d, DOOR_TO) = 2
    IF PROPWORD(d, DOOR_TO, 0) = location
      RETURN PROPWORD(d, DOOR_TO, 1)
    END
    RETURN PROPWORD(d, DOOR_TO, 0)
  END
  RETURN d.DOOR_TO()
END

ROUTINE OffOrOut o
  IF o HAS supporter
    RETURN "off"
  END
  RETURN "out of"
END

! Floating objects (with FOUND_IN) come into the room when the player
! does, and leave the rooms they are not listed for.
ROUTINE MoveFloating
  LOCAL o, k, n, here
  o = 1
  WHILE o <= LASTOBJ
    n = PROPLEN(o, FOUND_IN)
    IF n
      here = FALSE
      k = 0
      WHILE k < n
        IF PROPWORD(o, FOUND_IN, k) = location
          here = TRUE
        END
        k = k + 1
      END
      IF here
        IF o NOTIN location
          MOVE o TO location
        END
      ELSEIF PARENT(o) <> 0 AND PARENT(o) <> player
        REMOVE o
      END
    END
    o = o + 1
  END
END

ROUTINE EnterSub
  IF noun HAS door
    GoTo(noun)
    RETURN
  END
  IF noun HASNT enterable
    PRINT "That's not something you can enter."
  ELSEIF PARENT(player) = noun
    PRINT "But you're already ", (string) InOrOn(noun), " ", (the) noun, "."
  ELSEIF noun HAS container AND noun HASNT open
    PRINT (The) noun, " is closed."
  ELSEIF PARENT(player) <> location
    PRINT "You'll have to get ", (string) OffOrOut(PARENT(player)), " ", (the) PARENT(player), " first."
  ELSE
    MOVE player TO noun
    IF AfterRules()
      RETURN
    END
    PRINT "You get ", (string) InOrOn(noun), "to ", (the) noun, "."
  END
END

ROUTINE InOrOn o
  IF o HAS supporter
    RETURN "on"
  END
  RETURN "in"
END

! TAKE OFF X / GET OFF X: clothing comes off; anything else is got off
ROUTINE TakeOffSub
  IF noun HAS worn OR noun IN player
    DisrobeSub()
  ELSE
    ExitSub()
  END
END

ROUTINE ExitSub
  LOCAL p
  p = PARENT(player)
  IF p = location
    PRINT "But you aren't in anything at the moment."
    RETURN
  END
  MOVE player TO location
  IF AfterRules()
    RETURN
  END
  PRINT "You get ", (string) OffOrOut(p), " ", (the) p, "."
END

ROUTINE WaitSub
  PRINT "Time passes."
END

ROUTINE QuitSub
  PRINT "Do you really want to stop?"
  IF YesOrNo()
    deadflag = 3
  ELSE
    PRINT "Carrying on, then."
  END
END

ROUTINE ScoreSub
  IF max_score = 0
    PRINT "There is no score in this story."
    RETURN
  END
  WRITE "You have scored ", score, " out of a possible ", max_score, ", in ", turns, " turn"
  IF turns <> 1
    WRITE "s"
  END
  PRINT "."
END

ROUTINE VerboseSub
  lookmode = 2
  PRINT (name) location, " is now in its ~verbose~ mode, which always gives long descriptions of locations (even if you've been there before)."
END

ROUTINE BriefSub
  lookmode = 1
  PRINT (name) location, " is now in its normal ~brief~ printing mode, which gives long descriptions of places never before visited and short descriptions otherwise."
END

ROUTINE SuperbriefSub
  lookmode = 3
  PRINT (name) location, " is now in its ~superbrief~ mode, which always gives short descriptions of locations (even if you haven't been there before)."
END

ROUTINE NotifySub
  IF WordAt(verbwn + 1) = 'off'
    notify_on = 0
  ELSEIF WordAt(verbwn + 1) = 'on'
    notify_on = 1
  ELSE
    notify_on = 1 - notify_on
  END
  IF notify_on
    PRINT "Score notification on."
  ELSE
    PRINT "Score notification off."
  END
END

ROUTINE SwitchOnSub
  IF noun HASNT switchable
    PRINT "That's not something you can switch."
  ELSEIF noun HAS on
    PRINT "That's already on."
  ELSE
    GIVE noun on
    IF AfterRules()
      RETURN
    END
    PRINT "You switch ", (the) noun, " on."
  END
END

ROUTINE SwitchOffSub
  IF noun HASNT switchable
    PRINT "That's not something you can switch."
  ELSEIF noun HASNT on
    PRINT "That's already off."
  ELSE
    GIVE noun NOT on
    IF AfterRules()
      RETURN
    END
    PRINT "You switch ", (the) noun, " off."
  END
END
