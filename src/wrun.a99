*======================================================================
* wrun.a99 - Run (M6 part 4, decision D7), overlay 10: the finished game
* run from its own files on disk, as Editor/Assembler option 5 would run
* it: the engine's files PREFIX1, PREFIX2 ... (following their "more"
* flags) loaded and started at >2000; the engine then loads the story,
* picture and music files itself.  QUIT ends at the console's title
* screen, where the workbench is in the menu again.
*
* The engine loads over the workbench itself (>2000->37FF, >A000->CDFF),
* its disk routines included, so Run works in two steps:
*   1. each engine file, loaded through the disk DSR into VRAM, has its
*      code copied into a SAMS page of its own (16, 17 ...: free since the
*      overlays moved to the cartridge); a table keeps page, address and
*      length;
*   2. the relocator (RELOC, assembled to run at >F000 and copied there,
*      SAMS page 15 in window F) maps each page into window E, copies it
*      to its address, turns SAMS mapping off (the machine as E/A 5 leaves
*      it) and branches to >2000.  It calls nothing: the kernel is gone by
*      then.
*======================================================================
RFILE  EQU  GLOBRM+>78         the engine file being loaded (from 0)  (BRET's:
*                              Build and Run never run together)
RHDR   EQU  ULIT+42            its E/A 5 header: flag, length, address (6 bytes)
RSTAGE EQU  16                 the first staging page
RSRC   EQU  GLOBRM+>7C         where the engine comes from: 0 the disk (Run), 1 the
*                              cartridge (test-play)
TBANK  EQU  GLOBRM+>7E         test-play: the cartridge bank being read ...
TOFF   EQU  ULIT+40            ... and the offset in it (0-8191)
TDONE  EQU  ULIT+48            the file's bytes copied so far
RRELPG EQU  15                 the relocator's page (window F): 15, the page >F000
*                              shows with mapping off too, so the relocator can
*                              turn mapping off and still run (see RL9)

* RUN - from the menu (R): the engine from the game's files on disk.
RUN    LI   R10,STACKT
       CLR  @RSRC
       CLR  @RFILE
RU1    MOV  @RSRC,R0           test-play: the file from the cartridge instead
       JEQ  RU1D
       B    @TPFILE
RU1D   BL   @RNAME             FNBUF: device, prefix, the file's number
       LI   R1,QLOAD           (the progress line: "Loading DSK1.LAMPLI1")
       LI   R2,FNBUF
       BL   @PSTAGE
       LI   R0,5               the DSR's LOAD, into VRAM FBUF
       LI   R1,DSKMAX
       BL   @DSKCAL
       MOV  R0,R0
       JEQ  RU2
       B    @RUERR
RU2    LI   R0,FBUF            its header: "more" flag, length, address
       LI   R1,RHDR
       LI   R2,6
       BL   @VMBR
       MOV  @RFILE,R0          its staging page into window E ...
       AI   R0,RSTAGE
       LI   R1,>E
       BL   @MAPPG
       LI   R0,FBUF+6          ... and its code into it
       LI   R1,>E000
       MOV  @RHDR+2,R2
       AI   R2,-6
       BL   @VMBR              (VRAM to RAM)
       MOV  @RFILE,R1          the table: page, address, length
       MPY  @D6R,R1            (R2 = file x 6)
       MOV  @RFILE,R0
       AI   R0,RSTAGE
       MOV  R0,@RTAB(R2)
       MOV  @RHDR+4,@RTAB+2(R2)
       MOV  @RHDR+2,R0
       AI   R0,-6
       MOV  R0,@RTAB+4(R2)
       INC  @RFILE
       MOV  @RSRC,R0           (test-play: as many as the cartridge holds)
       JEQ  RU2M
       C    @RFILE,@TPENG
       JL   RU2N
       JMP  RU3
RU2M   MOV  @RHDR,R0           more files?
       JEQ  RU3
RU2N
       MOV  @RFILE,R0
       CI   R0,9
       JHE  RU3
       B    @RU1
RU3    MOV  @RFILE,R1          the table's end
       MPY  @D6R,R1
       CLR  @RTAB(R2)
       MOV  @RSRC,R0           test-play: the name and mode 2 into the staged
       JEQ  RU3A               engine
       BL   @TPATCH
RU3A
       LI   R0,RRELPG          the relocator and its table to >F000 ...
       LI   R1,>F
       BL   @MAPPG
       LI   R1,RLSRC
       LI   R2,>F000
       LI   R3,RLCODE
RU4    MOV  *R1+,*R2+
       DECT R3
       JGT  RU4
       LI   R1,RTAB
       LI   R2,RLTAB
       LI   R3,RTABX-RTAB
RU5    MOV  *R1+,*R2+
       DECT R3
       JGT  RU5
       LIMI 0                  ... and away: the workbench is overwritten
       B    @RELOC
* TPLAY - test-play (T, decision D4), after T's compile: the compiled
* image (from IMGPG) copied into the engine's story pages (from 32), then
* the engine from the cartridge (Build's copy of it), staged and started as
* Run starts a built game, with STMODE 2 (the story already in SAMS; the
* engine loads only the pictures and music) and the game's name patched in
* (for those files).  FCTN = or QUIT ends it: the console restarts, and the
* workbench with it.  Nothing is written to disk.
TPLAY  LI   R10,STACKT
       MOV  @IPH,R0            the image's pages: (length + 4095) / 4096
       MOV  @IPL,R1
       AI   R1,>0FFF
       JNC  TP0
       INC  R0
TP0    SRL  R1,12
       SLA  R0,4
       SOC  R0,R1
       MOV  R1,R5
       CLR  R6
TP1    C    R6,R5              each into its story page: through windows E
       JHE  TP2                (from) and D (to)
       MOV  @IMGPG,R0
       A    R6,R0
       LI   R1,>E
       BL   @MAPPG
       MOV  R6,R0
       AI   R0,32
       LI   R1,>D
       BL   @MAPPG
       LI   R1,>E000
       LI   R2,>D000
       LI   R3,2048
TP1A   MOV  *R1+,*R2+
       DEC  R3
       JNE  TP1A
       INC  R6
       JMP  TP1
TP2    SETO @RSRC              the engine from the cartridge
       CLR  @RFILE
       MOV  @TPENG+2,@TBANK
       CLR  @TOFF
       B    @RU1
* TPFILE - engine file RFILE from the cartridge into VRAM FBUF (as Build
* copies it), then on to staging it (RU2).
TPFILE LI   R1,QTPLAY          (the progress line)
       CLR  R2
       BL   @PSTAGE
       MOV  @RFILE,R1
       SLA  R1,1
       MOV  @TPENG+6(R1),R5    its length
       CLR  @TDONE
TPF1   C    @TDONE,R5
       JHE  TPF3
       MOV  @TBANK,R0          the bank
       SLA  R0,1
       AI   R0,>6000
       CLR  *R0
       LI   R2,>2000           left in this bank
       S    @TOFF,R2
       MOV  R5,R3              left of the file
       S    @TDONE,R3
       C    R3,R2
       JHE  TPF2
       MOV  R3,R2
TPF2   MOV  @TDONE,R0
       AI   R0,FBUF
       MOV  @TOFF,R1
       AI   R1,>6000
       A    R2,@TDONE
       A    R2,@TOFF
       BL   @VMBW
       MOV  @TOFF,R0
       CI   R0,>2000
       JL   TPF1
       CLR  @TOFF
       INC  @TBANK
       JMP  TPF1
TPF3   CLR  @>6000             (bank 0 again)
       B    @RU2
* TPATCH - into the staged engine: the story name (device and prefix) in
* its field, for the picture and music files, and STMODE = 2.
TPATCH .enter
       CLR  @RFILE             FNBUF: device, prefix, "1": the name less its
       BL   @RNAME             last byte
       MOV  @TPENG+4,R0        the name's file's staging page into window E
       AI   R0,RSTAGE
       LI   R1,>E
       BL   @MAPPG
       MOV  @TPENG+24,R4       the field (its length byte), in the page: less
       AI   R4,>E000-6         the file's 6-byte header
       MOVB @FNBUF,R0          its length: FNBUF's, less the digit
       SB   @QONER,R0
       MOVB R0,*R4+
       SRL  R0,8
       LI   R1,FNBUF+1
       LI   R2,16
TPA1   MOV  R0,R0              the name, then spaces
       JEQ  TPA2
       MOVB *R1+,*R4+
       DEC  R0
       DEC  R2
       JMP  TPA1
TPA2   MOVB @QSPR,*R4+
       DEC  R2
       JGT  TPA2
       MOV  @TPENG+26,R0       STMODE's file's page: 2 there
       AI   R0,RSTAGE
       LI   R1,>E
       BL   @MAPPG
       MOV  @TPENG+28,R1
       LI   R0,2
       MOV  R0,@>E000(R1)
       .leave
       RT

* RUERR - an engine file would not load: say which, and how to make it.
RUERR  BL   @PCLEAR
       LI   R0,8
       BL   @WCLR
       LI   R0,8
       LI   R1,1
       BL   @TXAT
       LI   R1,QRERR
       CLR  R2
       BL   @TXSTR
       LI   R1,FNBUF
       CLR  R2
       BL   @TXSTR
       LI   R1,QRER2
       CLR  R2
       BL   @TXSTR
       B    @MENUGO

* RNAME - FNBUF = the source file's device (up to its last '.'), the
* prefix, and RFILE + 1.  Uses R0-R4.  (Build's BNAME, in overlay 9.)
RNAME  LI   R4,FNBUF+1
       MOV  @WBNLEN,R0
       CLR  R1
       CLR  R2
RNM1   C    R2,R0
       JHE  RNM2
       CB   @WBNAME(R2),@QDOTR
       JNE  RNM1A
       MOV  R2,R1
       INC  R1
RNM1A  INC  R2
       JMP  RNM1
RNM2   CLR  R2
RNM3   C    R2,R1
       JHE  RNM4
       MOVB @WBNAME(R2),*R4+
       INC  R2
       JMP  RNM3
RNM4   MOVB @WPFX,R0
       SRL  R0,8
       CLR  R2
RNM5   C    R2,R0
       JHE  RNM6
       MOVB @WPFX+1(R2),*R4+
       INC  R2
       JMP  RNM5
RNM6   MOV  @RFILE,R0
       AI   R0,'1'
       SWPB R0
       MOVB R0,*R4+
       MOV  R4,R0
       AI   R0,-FNBUF-1
       SWPB R0
       MOVB R0,@FNBUF
       RT

D6R    DATA 6
* TPENG - the engine in the cartridge (filled in by tools/build.py, as
* overlay 9's ENGTAB, and more): +0 its files, +2 its first bank, +4 the
* name field's file, +6 .. +22 the files' lengths, +24 the field's offset
* in its file (with the header), +26 STMODE's file, +28 STMODE's offset in
* that file's code.
TPENG  DATA 0,0,0
       DATA 0,0,0,0,0,0,0,0,0
       DATA 0,0,0
QTPLAY BYTE 9
       TEXT 'Test-play'
QONER  BYTE 1
QSPR   BYTE ' '
       EVEN
RTAB   BSS  6*9+2              page, address, length a file; a 0 page ends it
RTABX
QLOAD  BYTE 8
       TEXT 'Loading '
QRERR  BYTE 15
       TEXT 'Cannot load:   '
QRER2  BYTE 34
       TEXT '  (B builds the game first).      '
QDOTR  BYTE '.'
       EVEN

* ---- the relocator: assembled for >F000, copied there by RUN -------------------
RLSRC
       XORG >F000
RELOC  LI   R4,RLTAB
RL1    MOV  *R4+,R0            a page (0: done)
       JEQ  RL9
       MOV  R0,R2              into window E: (page<<8)|page at >401C
       SLA  R2,8
       SOC  R0,R2
       LI   R12,AMSCRU
       SBO  0
       MOV  R2,@AMSREG+>1C
       SBZ  0
       MOV  *R4+,R2            its address
       MOV  *R4+,R3            its length
       LI   R1,>E000
RL2    MOVB *R1+,*R2+
       DEC  R3
       JNE  RL2
       JMP  RL1
RL9    LI   R12,AMSCRU         SAMS mapping off, as Editor/Assembler leaves it:
       SBZ  1                  the engine's AMSDET probes the window-2
*                              register, which with mapping on switches out the
*                              very page AMSDET runs from (found in the simulator)
       B    @>2000             the engine's entry (KENTRY)
RLTAB  BSS  6*9+2
RLEND
RLCODE EQU  RLTAB-RELOC        the code's length (the table follows it)
       XORG RLSRC+RLEND-RELOC  (back to the overlay's own addresses)
