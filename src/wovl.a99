*======================================================================
* wovl.a99 - the workbench's overlays 5 on (M5 parts 5 and 6), assembled
* apart from wbench.a99: the first assembly's staging room (>4000->9FFF)
* holds overlays 1-4 and little more.  tools/build.py assembles wbench.a99
* first, writes its symbols (but the overlays' own labels, >B000->CFFF)
* into src/gen/wres.a99, then assembles this file with them; these
* overlays are staged from >0000 here (this assembly has nothing else) and
* go into their SAMS pages like the others.
*
* Each overlay runs at >B000 and begins there with a branch to its entry:
* the resident part calls OVENT after OVSEL.  Overlays never refer to
* each other's labels (the other is not mapped in).
*======================================================================
       COPY "macros.a99"
       COPY "gen/wres.a99"

       AORG >0000
       XORG >B000
       B    @GEN5              overlay 5: the code generator
       COPY "wcode.a99"
       COPY "gen/bops.a99"
OV5END
       XORG >B000
       B    @LINK6             overlay 6: the linker, first half
       COPY "wlink.a99"
OV6END
       XORG >B000
       B    @LINK7             overlay 7: the linker, second half
       COPY "wlink2.a99"
OV7END
       XORG >B000
       B    @MENU              overlay 8: the front end (the main menu)
       COPY "wfront.a99"
OV8END
       XORG >B000
       B    @BUILD             overlay 9: Build, the engine's files
       B    @BDFIN             (>B004) the message, after the pictures
       COPY "wbuild.a99"
OV9END
       XORG >B000
       B    @RUN               overlay 10: Run, the built game from its files
       B    @TPLAY             (>B004) test-play: the compiled game, from SAMS
       COPY "wrun.a99"
OV10END
       XORG >B000
       B    @OKERR             overlay 11: an error's screen (then its message)
       B    @OK4               (>B004) the results of a compile that worked
       B    @OK1E              (>B008) one file's error (the lexer's, parser's tests)
       B    @OK1F              (>B00C) one file's results
       COPY "wemsg.a99"
OV11END
       XORG >B000
       B    @TITEST            overlay 12: TI Artist pictures (the converter)
       B    @TIBLD             (>B004) Build's pictures
       B    @TIPREV            (>B008) the I key: the preview
       COPY "wtiart.a99"
OV12END
       XORG >B000
       B    @STATS             overlay 13: the statistics (S)
       COPY "wstat.a99"
OV13END
       XORG >B000
       B    @OPTS              overlay 14: the options (O)
       B    @OPLOAD            (>B004) at start-up: DSK1.TXAOPT read
       COPY "wopts.a99"
OV14END
       END
