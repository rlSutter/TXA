*======================================================================
* wload.a99 - the workbench's loading (M5 part 4), resident: every file
* of a program read, lexed and parsed onto one tree, and the declaration
* index, which lists the declarations in the order tools/txc/sema.py's
* load() collects them: a file's declarations in order, an INCLUDE's
* file in its place (each file once: a file whose name is loaded already
* adds nothing).  Also the readers the later stages share: the tree
* through window F and the tables through window D.
*
* Files (FTAB, up to MAXF): the base name as sema.py's resolve() takes
* it (after the last '.', then after the last ':'), in capitals, and
* where its tree starts.  The trees follow each other from TREEPG.
*
* The declaration index (SAMS from DXPG, DXN entries of 8 bytes):
*   +0 the declaration's place in the tree: page, +2 offset (its >07)
*   +4 its file's number (byte; >80 added when REPLACE drops it)
*   +5 its node type (dump.NODES, from 1)   +6 its line
*======================================================================
MAXF   EQU  16                 files in a program, at most
DXPG   EQU  112                SAMS page where the declaration index starts
DXMAX  EQU  2048               declarations, at most (4 pages)
* variables (the resident part's, from GLOBRM; OVCUR .. OVTMP in wbench)
WBONLY EQU  GLOBRM+>06         nonzero: one file, lexed and parsed only (the M5 part 1-3 tests)
NF     EQU  GLOBRM+>08         files loaded
DXN    EQU  GLOBRM+>0A         declarations in the index
TRNPG  EQU  GLOBRM+>0C         where the next file's tree goes: page ...
TRNOF  EQU  GLOBRM+>0E         ... and offset
WBERRF EQU  GLOBRM+>10         an error's file (its number in FTAB)
XPG    EQU  GLOBRM+>12         the tree reader's place: page ...
XOF    EQU  GLOBRM+>14         ... and offset
XFPG   EQU  GLOBRM+>16         the page window F shows (0: not known)
DFPG   EQU  GLOBRM+>18         the page window D shows (0: not known)
WKF    EQU  GLOBRM+>1A         WALKF: the file
WKN    EQU  GLOBRM+>1C         WALKF: declarations still to look at
WKPG   EQU  GLOBRM+>1E         WALKF: this declaration's place
WKOF   EQU  GLOBRM+>20
WKT    EQU  GLOBRM+>22         WALKF: its type
WKL    EQU  GLOBRM+>24         WALKF: its line
WKSTK  EQU  GLOBRM+>26         WALK: the return stack (errors go back to it)
XRET   EQU  GLOBRM+>28         saved returns and registers
XRET2  EQU  GLOBRM+>2A
XSV2   EQU  GLOBRM+>2C
XSV3   EQU  GLOBRM+>2E
WBSTAG EQU  GLOBRM+>30         the stage an error came from: 1 lexer, 2 parser, 3 loading, 4 meaning
WBLTOT EQU  GLOBRM+>32         lines read, all files
XHI    EQU  GLOBRM+>34         XW: the high byte
XSV1   EQU  GLOBRM+>36         DMAP: R1 kept
FTAB   EQU  GLOBRM+>80         MAXF entries of FTSIZ:
FTSIZ  EQU  20                 +0 name length, +1 the name (15), +16 tree page, +18 offset
* errors found here (WBERR; the meaning stage's codes follow from 41)
SE.FIL EQU  40                 cannot find the file (an INCLUDE)
SE.MNY EQU  98                 too many files or declarations for the workbench

* ---- the tree, read through window F -------------------------------------------
* XSET - the reader to page R0, offset R1.
XSET   MOV  R0,@XPG
       MOV  R1,@XOF
       RT
* XB - R0 = the next byte of the tree (low byte).  Uses R0, R1; keeps R2-R9.
XB     MOV  @XPG,R0
       C    R0,@XFPG
       JEQ  XB1
       MOV  R11,@XRET
       MOV  R2,@XSV2
       MOV  R3,@XSV3
       MOV  R0,@XFPG
       LI   R1,>F
       BL   @MAPPG
       MOV  @XSV2,R2
       MOV  @XSV3,R3
       MOV  @XRET,R11
XB1    MOV  @XOF,R1
       CLR  R0
       MOVB @>F000(R1),R0
       SRL  R0,8
       INC  R1
       CI   R1,4096
       JL   XB2
       CLR  R1
       INC  @XPG
XB2    MOV  R1,@XOF
       RT
* XW - R0 = the next word (high byte first).  Uses R0, R1; keeps R2-R9.
XW     MOV  R11,@XRET2
       BL   @XB
       SWPB R0
       MOV  R0,@XHI
       BL   @XB
       SOC  @XHI,R0
       MOV  @XRET2,R11
       RT
* XADV - the reader R0 bytes on.  Uses R0, R1.
XADV   A    @XOF,R0
XAD1   CI   R0,4096
       JL   XAD2
       AI   R0,-4096
       INC  @XPG
       JMP  XAD1
XAD2   MOV  R0,@XOF
       RT
* XSKIP - past one value of the tree (any tag; nodes and lists whole).
* Uses R0, R1; keeps R2-R8 (R9 kept on the return stack).
XSKIP  .enter
       .push R9
       BL   @XB
       CI   R0,3
       JL   XSK9               None, True, False
       JNE  XSK1
       BL   @XW                an integer
       JMP  XSK9
XSK1   CI   R0,4
       JNE  XSK2
       BL   @XW                a string: its length, its bytes
       BL   @XADV
       JMP  XSK9
XSK2   CI   R0,5
       JNE  XSK3
       BL   @XW                a list: its count, its items
       JMP  XSK5
XSK3   CI   R0,6
       JNE  XSK4
       BL   @XB                a tuple: its count (a byte), its items
       JMP  XSK5
XSK4   BL   @XB                a node: its type, its line, its fields
       MOV  R0,R1              (R0 cannot index; type 1 is NFLD's first byte)
       MOVB @NFLD-1(R1),R9
       SRL  R9,8
       BL   @XW
       MOV  R9,R0
XSK5   MOV  R0,R9
XSK6   MOV  R9,R9
       JEQ  XSK9
       BL   @XSKIP
       DEC  R9
       JMP  XSK6
XSK9   .pop R9
       .leave
       RT
* XFLDS - past R0 fields (the rest of a node whose tag, type and line
* are read).  Keeps R2-R8.
XFLDS  .enter
       .push R9
       MOV  R0,R9
       JMP  XSK6
* NFLD - each node type's field count, in dump.NODES's order.
NFLD   BYTE 1,2,2,3,1,1,2,3,5,2,3,1,3,3,3          Include .. Routine
       BYTE 1,1,1,1,2,2,2                          Has .. Case
       BYTE 2,2,3,1,2,2,2,1,2,1,1,2,1              If .. ExprStmt
       BYTE 1,1,1,1,2,3,2,1,1,2                    Num .. Call
       EVEN

* ---- the tables, through window D -----------------------------------------------
* DMAP - window D onto page R0, unless it shows it already.  Keeps R1-R9.
DMAP   C    R0,@DFPG
       JEQ  DMA9
       MOV  R0,@DFPG
       MOV  R11,@XRET
       MOV  R1,@XSV1           (R1, R2, R3 kept across MAPPG)
       MOV  R2,@XSV2
       MOV  R3,@XSV3
       LI   R1,>D
       BL   @MAPPG
       MOV  @XSV2,R2
       MOV  @XSV3,R3
       MOV  @XSV1,R1
       MOV  @XRET,R11
DMA9   RT
* DXAT - R1 = window D's address of index entry R0 (mapped).  Uses R0, R1.
DXAT   MOV  R11,@XRET2
       MOV  R0,R1
       ANDI R1,511
       SLA  R1,3
       AI   R1,>D000
       SRL  R0,9
       AI   R0,DXPG
       BL   @DMAP
       MOV  @XRET2,R11
       RT

* ---- loading one file ---------------------------------------------------------------
* LOADF - the file named in FNBUF read into SAMS (from SRCPG), lexed and
* parsed onto the tree (from TRNPG:TRNOF), and entered in FTAB as file
* NF.  R0 = 0; -1 if it would not open; else an error (WBERR, WBERRL,
* WBSTAG; WBERRF = this file).
LOADF  .enter
       MOV  @NF,R0
       MOV  R0,@WBERRF
       CI   R0,MAXF
       JL   LF0
       LI   R0,SE.MNY
       MOV  R0,@WBERR
       B    @LF99
LF0    BL   @DVOPEN
       MOV  R0,R0
       JEQ  LF1
       SETO R0
       B    @LF99
LF1    CLR  @WBLNS
       CLR  @WBLENL
       CLR  @WBLENH
       LI   R0,SRCPG
       MOV  R0,@WBPAGE
       CLR  @WBOFF
       BL   @WMAP
LF2    BL   @DVREAD            a record, then a line feed
       MOV  R0,R0
       JLT  LF5
       MOV  R0,R15             its length
       LI   R0,FBUF
       LI   R1,ROWBUF
       MOV  R15,R2
       JEQ  LF3
       BL   @VMBR
LF3    LI   R14,ROWBUF
LF4    MOV  R15,R15
       JEQ  LF4A
       MOVB *R14+,R0
       BL   @WPUT
       DEC  R15
       JMP  LF4
LF4A   LI   R0,>0A00
       BL   @WPUT
       INC  @WBLNS
       INC  @WBLTOT
       JMP  LF2
LF5    BL   @DVCLOS
       MOV  @NF,R0             its FTAB entry: the base name, the tree's start
       MPY  @DFTSIZ,R0
       AI   R1,FTAB
       MOV  R1,R4
       BL   @FBASE             R2 = the base name's first character, R3 its length
       CI   R3,15
       JLE  LF6
       LI   R3,15
LF6    SWPB R3
       MOVB R3,*R4
       SWPB R3
       MOV  R4,R5
       INC  R5
LF7    MOV  R3,R3
       JEQ  LF8
       MOVB *R2+,*R5+
       DEC  R3
       JMP  LF7
LF8    MOV  @TRNPG,@16(R4)
       MOV  @TRNOF,@18(R4)
       LI   R0,1
       MOV  R0,@WBDONE
       MOV  R0,@WBSTAG         the tokens (overlay 1)
       BL   @OVSEL
       BL   @LEXALL
       MOV  R0,R0
       JNE  LF99
       LI   R0,2
       MOV  R0,@WBDONE
       MOV  R0,@WBSTAG         the tree (overlay 2)
       BL   @OVSEL
       BL   @PARSE
       MOV  R0,R0
       JNE  LF99
       LI   R0,3
       MOV  R0,@WBDONE
       MOV  @TKPAGE,@TRNPG     where the next file's tree goes
       MOV  @TKOFF,@TRNOF
       INC  @NF
       CLR  @XFPG              (the stages moved windows E and F)
       CLR  R0
LF99   .leave
       RT
DFTSIZ DATA FTSIZ

* FBASE - R2 = the base name in FNBUF (after the last '.', then after the
* last ':' in that), R3 = its length.  Uses R0-R3.
FBASE  MOVB @FNBUF,R3
       SRL  R3,8
       LI   R2,FNBUF+1
       MOV  R2,R1              R1: where the base starts
       MOV  R3,R0
FB1    MOV  R0,R0
       JEQ  FB3
       CB   *R2,@FBDOT
       JNE  FB2
       MOV  R2,R1
       INC  R1
FB2    INC  R2
       DEC  R0
       JMP  FB1
FB3    MOV  R1,R0              then after the last ':' from there on
FB4    C    R0,R2
       JHE  FB6
       CB   *R0,@FBCOL
       JNE  FB5
       MOV  R0,R1
       INC  R1
FB5    INC  R0
       JMP  FB4
FB6    MOV  R2,R3              the length: the end less the start
       S    R1,R3
       MOV  R1,R2
       RT
FBDOT  BYTE '.'
FBCOL  BYTE ':'
       EVEN

* FFIND - R0 = the number of the loaded file whose base name is FNBUF's,
* or -1.  Uses R0-R7.
FFIND  MOV  R11,R7
       BL   @FBASE
       CI   R3,15
       JLE  FF1
       LI   R3,15
FF1    CLR  R4                 the file being compared
       LI   R5,FTAB
FF2    C    R4,@NF
       JHE  FF8
       MOVB *R5,R0
       SRL  R0,8
       C    R0,R3
       JNE  FF5
       MOV  R5,R6              the names, byte for byte
       INC  R6
       MOV  R2,R1
FF3    MOV  R0,R0
       JEQ  FF9                (all equal)
       CB   *R1+,*R6+
       JNE  FF5
       DEC  R0
       JMP  FF3
FF5    INC  R4
       AI   R5,FTSIZ
       JMP  FF2
FF8    SETO R4
FF9    MOV  R4,R0
       B    *R7

* ---- the declaration index ---------------------------------------------------------
* WALK - the declarations of file 0 and the files it INCLUDEs, loaded as
* they are met.  R0 = 0, or an error (WBERR, WBERRL, WBERRF, WBSTAG).
WALK   .enter
       MOV  R10,@WKSTK
       CLR  @DXN
       CLR  R0
       BL   @WALKF
       CLR  R0
WLK99  .leave
       RT
* WERR - an error at line WKL of file WKF: code R0.  Back to WALK's caller.
WERR   MOV  R0,@WBERR
       MOV  @WKL,@WBERRL
       MOV  @WKF,@WBERRF
       LI   R1,3
       MOV  R1,@WBSTAG
WERR2  MOV  @WKSTK,R10
       MOV  @WBERR,R0
       JMP  WLK99

* WALKF - file R0's declarations into the index; an INCLUDE loads its
* file (unless loaded) and walks it there.
WALKF  .enter
       MOV  R0,@WKF
       MPY  @DFTSIZ,R0
       MOV  @FTAB+16(R1),R0
       MOV  @FTAB+18(R1),R1
       BL   @XSET
       BL   @XB                the list (>05) ...
       BL   @XW                ... and its count
       MOV  R0,@WKN
WF1    MOV  @WKN,R0
       JNE  WF1A
       B    @WF9
WF1A
       DEC  @WKN
       MOV  @XPG,@WKPG         this declaration's place
       MOV  @XOF,@WKOF
       BL   @XB                >07
       BL   @XB                its type
       MOV  R0,@WKT
       BL   @XW                its line
       MOV  R0,@WKL
       MOV  @WKT,R0
       CI   R0,NT.INC
       JEQ  WF5
       MOV  @DXN,R0            into the index
       CI   R0,DXMAX
       JL   WF2
       LI   R0,SE.MNY
       B    @WERR
WF2    BL   @DXAT
       MOV  @WKPG,*R1+
       MOV  @WKOF,*R1+
       MOVB @WKF+1,*R1+
       MOVB @WKT+1,*R1+
       MOV  @WKL,*R1
       INC  @DXN
       MOV  @WKT,R1            past the rest of it
       MOVB @NFLD-1(R1),R0
       SRL  R0,8
       BL   @XFLDS
       JMP  WF1
WF5    BL   @XB                an INCLUDE: its path (>04, length, bytes) ...
       BL   @XW
       MOV  R0,R3
       CI   R0,30
       JLE  WF6
       LI   R0,30
WF6    SWPB R0                 ... into FNBUF, in capitals
       MOVB R0,@FNBUF
       LI   R4,FNBUF+1
WF7    MOV  R3,R3
       JEQ  WF8
       BL   @XB
       CI   R4,FNBUF+31
       JHE  WF7A
       CI   R0,'a'
       JL   WF7B
       CI   R0,'z'
       JH   WF7B
       AI   R0,-32
WF7B   SWPB R0
       MOVB R0,*R4+
WF7A   DEC  R3
       JMP  WF7
WF8    BL   @FFIND             loaded already: nothing more
       MOV  R0,R0
       JLT  WF8A
       B    @WF1
WF8A   .push @WKF              the walk's place, kept across the file
       .push @WKN
       .push @XPG
       .push @XOF
       .push @WKL
       BL   @LOADF
       MOV  R0,R0
       JEQ  WF8B
       JLT  WF8C
       B    @WERR2             its own error
WF8C
       .pop @WKL               it would not open
       .pop @XOF
       .pop @XPG
       .pop @WKN
       .pop @WKF
       LI   R0,SE.FIL
       B    @WERR
WF8B   MOV  @NF,R0
       DEC  R0
       BL   @WALKF
       .pop @WKL
       .pop @XOF
       .pop @XPG
       .pop @WKN
       .pop @WKF
       CLR  @XFPG              (window F moved)
       B    @WF1
WF9    .leave
       RT

* ---- shared by the meaning stage's overlays (moved here from wsema.a99) ------
* DXINF - declaration R3: R4 = its type, R5 = its file (negative if
* dropped).  Uses R0, R1, R4, R5.
DXINF  MOV  R11,@SRET3
       MOV  R3,R0
       BL   @DXAT
       MOVB @4(R1),R5
       SRA  R5,8               (sign-extended: negative if dropped)
       MOVB @5(R1),R4
       SRL  R4,8
       MOV  @SRET3,R11
       RT
* DXSEEK - the tree reader at declaration R3's first field; R4 = its
* type; ELINE, EFILE = its line and file.  Keeps R3.  Uses R0-R2, R4.
DXSEEK MOV  R11,@SRET3
       MOV  R3,R0
       BL   @DXAT
       MOVB @5(R1),R4
       SRL  R4,8
       MOVB @4(R1),R2
       SRL  R2,8
       ANDI R2,>7F
       MOV  R2,@EFILE
       MOV  @6(R1),@ELINE
       MOV  @2(R1),R2
       MOV  *R1,R0
       MOV  R2,R1
       BL   @XSET
       BL   @XB
       BL   @XB
       BL   @XW
       MOV  @SRET3,R11
       RT
* DXDROP - declaration R3 dropped (REPLACE, or done with: EXTEND).
DXDROP MOV  R11,@SRET3
       MOV  R3,R0
       BL   @DXAT
       SOCB @B80,@4(R1)
       MOV  @SRET3,R11
       RT
B80    BYTE >80
       EVEN
* OPRD - the string at the reader into OPB as written (8 kept), OPL its
* length.  Uses R0-R3.
OPRD   MOV  R11,@SRET3
       BL   @XB
       BL   @XW
       MOV  R0,R3
       MOV  R0,@OPL
       CLR  R2
OPR1   MOV  R3,R3
       JEQ  OPR9
       BL   @XB
       CI   R2,8
       JHE  OPR2
       SWPB R0
       MOVB R0,@OPB(R2)
       INC  R2
OPR2   DEC  R3
       JMP  OPR1
OPR9   MOV  @SRET3,R11
       RT
* OPIS - R0 = 1 if OPB is the string at R1 (length byte first), else 0.
* Uses R0-R3.
OPIS   MOVB *R1+,R2
       SRL  R2,8
       C    R2,@OPL
       JNE  OPI8
       LI   R3,OPB
OPI1   MOV  R2,R2
       JEQ  OPI9
       CB   *R1+,*R3+
       JNE  OPI8
       DEC  R2
       JMP  OPI1
OPI8   CLR  R0
       RT
OPI9   LI   R0,1
       RT
* XSEQK - R0 = 1 if the string at the reader is KEYB, in capitals (it is
* read past either way).  Uses R0-R2, R4, R5.
XSEQK  MOV  R11,@SRET3
       BL   @XB
       BL   @XW
       MOV  R0,R5
       LI   R4,1               equal so far
       C    R0,@KEYL
       JEQ  XSQ0
       CLR  R4
XSQ0   CLR  R2
XSQ1   MOV  R5,R5
       JEQ  XSQ9
       BL   @XB
       MOV  R4,R4
       JEQ  XSQ2
       SWPB R0
       BL   @UPPER
       CB   R0,@KEYB(R2)
       JEQ  XSQ2
       CLR  R4
XSQ2   INC  R2
       DEC  R5
       JMP  XSQ1
XSQ9   MOV  R4,R0
       MOV  @SRET3,R11
       RT

* VRBAT - R1 = window D's address of verb R0 (from 1).  Uses R0, R1.
VRBAT  MOV  R11,@SRET4
       MOV  R0,R1
       DEC  R1
       SLA  R1,3
       AI   R1,>D000
       LI   R0,VRBPG
       BL   @DMAP
       MOV  @SRET4,R11
       RT
* XBACK - the reader one byte back.  Uses R0.
XBACK  MOV  @XOF,R0
       JNE  XBK1
       DEC  @XPG
       LI   R0,4096
XBK1   DEC  R0
       MOV  R0,@XOF
       RT
