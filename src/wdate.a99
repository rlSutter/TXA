*======================================================================
* wdate.a99 - the build date's prompt (M5 part 6), in overlay 1 beside
* the lexer: it runs before a compile, and the resident part is full.
* The story's header carries a build date and the TI has no clock, so the
* workbench asks, offering the last date given.
*======================================================================
* WDPROM - the build date, for the story's header (the TI has no clock):
* "Build date (yymmdd): " with the last one given (none at first); a
* digit typed replaces it (and the first after a refused ENTER), FCTN S
* rubs out, ENTER takes six digits making
* a month 01-12 and a day 01-31 into WDATE and compiles.
WDPROM LI   R1,WDATE           the last date, if it is one
       LI   R2,WDBUF
       CLR  @WDLEN
       MOVB *R1,R0
       JEQ  WDP1               (none yet)
       LI   R0,6
       MOV  R0,@WDLEN
WDP0   MOVB *R1+,*R2+
       DEC  R0
       JNE  WDP0
WDP1   SETO R9                 (the first key typed replaces it)
WDP2   LI   R0,3               draw "Build date (yymmdd): " and the date
       BL   @WCLR
       LI   R0,3
       LI   R1,1
       BL   @TXAT
       LI   R1,SDATE
       CLR  R2
       BL   @TXSTR
       LI   R0,3*COLS+22
       LI   R1,WDBUF
       MOV  @WDLEN,R2
       JEQ  WDP3
       BL   @VMBW
WDP3   BL   @WKEY
       CI   R0,13
       JNE  WDP5
       BL   @WDOK              ENTER: a date?
       MOV  R0,R0
       JNE  WDP3A
       SETO R9                 no: the next digit starts it over
       JMP  WDP3
WDP3A
       LI   R1,WDBUF           yes: kept, and compile
       LI   R2,WDATE
       LI   R0,6
WDP4   MOVB *R1+,*R2+
       DEC  R0
       JNE  WDP4
       B    @WLOAD
WDP5   CI   R0,8
       JNE  WDP6
       MOV  @WDLEN,R0          rub out
       JEQ  WDP2
       DEC  @WDLEN
       CLR  R9
       JMP  WDP2
WDP6   CI   R0,'0'             digits only
       JL   WDP3
       CI   R0,'9'
       JH   WDP3
       MOV  R9,R9
       JEQ  WDP7
       CLR  @WDLEN
       CLR  R9
WDP7   MOV  @WDLEN,R1
       CI   R1,6
       JHE  WDP2
       SWPB R0
       MOVB R0,@WDBUF(R1)
       INC  @WDLEN
       JMP  WDP2
* WDOK - R0 = 1 if WDBUF is a date: six digits, month 01-12, day 01-31.
WDOK   MOV  @WDLEN,R0
       CI   R0,6
       JNE  WDK8
       LI   R1,2               the month: digits 2, 3
       BL   @WD2
       MOV  R0,R0
       JEQ  WDK8
       CI   R0,12
       JH   WDK8
       LI   R1,4               the day: digits 4, 5
       BL   @WD2
       MOV  R0,R0
       JEQ  WDK8
       CI   R0,31
       JH   WDK8
       LI   R0,1
       RT
WDK8   CLR  R0
       RT
* WD2 - R0 = the two digits of WDBUF at R1.  Uses R0-R2.
WD2    MOVB @WDBUF(R1),R0
       SRL  R0,8
       AI   R0,-'0'
       MOV  R0,R2
       SLA  R0,3               x 10: x 8 + x 2
       A    R2,R0
       A    R2,R0
       MOVB @WDBUF+1(R1),R2
       SRL  R2,8
       AI   R2,-'0'
       A    R2,R0
       RT

SDATE  BYTE SDATEX-SDATE-1
       TEXT 'Build date (yymmdd): '
SDATEX
       EVEN
