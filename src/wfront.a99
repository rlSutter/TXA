*======================================================================
* wfront.a99 - the workbench's front end (M6 part 2), overlay 8: the main
* menu, the project's settings (the source file, the build date), and the
* keys of the parts still to come.  The resident part enters it at OVENT
* (MENUGO) at start-up and after every compile; a compile's results stay
* on rows 4-8 under the project and above the menu.
*
* Rows: 2 the source file, 3 the build date, 4-8 results (the compile's,
* resident), 5 the progress line while compiling, 10 the menu's keys, 11
* a message.
*======================================================================
MRET   EQU  GLOBRM+>68         saved returns
MRET2  EQU  GLOBRM+>6A
MRET3  EQU  GLOBRM+>76

* MENU - draw the project and the keys, then act on a key.
MENU   LI   R10,STACKT         (a fresh stack: the menu is the top level)
       MOVB @WPFX,R0           no prefix yet (start-up): the source's
       JNE  MEN1
       BL   @MPDEF
MEN1   BL   @MSRC              row 2: the source file
       BL   @MDATE             row 3: the build date, if one is set
       LI   R0,10              row 10: the keys
       BL   @WCLR
       LI   R0,10
       LI   R1,1
       BL   @TXAT
       LI   R1,QKEYS
       CLR  R2
       BL   @TXSTR
       LI   R0,11
       BL   @WCLR
MN1    BL   @WKEY
       CI   R0,'a'             a letter, in capitals
       JL   MN2
       CI   R0,'z'
       JH   MN2
       AI   R0,-32
MN2    CI   R0,'P'
       JEQ  MPROJ
       CI   R0,'C'
       JEQ  MCOMP
       CI   R0,'R'             R: run the built game (overlay 10)
       JNE  MN2R
       LI   R0,10              (OVGO: from an overlay, the switch must be made
       B    @OVGO              by the resident part, not return into this one)
MN2R   CI   R0,'E'             E: the last compile's error again (overlay 11)
       JNE  MN2E
       MOV  @WBERR,R1
       JEQ  MN2N
       LI   R0,11
       B    @OVGO
MN2N   LI   R1,QNOERR          (none)
       B    @MN4
MN2E   CI   R0,'T'             T: compile, then test-play (overlay 10, >B004)
       JNE  MN2T
       LI   R0,2
       MOV  R0,@WBBLD
       JMP  MCOMP
MN2T   CI   R0,'B'             B: compile, then the engine's files (overlay 9)
       JNE  MN2A
       LI   R0,1
       MOV  R0,@WBBLD
       JMP  MCOMP
MN2A   CI   R0,'I'             I: a TI Artist picture, previewed (overlay 12,
       JNE  MN2I               >B008)
       BL   @MPIC
       MOVB @TINAME,R0
       JNE  MN2J
       B    @MENU              (no name: the menu again)
MN2J   LI   R0,12
       B    @OVGO8
MN2I
       LI   R1,QSOON           a key of a part still to come: say which
MN3    MOVB *R1+,R2
       JEQ  MN1                (not a menu key)
       SRL  R2,8
       C    R2,R0
       JEQ  MN4
       MOVB *R1,R2             past its message
       SRL  R2,8
       A    R2,R1
       INC  R1
       JMP  MN3
MN4    MOV  R1,R4
       LI   R0,11
       BL   @WCLR
       LI   R0,11
       LI   R1,1
       BL   @TXAT
       MOV  R4,R1
       CLR  R2
       BL   @TXSTR
       JMP  MN1
* P: the source file, then the build date and the game's prefix (the one-
* file tests ask neither).  A new source file brings its default prefix.
MPROJ  BL   @MNAME
       BL   @MPDEF
       MOV  @WBONLY,R0
       JEQ  MPRJ1
       B    @MENU
MPRJ1  BL   @WDPROM
       BL   @MPFX
       B    @MENU
* C: compile the project (the date asked first if none is set yet).
MCOMP  MOV  @WBONLY,R0
       JNE  MC1
       MOVB @WDATE,R0
       JNE  MC1
       BL   @WDPROM
MC1    LI   R0,11
       BL   @WCLR
       B    @WLOAD

* MSRC - row 2: "Source file: " and the name.  Uses R0-R2.
MSRC   MOV  R11,@MRET
       LI   R0,2
       BL   @WCLR
       LI   R0,2
       LI   R1,1
       BL   @TXAT
       LI   R1,QASK
       CLR  R2
       BL   @TXSTR
       LI   R0,2*COLS+14
       LI   R1,WBNAME
       MOV  @WBNLEN,R2
       JEQ  MS9
       BL   @VMBW
MS9    MOV  @MRET,R11
       RT
* MDATE - row 3: "Build date (yymmdd): " and the date, if one is set.
MDATE  MOV  R11,@MRET
       LI   R0,3
       BL   @WCLR
       MOVB @WDATE,R0
       JEQ  MD9
       LI   R0,3
       LI   R1,1
       BL   @TXAT
       LI   R1,SDATE
       CLR  R2
       BL   @TXSTR
       LI   R0,3*COLS+22
       LI   R1,WDATE
       LI   R2,6
       BL   @VMBW
MD9    BL   @MPSHOW            and the prefix beside it
       MOV  @MRET,R11
       RT
* MPSHOW - row 3, column 40: "Game prefix: " and the prefix.  Uses R0-R2.
MPSHOW MOV  R11,@MRET3
       LI   R0,3
       LI   R1,40
       BL   @TXAT
       LI   R1,QPFX
       CLR  R2
       BL   @TXSTR
       LI   R0,3*COLS+53
       LI   R1,WPFX+1
       MOVB @WPFX,R2
       SRL  R2,8
       JEQ  MPS9
       BL   @VMBW
MPS9   MOV  @MRET3,R11
       RT
* MPDEF - WPFX := the source file's base name (after its last '.'), its
* first 6 letters and digits.  Uses R0-R4.
MPDEF  LI   R1,WBNAME          R1 = just after the last '.'
       MOV  @WBNLEN,R2
       LI   R3,WBNAME
MPD1   MOV  R2,R2
       JEQ  MPD3
       CB   *R3+,@QDOT
       JNE  MPD2
       MOV  R3,R1
MPD2   DEC  R2
       JMP  MPD1
MPD3   LI   R4,WPFX+1          then up to 6 letters or digits
       CLR  R2
MPD4   C    R1,R3
       JHE  MPD6
       CI   R2,6
       JHE  MPD6
       MOVB *R1+,R0
       CB   R0,@QZERO
       JL   MPD4
       MOVB R0,*R4+
       INC  R2
       JMP  MPD4
MPD6   SWPB R2
       MOVB R2,@WPFX
       RT
* MPFX - the game's prefix, edited on row 3: 1 to 6 letters or digits,
* the first key replacing it, FCTN S rubbing out, ENTER keeping it.
MPFX   MOV  R11,@MRET2
       SETO R9
       LI   R1,QHPFX           row 11: what to type
       BL   @MHINT
MPF2   BL   @MPSHOW
       MOVB @WPFX,R1           (the end of it cleared)
       SRL  R1,8
       AI   R1,3*COLS+53
       MOV  R1,R0
       LI   R1,' '*256
       LI   R2,6
       BL   @VFILL
       BL   @MPSHOW
MPF3   MOVB @WPFX,R0           the cursor, after the prefix
       SRL  R0,8
       AI   R0,3*COLS+53
       BL   @MCURS
       BL   @WKEY
       CI   R0,13
       JNE  MPF4
       MOVB @WPFX,R0           ENTER: not empty
       JEQ  MPF3
       MOV  @MRET2,R11
       RT
MPF4   CI   R0,8
       JNE  MPF5
       MOVB @WPFX,R0           rub out
       JEQ  MPF2
       SB   @QONE,@WPFX
       CLR  R9
       JMP  MPF2
MPF5   CI   R0,'a'
       JL   MPF6
       CI   R0,'z'
       JH   MPF6
       AI   R0,-32
MPF6   CI   R0,'0'             letters and digits only
       JL   MPF3
       CI   R0,'Z'
       JH   MPF3
       CI   R0,'9'
       JLE  MPF7
       CI   R0,'A'
       JL   MPF3
MPF7   MOV  R9,R9
       JEQ  MPF8
       CLR  @WPFX
       CLR  R9
MPF8   MOVB @WPFX,R1
       SRL  R1,8
       CI   R1,6
       JHE  MPF2
       SWPB R0
       MOVB R0,@WPFX+1(R1)
       SB   @QMONE,@WPFX
       JMP  MPF2

* MNAME - the source file's name, edited on row 2: the first key typed
* replaces it, FCTN S rubs out, ENTER keeps it (TI names are capitals).
MNAME  MOV  R11,@MRET2
       SETO R9
       LI   R1,QHNAME          row 11: what to type
       BL   @MHINT
MNM2   BL   @MSRC
MNM3   MOV  @WBNLEN,R0         the cursor, after the name
       AI   R0,2*COLS+14
       BL   @MCURS
       BL   @WKEY
       CI   R0,13
       JNE  MNM4
       MOV  @MRET2,R11
       RT
MNM4   CI   R0,8
       JNE  MNM5
       MOV  @WBNLEN,R0         rub out
       JEQ  MNM2
       DEC  @WBNLEN
       CLR  R9
       JMP  MNM2
MNM5   CI   R0,' '
       JLE  MNM3
       CI   R0,'a'
       JL   MNM6
       CI   R0,'z'
       JH   MNM6
       AI   R0,-32
MNM6   MOV  R9,R9
       JEQ  MNM7
       CLR  @WBNLEN
       CLR  R9
MNM7   MOV  @WBNLEN,R1
       CI   R1,26
       JHE  MNM2
       SWPB R0
       MOVB R0,@WBNAME(R1)
       INC  @WBNLEN
       JMP  MNM2

* MPIC - row 6: the picture's name typed into TINAME (a length byte, then
* up to 20 characters), offered as the source's device (DSK1.) the first
* time.  ENTER keeps it; BACK (FCTN 9) empties it.
MPIC   MOV  R11,@MRET2
       MOVB @TINAME,R0
       JNE  MPI2
       LI   R1,WBNAME          the source's device: up to its last '.'
       CLR  R2
       CLR  R3
MPI1   C    R2,@WBNLEN
       JHE  MPI1C
       CB   @WBNAME(R2),@QDOT
       JNE  MPI1B
       MOV  R2,R3
       INC  R3
MPI1B  INC  R2
       JMP  MPI1
MPI1C  CLR  R2
MPI1D  C    R2,R3
       JHE  MPI1E
       MOVB @WBNAME(R2),@TINAME+1(R2)
       INC  R2
       JMP  MPI1D
MPI1E  SWPB R3
       MOVB R3,@TINAME
MPI2   LI   R1,QHPIC           row 11: what to type
       BL   @MHINT
MPI3   LI   R0,6               row 6: Picture: NAME_
       BL   @WCLR
       LI   R0,6
       LI   R1,1
       BL   @TXAT
       LI   R1,QPICNM
       CLR  R2
       BL   @TXSTR
       LI   R1,TINAME
       CLR  R2
       BL   @TXSTR
       MOVB @TINAME,R0
       SRL  R0,8
       AI   R0,6*COLS+11
       BL   @MCURS
       BL   @WKEY
       CI   R0,13
       JEQ  MPI9
       CI   R0,15              BACK: no picture
       JNE  MPI4
       CLR  R0
       MOVB R0,@TINAME
       JMP  MPI9
MPI4   CI   R0,8
       JNE  MPI5
       MOVB @TINAME,R0         rub out
       JEQ  MPI3
       AI   R0,->0100
       MOVB R0,@TINAME
       JMP  MPI3
MPI5   CI   R0,' '
       JLE  MPI3
       CI   R0,'a'
       JL   MPI6
       CI   R0,'z'
       JH   MPI6
       AI   R0,-32
MPI6   MOVB @TINAME,R1
       SRL  R1,8
       CI   R1,20
       JHE  MPI3
       SWPB R0
       MOVB R0,@TINAME+1(R1)
       AI   R1,>0001
       SWPB R1
       MOVB R1,@TINAME
       JMP  MPI3
MPI9   MOV  @MRET2,R11
       RT
QPICNM BYTE 9
       TEXT 'Picture: '
QHPIC  BYTE QHPICX-QHPIC-1
       TEXT 'The picture: DSK1.NAME for NAME_P and NAME_C.  ENTER: see it.  FCTN 9: back.'
QHPICX
       EVEN

QKEYS  BYTE QKEYSX-QKEYS-1     (76 columns, from column 1: the row is 80)
       TEXT 'P Project C Compile T Test R Run B Build E Errors S Stats I Import O Options'
QKEYSX
* MHINT - row 11: the hint at R1 (a length byte first).
MHINT  .enter
       MOV  R1,R4
       LI   R0,11
       BL   @WCLR
       LI   R0,11
       LI   R1,1
       BL   @TXAT
       MOV  R4,R1
       CLR  R2
       BL   @TXSTR
       .leave
       RT
* MCURS - a cursor (_) at VRAM R0, where the next character typed goes.
MCURS  LI   R1,'_'*256
       B    @VSBW
QHNAME BYTE QHNAMEX-QHNAME-1
       TEXT 'Type the source file (DSK1.NAME): FCTN S rubs out, ENTER keeps the one shown.'
QHNAMEX
QHDATE BYTE QHDATEX-QHDATE-1
       TEXT 'The build date, yymmdd (261024 is 24 October 2026): ENTER takes it.'
QHDATEX
QHPFX  BYTE QHPFXX-QHPFX-1
       TEXT 'The game prefix: 1-6 letters or digits naming its files. ENTER keeps it.'
QHPFXX
       EVEN
QNOERR BYTE 29
       TEXT 'No error in the last compile.'
QPFX   BYTE 13
       TEXT 'Game prefix: '
QDOT   BYTE '.'
QZERO  BYTE '0'
QONE   BYTE 1
QMONE  BYTE >FF
       EVEN
QASK   BYTE QASKX-QASK-1
       TEXT 'Source file: '
QASKX
* the keys still to come: the key, then its message (a length byte the
* assembler counts, and the text)
QSOON
       BYTE 'S'
QS3    BYTE QS3X-QS3-1
       TEXT 'Statistics: not built yet (M6 part 10).'
QS3X
       BYTE 'O'
QS5    BYTE QS5X-QS5-1
       TEXT 'Options: not built yet (M6 part 10).'
QS5X
       BYTE 0
       EVEN

* ---- the build date (from wdate.a99, M5 part 6) --------------------------------
* WDPROM - the build date, for the story's header (the TI has no clock):
* "Build date (yymmdd): " with the last one given (none at first); a
* digit typed replaces it (and the first after a refused ENTER), FCTN S
* rubs out, ENTER takes six digits making a month 01-12 and a day 01-31
* into WDATE.  A subroutine.
WDPROM MOV  R11,@MRET2         (a subroutine now: returns once a date is taken)
       LI   R1,WDATE           the last date, if it is one
       LI   R2,WDBUF
       CLR  @WDLEN
       MOVB *R1,R0
       JEQ  WDP1               (none yet)
       LI   R0,6
       MOV  R0,@WDLEN
WDP0   MOVB *R1+,*R2+
       DEC  R0
       JNE  WDP0
WDP1   SETO R9                 (the first key typed replaces it)
       LI   R1,QHDATE          row 11: what to type
       BL   @MHINT
WDP2   LI   R0,3               draw "Build date (yymmdd): " and the date
       BL   @WCLR
       LI   R0,3
       LI   R1,1
       BL   @TXAT
       LI   R1,SDATE
       CLR  R2
       BL   @TXSTR
       LI   R0,3*COLS+22
       LI   R1,WDBUF
       MOV  @WDLEN,R2
       JEQ  WDP3
       BL   @VMBW
WDP3   MOV  @WDLEN,R0          the cursor, after the date
       AI   R0,3*COLS+22
       BL   @MCURS
       BL   @WKEY
       CI   R0,13
       JNE  WDP5
       BL   @WDOK              ENTER: a date?
       MOV  R0,R0
       JNE  WDP3A
       SETO R9                 no: the next digit starts it over
       JMP  WDP3
WDP3A
       LI   R1,WDBUF           yes: kept
       LI   R2,WDATE
       LI   R0,6
WDP4   MOVB *R1+,*R2+
       DEC  R0
       JNE  WDP4
       MOV  @MRET2,R11
       RT
WDP5   CI   R0,8
       JNE  WDP6
       MOV  @WDLEN,R0          rub out
       JEQ  WDP2
       DEC  @WDLEN
       CLR  R9
       JMP  WDP2
WDP6   CI   R0,'0'             digits only
       JL   WDP3
       CI   R0,'9'
       JH   WDP3
       MOV  R9,R9
       JEQ  WDP7
       CLR  @WDLEN
       CLR  R9
WDP7   MOV  @WDLEN,R1
       CI   R1,6
       JHE  WDP2
       SWPB R0
       MOVB R0,@WDBUF(R1)
       INC  @WDLEN
       JMP  WDP2
* WDOK - R0 = 1 if WDBUF is a date: six digits, month 01-12, day 01-31.
WDOK   MOV  R11,@WDRET         (it calls WD2)
       MOV  @WDLEN,R0
       CI   R0,6
       JNE  WDK8
       LI   R1,2               the month: digits 2, 3
       BL   @WD2
       MOV  R0,R0
       JEQ  WDK8
       CI   R0,12
       JH   WDK8
       LI   R1,4               the day: digits 4, 5
       BL   @WD2
       MOV  R0,R0
       JEQ  WDK8
       CI   R0,31
       JH   WDK8
       LI   R0,1
       MOV  @WDRET,R11
       RT
WDK8   CLR  R0
       MOV  @WDRET,R11
       RT
* WD2 - R0 = the two digits of WDBUF at R1.  Uses R0-R2.
WD2    MOVB @WDBUF(R1),R0
       SRL  R0,8
       AI   R0,-'0'
       MOV  R0,R2
       SLA  R0,3               x 10: x 8 + x 2
       A    R2,R0
       A    R2,R0
       MOVB @WDBUF+1(R1),R2
       SRL  R2,8
       AI   R2,-'0'
       A    R2,R0
       RT

SDATE  BYTE SDATEX-SDATE-1
       TEXT 'Build date (yymmdd): '
SDATEX
       EVEN
