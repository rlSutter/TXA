*======================================================================
* text80.a99 - the F18A 80-column text screen
*
* T80 is the 9938-style text mode the F18A adds: 80 x 24 characters, or
* 80 x 30 with ROW30 (VR49 bit 6).  Characters are 6 pixels wide: the
* left six bits of each pattern byte.  Colours come from VR7 (text in
* the high nibble, background in the low).
*
* Glyph sets: patterns 32-126 are the font; 160-254 are the same glyphs
* inverted, for the status line and other reverse video.  Printing a
* character with >80 added gives its reverse form.  M1 adds the bold and
* underline sets the spec calls for.
*
* Rows count from 0 (the status line).  An address is row * 80 + column.
*======================================================================

* T80ON - 80-column mode, tables per defs.a99, rows per ROWS (24/30).
* The F18A must be unlocked.  Leaves the name table as it was.
T80ON  .enter
       LI   R1,T80REG
       BL   @F18REG
       LI   R0,>B100           VR49 = 0 (24 rows) ...
       C    @ROWS,@D30
       JNE  T80N1
       LI   R0,>B140           ... or >40, ROW30 (30 rows)
T80N1  BL   @VDPWR
       .leave
       RT
T80REG DATA >8004              VR0: M4 = 80-column text
       DATA >81F0              VR1: 16K, display on, interrupts, M1 = text
       DATA >8200              VR2: name table >0000
       DATA >8300              VR3: (position attributes: unused)
       DATA >8402              VR4: patterns >1000
       DATA >8530              VR5: sprite attributes >1800
       DATA >8604              VR6: sprite patterns >2000 (all zero)
       DATA >8700+TXTCOL       VR7: text and background colours
       DATA 0
D30    DATA 30
D24    DATA 24

* FONTLD - load the font into patterns 32-126 and its reverse into
* 160-254.  FONT is 95 glyphs x 8 bytes (tools/mkfont.py).  Uses R0-R4.
FONTLD .enter
       LI   R0,PATTAB+(32*8)
       LI   R1,FONT
       LI   R2,95*8
       BL   @VMBW
       LI   R0,PATTAB+(160*8)  inverted copy: write address once ...
       BL   @VWAD
       LI   R1,FONT
       LI   R2,95*8
FNL1   MOVB *R1+,R3
       INV  R3                 ... and stream every byte inverted
       MOVB R3,@VDPWD
       DEC  R2
       JNE  FNL1
       LI   R0,PATTAB          pattern 0: blank (cleared screens use 32)
       CLR  R1
       LI   R2,8
       BL   @VFILL
       LI   R0,PATTAB+(160*8)-8   pattern 159, and 160 (reverse space) is
       LI   R1,>FF00              solid: fill 159 too so a reverse bar can
       LI   R2,8                  use either
       BL   @VFILL
       .leave
       RT

* TXCLS - fill the whole name table (30 rows' worth) with spaces.
TXCLS  .enter
       LI   R0,NAMTAB
       LI   R1,>2000
       LI   R2,30*COLS
       BL   @VFILL
       .leave
       RT

* TXROWS - clear rows R0 through R1 (inclusive) to spaces.  Uses R0-R3.
TXROWS .enter
       MOV  R1,R2
       S    R0,R2
       INC  R2                 row count
       MPY  @D80,R2            R2:R3 = count * 80
       MPY  @D80,R0            R0:R1 = first row * 80
       MOV  R1,R0              address
       MOV  R3,R2
       LI   R1,>2000
       BL   @VFILL
       .leave
       RT
D80    DATA 80

* TXAT - set the cursor: R0 = row, R1 = column.
TXAT   MOV  R0,@CURROW
       MOV  R1,@CURCOL
       RT

* TXSTR - print the string at R1 (a length byte, then the text) at the
* cursor, advancing it.  No wrapping (M1's renderer wraps words).
* R2 = >0000 for normal, >8000 for reverse video.  Uses R0-R5.
TXSTR  .enter
       MOV  R1,R4
       MOV  R2,R5
       MOV  @CURROW,R1
       MPY  @D80,R1            R1:R2 = row * 80
       MOV  R2,R0
       A    @CURCOL,R0
       BL   @VWAD
       MOVB *R4+,R3            length
       SRL  R3,8
       JEQ  TXS9
       A    R3,@CURCOL
TXS1   MOVB *R4+,R0
       SOCB R5,R0              >80 selects the reverse glyph set
       MOVB R0,@VDPWD
       DEC  R3
       JNE  TXS1
TXS9   .leave
       RT

* TXBAR - a full-width reverse-video bar on row R0 (the status line):
* reverse spaces.  Uses R0-R3.
TXBAR  .enter
       MPY  @D80,R0            R0:R1 = row * 80
       MOV  R1,R0
       LI   R1,>A000           reverse space (32 + >80)
       LI   R2,COLS
       BL   @VFILL
       .leave
       RT

* TXDEC - print R0 (0-65535) in decimal at the cursor, style in R2.
* R1 = field width (1-5): right-aligned, padded with spaces; or 0 for
* just the digits (no padding).  Uses R0-R7.
TXDEC  .enter
       MOV  R2,R7
       MOV  R1,R5              width
       LI   R6,NUMBUF+7        five digits into NUMBUF+2..+6, right to left
       LI   R4,5
TXD1   DEC  R6
       MOV  R0,R3              R2:R3 = value
       CLR  R2
       DIV  @D10,R2            R2 = value / 10, R3 = value mod 10
       AI   R3,'0'
       SWPB R3
       MOVB R3,*R6
       MOV  R2,R0
       DEC  R4
       JNE  TXD1
       LI   R4,4               leading zeros (never the last digit) ...
TXD2   CB   *R6,@TXDZER
       JNE  TXD3
       MOVB @TXDSPC,*R6+       ... become spaces
       DEC  R4
       JNE  TXD2
TXD3   LI   R4,NUMBUF+7        digits used: from R6 to NUMBUF+6
       S    R6,R4              R4 = significant digits
       MOV  R5,R5
       JNE  TXD4
       MOV  R4,R5              width 0: exactly the digits
TXD4   LI   R6,NUMBUF+7        the field ends with the last digit
       S    R5,R6
       DEC  R6                 length byte just before the field
       MOVB @TXDLEN(R5),*R6
       MOV  R6,R1
       MOV  R7,R2
       BL   @TXSTR
       .leave
       RT
D10    DATA 10
TXDLEN BYTE 0,1,2,3,4,5
TXDZER TEXT '0'
TXDSPC TEXT ' '
       EVEN

* TXHEX - print the high byte of R0 as two hex digits, style in R2.
* Uses R0-R5.
TXHEX  .enter
       MOV  R2,R5
       LI   R3,NUMBUF
       MOVB @TXDLEN+2,*R3+     length 2
       MOV  R0,R4
       SRL  R4,12              high nibble
       MOVB @HEXDIG(R4),*R3+
       MOV  R0,R4
       SRL  R4,8
       ANDI R4,>000F           low nibble of the high byte
       MOVB @HEXDIG(R4),*R3+
       LI   R1,NUMBUF
       MOV  R5,R2
       BL   @TXSTR
       .leave
       RT
HEXDIG TEXT '0123456789ABCDEF'

* TXSCRL - scroll rows R0+1 .. ROWS-1 up one row into R0 .. ROWS-2, and
* clear the bottom row.  One row at a time through ROWBUF (80 bytes):
* read row n+1, write it at row n.  Uses R0-R8.
TXSCRL .enter
       MOV  R0,R8              destination row
       MOV  @ROWS,R7
       DEC  R7                 bottom row
TSC1   C    R8,R7
       JHE  TSC2
       MOV  R8,R1
       INC  R1
       MPY  @D80,R1            R2 = (n+1) * 80
       MOV  R2,R0
       LI   R1,ROWBUF
       LI   R2,COLS
       BL   @VMBR
       MOV  R8,R1
       MPY  @D80,R1            R2 = n * 80
       MOV  R2,R0
       LI   R1,ROWBUF
       LI   R2,COLS
       BL   @VMBW
       INC  R8
       JMP  TSC1
TSC2   MOV  R7,R0
       MOV  R7,R1
       BL   @TXROWS
       .leave
       RT

* TXLINE - print the string at R1 as a new line of the text window:
* at the cursor row, column 0; then move down a row, scrolling the text
* window (TXTTOP to the bottom) when the cursor passes the bottom row.
* Uses R0-R8.
TXLINE .enter
       CLR  @CURCOL
       CLR  R2
       BL   @TXSTR
       INC  @CURROW
       C    @CURROW,@ROWS
       JL   TXL9
       MOV  @TXTTOP,R0
       BL   @TXSCRL
       DEC  @CURROW
TXL9   .leave
       RT
