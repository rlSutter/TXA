*======================================================================
* output.a99 - everything the story prints goes through CHOUT.
*
* CHOUT takes one character at a time and builds the current line in
* LBUF.  A line is written to the screen (EMITLN) when the story ends it
* or when it passes 80 columns; then it breaks at the last space, which
* is dropped, and the rest of the word starts the next line.  A word
* longer than the whole line is cut at 80.  A space arriving exactly at
* the break is dropped too.  tests/m1_vm_test.py checks the screen
* against a Python model of these rules.
*
* The text window runs from TXTTOP to the bottom row.  Lines go in at
* CROW; when CROW passes the bottom, the window scrolls.  After a
* windowful of lines with no input, [MORE] waits for a key.
*
* CHOUT is the one way text reaches the screen, which is why the tests
* watch it: the stream of characters passing through it must equal the
* Python reference VM's transcript, character for character.
*
* Registers: CHOUT and everything below preserve R4-R8 (the VM's) and
* clobber R0-R3, R12, R14, R15.
*======================================================================

* CHOUT - print the character in R0 (low byte; 10 = new line).
CHOUT  .enter
       MOV  R0,@CHCHR          keep the character across the calls below
       CI   R0,10
       JNE  CHO1
       BL   @EMITLN            a new line: write what there is
       JMP  CHO9
CHO1   MOV  @LLEN,R1
       CI   R1,COLS
       JL   CHO6               room on the line: just add it
       CI   R0,' '             full, and a space: the break, dropped
       JNE  CHO2
       BL   @EMITLN
       JMP  CHO9
CHO2   LI   R2,COLS-1          full mid-word: find the last space
CHO3   MOVB @LBUF(R2),R3       (plain or underlined: >20 or >A0)
       ANDI R3,>7F00
       CI   R3,>2000
       JEQ  CHO4
       DEC  R2
       JOC  CHO3               (DEC sets carry while the result is >= 0)
       BL   @EMITLN            no space at all: cut the word at 80
       JMP  CHO6
CHO4   MOV  R2,@CHBRK          the space's column
       MOV  R2,@LLEN           write the line up to the space
       BL   @EMITLN
       MOV  @CHBRK,R2          move the word's start to the line start
       LI   R1,COLS-1
       S    R2,R1              R1 = characters after the space
       MOV  R1,@LLEN
       JEQ  CHO6
       INC  R2
       CLR  R3
CHO5   MOVB @LBUF(R2),@LBUF(R3)
       MOVB @ABUF(R2),@ABUF(R3)
       INC  R2
       INC  R3
       DEC  R1
       JNE  CHO5
CHO6   MOV  @CHCHR,R0          add the character ...
       CI   R0,' '
       JL   CHO7
       CI   R0,126
       JH   CHO7
       SOC  @CURUL,R0          ... underlined: the glyph set at +>80 ...
CHO7   SWPB R0
       MOV  @LLEN,R1
       MOVB R0,@LBUF(R1)
       MOV  @CURAT,R2          and its colours
       SWPB R2
       MOVB R2,@ABUF(R1)
       INC  @LLEN
CHO9   .leave
       RT

* EMITLN - write LBUF (LLEN characters) on row CROW, blank to the
* right (or centred, while STYLE 8 is on), and move down a row; scroll
* first if CROW is below the window.
* Counts lines toward [MORE].
EMITLN .enter
       BL   @ROWFIT            CROW onto the screen (scrolling)
       MOV  @CROW,R0
       MPY  @D80,R0            R1 = row * 80
       MOV  R1,R0
       MOV  R0,R14             row start, kept
       MOV  @CENTRD,R0         centred (STYLE 8)?
       JEQ  EML0
       MOV  R14,R0             the whole row blank first ...
       LI   R1,>2000
       LI   R2,COLS
       BL   @VFILL
       MOV  R14,R0
       AI   R0,ATRTAB
       LI   R1,ATNORM*256
       LI   R2,COLS
       BL   @VFILL
       LI   R0,COLS            ... then the line, (80 - length) / 2 in
       S    @LLEN,R0
       SRL  R0,1
       A    R0,R14
       LI   R1,LBUF
       MOV  R14,R0
       MOV  @LLEN,R2
       JEQ  EML2
       BL   @VMBW
       MOV  R14,R0
       AI   R0,ATRTAB
       LI   R1,ABUF
       MOV  @LLEN,R2
       BL   @VMBW
       JMP  EML2
EML0   MOV  R14,R0
       LI   R1,LBUF
       MOV  @LLEN,R2
       JEQ  EML1
       BL   @VMBW
       MOV  R14,R0             the characters' colours
       AI   R0,ATRTAB
       LI   R1,ABUF
       MOV  @LLEN,R2
       BL   @VMBW
EML1   MOV  R14,R0             blank the rest of the row: spaces ...
       A    @LLEN,R0
       LI   R1,>2000
       LI   R2,COLS
       S    @LLEN,R2
       JEQ  EML2
       BL   @VFILL
       MOV  R14,R0             ... in normal colours
       A    @LLEN,R0
       AI   R0,ATRTAB
       LI   R1,ATNORM*256
       LI   R2,COLS
       S    @LLEN,R2
       BL   @VFILL
EML2   CLR  @LLEN
       INC  @CROW
       INC  @MORECT            a windowful without a pause?
       MOV  @ROWS,R0
       S    @TXTTOP,R0
       DEC  R0                 (one row is left for [MORE] itself)
       C    @MORECT,R0
       JL   EML9
       BL   @MORE
EML9   .leave
       RT

* ROWFIT - if CROW is past the bottom row, scroll the text window up a
* row and put CROW on the bottom row.
ROWFIT .enter
       C    @CROW,@ROWS
       JL   RWF9
       BL   @WSCRL
       MOV  @ROWS,R0
       DEC  R0
       MOV  R0,@CROW
RWF9   .leave
       RT

* WSCRL - scroll rows TXTTOP+1 .. bottom up one row; blank the bottom.
* One row at a time through ROWBUF.  Uses R0-R3, R14, R15 (not
* text80.a99's TXSCRL, which uses R4-R8, the VM's registers).
WSCRL  .enter
       MOV  @TXTTOP,R14        destination row
       MOV  @ROWS,R15
       DEC  R15                bottom row
WSC1   C    R14,R15
       JHE  WSC2
       MOV  R14,R1
       INC  R1
       MPY  @D80,R1            R2 = (n+1) * 80
       MOV  R2,R0
       LI   R1,ROWBUF
       LI   R2,COLS
       BL   @VMBR
       MOV  R14,R1
       MPY  @D80,R1
       MOV  R2,R0
       LI   R1,ROWBUF
       LI   R2,COLS
       BL   @VMBW
       MOV  R14,R1             the row's colours, the same way
       INC  R1
       MPY  @D80,R1
       MOV  R2,R0
       AI   R0,ATRTAB
       LI   R1,ROWBUF
       LI   R2,COLS
       BL   @VMBR
       MOV  R14,R1
       MPY  @D80,R1
       MOV  R2,R0
       AI   R0,ATRTAB
       LI   R1,ROWBUF
       LI   R2,COLS
       BL   @VMBW
       INC  R14
       JMP  WSC1
WSC2   MOV  R15,R0
       BL   @ECLR
       .leave
       RT

* ECLR - row R0: spaces in normal colours.  Uses R0-R3.
ECLR   .enter
       MPY  @D80,R0            R1 = row * 80
       MOV  R1,R3
       MOV  R3,R0
       LI   R1,>2000
       LI   R2,COLS
       BL   @VFILL
       MOV  R3,R0
       AI   R0,ATRTAB
       LI   R1,ATNORM*256
       LI   R2,COLS
       BL   @VFILL
       .leave
       RT

* REVSPN - reverse colours for R2 cells from screen offset R0 (row * 80
* + column).  Uses R0-R2.
REVSPN .enter
       AI   R0,ATRTAB
       LI   R1,ATREV*256
       BL   @VFILL
       .leave
       RT

* MORE - "[MORE]" in reverse video on the next row; wait for a key;
* blank it.  The count starts again.
MORE   .enter
       BL   @ROWFIT
       MOV  @CROW,R0
       MPY  @D80,R0
       MOV  R1,R0
       MOV  R0,R14
       LI   R1,SMORE
       LI   R2,6
       BL   @VMBW
       MOV  R14,R0             in reverse colours
       LI   R2,6
       BL   @REVSPN
       BL   @WAITKY
       MOV  @CROW,R0           then blank the row again
       BL   @ECLR
       CLR  @MORECT
       .leave
       RT
SMORE  TEXT '[MORE]'
       EVEN

* WAITKY - wait for a key press; R0 = its code (high byte).  Saves R4
* and R5 around the keyboard scan, which uses them.
* KEYGET reports a key only when it differs from the last one it saw.
* Nothing scans the keyboard between two waits, so a release in between
* goes unseen and pressing the same key again (SPACE at every [MORE])
* would look like one long press.  So each wait forgets the last key.
WAITKY .enter
       DECT R10
       MOV  R4,*R10
       DECT R10
       MOV  R5,*R10
       CLR  @KEYLST
WKY1   MOVB @VDPSTA,@SNDST    a new frame: the sound player runs
       JGT  WKY2
       JEQ  WKY2
       BLWP @SNDVEC
WKY2   BL   @KSCAN
       BL   @KEYGET
       MOV  R0,R0
       JEQ  WKY1
       MOV  *R10+,R5
       MOV  *R10+,R4
       .leave
       RT

* FLUSH - write a partly built line (at a prompt, or when the game
* ends) without waiting for more.
FLUSH  .enter
       MOV  @LLEN,R0
       JEQ  FLS9
       BL   @EMITLN
FLS9   .leave
       RT

* CHSTR - print the length-prefixed string at R1 (in RAM).
CHSTR  .enter
       MOVB *R1+,R2
       SRL  R2,8
       JEQ  CHS9
       MOV  R1,@TMP1
       MOV  R2,@TMP2
CHS1   MOV  @TMP1,R1
       MOVB *R1+,R0
       SRL  R0,8
       MOV  R1,@TMP1
       BL   @CHOUT
       DEC  @TMP2
       JNE  CHS1
CHS9   .leave
       RT

* PRSTR - print the story string at packed address R1.  Bytes 1-127
* are characters (10 = new line); >80->FF are entries of the
* substitution table, each a zero-ended run of characters; 0 ends.
PRSTR  .enter
       BL   @TXSET
PRS1   BL   @TXNEXT
       MOV  R0,R0
       JEQ  PRS9
       CI   R0,>80
       JHE  PRS2
       BL   @CHOUT
       JMP  PRS1
PRS2   AI   R0,->80            a substitution: its offset from the table
       SLA  R0,1
       MOV  @H.ABBR,R1
       A    R0,R1
       BL   @RDW
       A    @H.ABBR,R0
       MOV  R0,@ABPTR
PRS3   MOV  @ABPTR,R1
       BL   @RDB
       MOV  R0,R0
       JEQ  PRS1
       INC  @ABPTR
       BL   @CHOUT
       JMP  PRS3
PRS9   .leave
       RT

* FIRSTC - the first character of the story string at packed address
* R1 (following a substitution), in R0; 0 for an empty string.
FIRSTC .enter
       BL   @TXSET
       BL   @TXNEXT
       CI   R0,>80
       JL   FSC9
       AI   R0,->80
       SLA  R0,1
       MOV  @H.ABBR,R1
       A    R0,R1
       BL   @RDW
       MOV  R0,R1
       A    @H.ABBR,R1
       BL   @RDB
FSC9   .leave
       RT

* PRNUM - print R1 as a signed decimal number.
PRNUM  .enter
       MOV  R1,R1
       JGT  PRN1
       JEQ  PRN1
       MOV  R1,@TMP1
       LI   R0,'-'
       BL   @CHOUT
       MOV  @TMP1,R1
       NEG  R1                 -32768 stays >8000: 32768 unsigned, right
PRN1   LI   R14,NUMDIG         digits, last first
PRN2   CLR  R0
       DIV  @D10,R0            R0 = R1 / 10, R1 = remainder (unsigned)
       AI   R1,'0'
       SWPB R1
       MOVB R1,*R14+
       MOV  R0,R1
       JNE  PRN2
       MOV  R14,@TMP1
PRN3   DEC  @TMP1
       MOV  @TMP1,R1
       MOVB *R1,R0
       SRL  R0,8
       BL   @CHOUT
       C    @TMP1,@NUMDP
       JNE  PRN3
       .leave
       RT
NUMDP  DATA NUMDIG

* DRAWST - draw the status line from STROOM, STSCR and STMOV.
DRAWST .enter
       CLR  R0                 row 0: spaces
       LI   R1,>2000
       LI   R2,COLS
       BL   @VFILL
       LI   R0,STBUF           the room's name into STBUF ...
       MOV  R0,@STPTR
       MOV  @STROOM,R14
       JNE  DST1
       LI   R1,SDARK           ... "Darkness" for 0
       BL   @STCAT
       JMP  DST2
DST1   BL   @SHORTN            R0 = its name's packed address
       MOV  R0,R1
       JEQ  DST2
       BL   @STSTR
DST2   LI   R0,1               ... and onto the screen from column 1
       LI   R1,STBUF
       MOV  @STPTR,R2
       AI   R2,-STBUF
       JEQ  DST3
       BL   @VMBW
DST3   LI   R0,STBUF           the right-hand side
       MOV  R0,@STPTR
       MOV  @STSCR,R1
       CI   R1,-1
       JEQ  DST4
       LI   R1,SSCORE
       BL   @STCAT
       MOV  @STSCR,R1
       BL   @STNUM
       LI   R1,SSPACE
       BL   @STCAT
DST4   LI   R1,SMOVES
       BL   @STCAT
       MOV  @STMOV,R1
       BL   @STNUM
       MOV  @STPTR,R2          length; it ends at column 78
       AI   R2,-STBUF
       LI   R0,79
       S    R2,R0
       LI   R1,STBUF
       BL   @VMBW
       .leave
       RT
SDARK  BYTE 8
       TEXT 'Darkness'
SSCORE BYTE 7
       TEXT 'Score: '
SSPACE BYTE 2
       TEXT '  '
SMOVES BYTE 7
       TEXT 'Moves: '
       EVEN

* STCAT - append the length-prefixed string at R1 to STBUF.  Uses R0-R2.
STCAT  MOVB *R1+,R2
       SRL  R2,8
       JEQ  STC9
       MOV  @STPTR,R0
STC1   MOVB *R1+,*R0+
       DEC  R2
       JNE  STC1
       MOV  R0,@STPTR
STC9   RT

* STSTR - append the story string at packed address R1 (substitutions
* expanded) to STBUF, at most 48 characters.
STSTR  .enter
       BL   @TXSET
STS1   BL   @TXNEXT
       MOV  R0,R0
       JEQ  STS9
       CI   R0,>80
       JHE  STS2
       BL   @STPUT
       JMP  STS1
STS2   AI   R0,->80            a substitution
       SLA  R0,1
       MOV  @H.ABBR,R1
       A    R0,R1
       BL   @RDW
       A    @H.ABBR,R0
       MOV  R0,@ABPTR
STS3   MOV  @ABPTR,R1
       BL   @RDB
       MOV  R0,R0
       JEQ  STS1
       INC  @ABPTR
       BL   @STPUT
       JMP  STS3
STS9   .leave
       RT
* STPUT - append the character in R0's low byte, if there is room.
STPUT  MOV  @STPTR,R1
       CI   R1,STBUF+48
       JHE  STP9
       SWPB R0
       MOVB R0,*R1+
       MOV  R1,@STPTR
STP9   RT

* STNUM - append R1 as a signed decimal number.  Uses R0-R3.
STNUM  MOV  R1,R1
       JGT  STN1
       JEQ  STN1
       MOV  @STPTR,R0          a minus sign
       LI   R2,'-'*256
       MOVB R2,*R0+
       MOV  R0,@STPTR
       NEG  R1
STN1   LI   R3,NUMDIG          digits, last first
STN2   CLR  R0
       DIV  @D10,R0
       AI   R1,'0'
       SWPB R1
       MOVB R1,*R3+
       MOV  R0,R1
       JNE  STN2
       MOV  @STPTR,R0
STN3   DEC  R3
       MOVB *R3,*R0+
       CI   R3,NUMDIG
       JNE  STN3
       MOV  R0,@STPTR
       RT

* CLS - the text window cleared (rows TXTTOP to the bottom), the next
* line at its top; a partly written line is written first.
OPCLS  BL   @FLUSH
       MOV  @TXTTOP,@UTMP
CLS1   MOV  @UTMP,R0
       C    R0,@ROWS
       JHE  CLS2
       BL   @ECLR
       INC  @UTMP
       JMP  CLS1
CLS2   MOV  @TXTTOP,@CROW
       CLR  @MORECT
       B    @NEXT
