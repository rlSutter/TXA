*======================================================================
* wtiart.a99 - TI Artist pictures on the TI (M6 part 9), overlay 12:
* the converter, matching tools/tiartist.py byte for byte (the reference).
*
* The picture's two files, NAME_P (patterns) and NAME_C (colours), 6144
* bytes each, are kept interleaved in SAMS from page TIPG: byte 2i is P[i],
* 2i+1 is C[i] (one mapping serves both).  The fitting (TIMODE: 0 crop,
* 1 squeeze; TIROW: the crop's first row) gives 96 rows of 128 fat
* pixels; two to a byte, the left in the high nybble, they go to RAWPG
* (6144 bytes); then the record (format 4, 16 colours, the TI palette, the
* pixels run-length packed as tools/rlepack.py does) to OUTPG, TILEN bytes.
*
* The rules (tiartist.py): a pixel's colour is its colour byte's high
* nybble where its pattern bit is set, else the low; two pixels into one:
* the first, unless it is background (0 or 1) and the second is not.
*======================================================================
TIPG   EQU  21                 the interleaved picture (3 pages)
RAWPG  EQU  24                 the fitted pixels (2 pages)
OUTPG  EQU  26                 the record (2 pages)
TIMODE EQU  GLOBRM+>1CA        0 crop, 1 squeeze
TIROW  EQU  GLOBRM+>1CC        the crop's first row (0-96, even)
TILEN  EQU  GLOBRM+>1CE        the record's length
TIY    EQU  GLOBRM+>1D0        the fitting: the row (0-95) ...
TIX    EQU  GLOBRM+>1D2        ... the byte in it (0-63)
TIRI   EQU  GLOBRM+>1D4        the raw byte being written / read
TIOI   EQU  GLOBRM+>1D6        the record byte being written
TIOPG  EQU  GLOBRM+>1D8        the page window F shows (the record)
TILS   EQU  GLOBRM+>1DA        the packer: the literal run's start ...
TILC   EQU  GLOBRM+>1DC        ... and length
AREAPG EQU  28                 Build's picture area (4 pages: 16K)
TINPIC EQU  ULIT+100           Build: how many pictures
TIK    EQU  ULIT+102           ... the one being made (from 0)
TIAP   EQU  ULIT+104           ... the area's next byte
TIDX   EQU  ULIT+106           ... its declaration
TIWF   EQU  ULIT+108           ... the file being written
TINROW EQU  ULIT+110           TIFIT: how many rows ...
TIFPG  EQU  ULIT+112           ... into which pages
TISQOK EQU  ULIT+114           the preview: the squeeze made yet?
TIM0   EQU  ULIT+116           ... NAME_T's choice, kept while the crop is made
TIR0   EQU  ULIT+118
FULLPG EQU  24                 the preview: all 192 rows, cropped (3 pages)
SQPG   EQU  27                 ... the squeeze (2 pages)
TIRES  EQU  GLOBRM+>1DE        TIFILE: 0, or the DSR's error loading the picture
* TINAME (wsymdef.a99): the picture's name

* TITEST - convert what is staged (TIMODE, TIROW, the interleaved files),
* then the menu: the tests' way in (overlay 12, entered at OVENT).
TITEST LI   R10,STACKT
       MOVB @TINAME,R0         a name: the picture and its choice from disk
       JEQ  TIT1
       BL   @TIFILE
       MOV  @TIRES,R0
       JNE  TIT9
TIT1   BL   @TICONV
TIT9   B    @MENUGO

* TIFILE - the picture named by TINAME from disk: NAME_P and NAME_C staged
* interleaved, NAME_T's choice into TIMODE and TIROW (none: crop 48).
* TIRES = 0, or the DSR's error (a file that would not load).  The files
* (6144 bytes each, more than FBUF's room) load at >1800 over the font,
* which is loaded again after.
TIFILE .enter
       CLR  @TIRES
       LI   R0,'P'             the patterns: the even bytes
       CLR  R1
       BL   @TILOAD
       MOV  @TIRES,R0
       JNE  TIF9
       LI   R0,'C'             the colours: the odd
       LI   R1,1
       BL   @TILOAD
TIF9   BL   @WFONT             the font back (bold, if so), the sprites cleared
       BL   @SPRZER
       MOV  @TIRES,R0
       JNE  TIF99
       BL   @TISET             the choice
TIF99  .leave
       RT
* TILOAD - TINAME + '_' + the letter R0, loaded at >1800 and copied into
* the staging pages at offset R1 (0 even, 1 odd) of each byte pair.
TILOAD .enter
       MOV  R1,@TIPAR
       BL   @TIFNAM
       LI   R0,>1800
       MOV  R0,@DKBUF
       LI   R0,5               the DSR's LOAD, 6144 bytes
       LI   R1,6144
       BL   @DSKCAL
       CLR  @DKBUF
       MOV  R0,@TIRES
       JNE  TIL9
       LI   R0,>1800           the bytes, in order, from VRAM
       BL   @VRAD
       CLR  R4                 the pair being written (0-6143)
TIL1   MOV  R4,R1
       SLA  R1,1
       A    @TIPAR,R1
       MOV  R1,R0
       SRL  R0,12
       AI   R0,TIPG
       BL   @DMAP
       ANDI R1,>0FFF
       MOVB @VDPRD,@>D000(R1)
       INC  R4
       CI   R4,6144
       JL   TIL1
TIL9   .leave
       RT
* TIFNAM - FNBUF := TINAME + '_' + the letter R0.  Uses R0-R3.
TIFNAM MOVB @TINAME,R3
       SRL  R3,8
       LI   R1,TINAME+1
       LI   R2,FNBUF+1
       MOV  R3,R4
TIFN1  MOVB *R1+,*R2+
       DEC  R4
       JNE  TIFN1
       LI   R1,'_'*256
       MOVB R1,*R2+
       SWPB R0
       MOVB R0,*R2+
       AI   R3,2
       SWPB R3
       MOVB R3,@FNBUF
       RT
* TISET - TIMODE, TIROW from NAME_T (a DV80 file, one line: "squeeze" or
* "crop ROW"); none, or a line neither: crop 48.
TISET  .enter
       CLR  @TIMODE
       LI   R0,48
       MOV  R0,@TIROW
       LI   R0,'T'
       BL   @TIFNAM
       BL   @DVOPEN
       MOV  R0,R0
       JNE  TIS9
       BL   @DVREAD
       MOV  R0,R5              (its length, or -1)
       BL   @DVCLOS
       MOV  R5,R5
       JLT  TIS9
       JEQ  TIS9
       LI   R0,FBUF            the line, from VRAM
       LI   R1,TIBUF
       MOV  R5,R2
       CI   R2,16
       JLE  TIS1
       LI   R2,16
TIS1   BL   @VMBR
       MOVB @TIBUF,R0          "squeeze" (s or S first)
       ANDI R0,>DF00
       CI   R0,'S'*256
       JNE  TIS2
       LI   R0,1
       MOV  R0,@TIMODE
       JMP  TIS9
TIS2   CLR  R3                 "crop ROW": the digits, as a number
       LI   R1,TIBUF
TIS3   MOV  R5,R5
       JEQ  TIS4
       MOVB *R1+,R0
       SRL  R0,8
       DEC  R5
       AI   R0,-'0'
       JLT  TIS3
       CI   R0,9
       JH   TIS3
       MPY  @D10TI,R3          R3:R4 = R3 x 10
       MOV  R4,R3
       A    R0,R3
       JMP  TIS3
TIS4   MOV  R3,@TIROW
TIS9   .leave
       RT

* TIBLD - Build's pictures (from overlay 9, the engine and story written):
* each PICTURE the program declares, in order, from its TI Artist files on
* the source's device (NAME_P, NAME_C; NAME_T's choice), converted and
* laid out as the picture area (a count, an offset each, the records: as
* tools/txpics.py lays it out), written as PREFIXP01 .. and the next one
* deleted.  If the first picture has no TI Artist files, the picture files
* are left as they are (made on the PC); a later one missing is an error.
* Then Build's message (overlay 9, BDFIN), or the error on row 8.
TIBLD  LI   R10,STACKT
       CLR  @TINPIC            how many pictures
       CLR  R3
TB1    C    R3,@DXN
       JHE  TB2
       BL   @DXINF
       CI   R4,NT.PIC
       JNE  TB1A
       MOV  R5,R5              (not a dropped one)
       JLT  TB1A
       INC  @TINPIC
TB1A   INC  R3
       JMP  TB1
TB2    MOV  @TINPIC,R0
       JEQ  TB99               none: nothing to do
       SLA  R0,2               the records start after the count and offsets
       INCT R0
       MOV  R0,@TIAP
       MOV  @TINPIC,R0         the count
       CLR  R1
       BL   @TIAPUT
       CLR  @TIK               the picture being made (from 0)
       CLR  R3
TB3    C    R3,@DXN
       JHE  TB8
       BL   @DXINF
       CI   R4,NT.PIC
       JNE  TB7
       MOV  R5,R5
       JLT  TB7
       MOV  R3,@TIDX
       BL   @DXSEEK            its name, then its file's name (NAMB)
       BL   @KEYRD
       BL   @KEYRD
       BL   @TIPNAM            TINAME := the device + that name
       LI   R0,TIPROG          (the progress line: "Picture DSK1.BIRD")
       MOV  R0,R1
       LI   R2,TINAME
       BL   @PSTAGE
       BL   @TIFILE
       MOV  @TIRES,R0
       JEQ  TB4
       MOV  @TIK,R0            not there: the first, so none (the PC's kept)
       JEQ  TB99
       B    @TBMISS            a later one: said, and the build stops
TB4    BL   @TICONV
       MOV  @TIK,R1            its offset: the area's position now
       SLA  R1,2
       INCT R1
       MOV  @TIAP,R0
       BL   @TIAPW2
       BL   @TICOPY            the record onto the area
       MOV  @TIDX,R3
       INC  @TIK
TB7    INC  R3
       JMP  TB3
TB8    BL   @TIWRIT            the area as PREFIXP01 ..
TB99   BL   @PCLEAR
       LI   R0,9               Build's message
       B    @OVGO4
TBMISS BL   @PCLEAR            row 8: which picture has no files
       LI   R0,8
       BL   @WCLR
       LI   R0,8
       LI   R1,1
       BL   @TXAT
       LI   R1,QTIMIS
       CLR  R2
       BL   @TXSTR
       LI   R1,TINAME
       CLR  R2
       BL   @TXSTR
       LI   R1,QTIMS2
       CLR  R2
       BL   @TXSTR
       B    @MENUGO

* TIPNAM - TINAME := the source's device (WBNAME up to its last '.') and
* the picture's file name (NAMB, KEYL long).  Uses R0-R4.
TIPNAM LI   R4,TINAME+1
       MOV  @WBNLEN,R0
       CLR  R1
       CLR  R2
TPN1   C    R2,R0
       JHE  TPN2
       CB   @WBNAME(R2),@QTIDOT
       JNE  TPN1A
       MOV  R2,R1
       INC  R1
TPN1A  INC  R2
       JMP  TPN1
TPN2   CLR  R2
TPN3   C    R2,R1
       JHE  TPN4
       MOVB @WBNAME(R2),*R4+
       INC  R2
       JMP  TPN3
TPN4   CLR  R2
TPN5   C    R2,@KEYL
       JHE  TPN6
       MOVB @NAMB(R2),*R4+
       INC  R2
       JMP  TPN5
TPN6   MOV  R4,R0
       AI   R0,-TINAME-1
       SWPB R0
       MOVB R0,@TINAME
       RT

* TIAPUT - the area's word at offset R0 := R1.  TIAPW2 - the word pair
* (a 32-bit offset, high word 0) at area offset R1 := R0.  Use R0-R2.
TIAPW2 MOV  R11,@TIARET
       MOV  R0,R2              the low word at R1 + 2, the high (0) at R1
       MOV  R1,R0
       CLR  R1
       MOV  R2,@TIAPV
       BL   @TIAWD
       INCT R0
       MOV  @TIAPV,R1
       BL   @TIAWD
       MOV  @TIARET,R11
       RT
TIAPUT MOV  R11,@TIARET         (R0 the value, R1 the offset)
       MOV  R0,R2
       MOV  R1,R0
       MOV  R2,R1
       BL   @TIAWD
       MOV  @TIARET,R11
       RT
* TIAWD - the area's word at offset R0 := R1 (bytes high then low).  Keeps
* R0, R1.  TIAWD0: R1 the value, R0 the offset (the same).
TIAWD
TIAWD0 MOV  R11,@TIAWRT
       MOV  R0,@TIAWO
       MOV  R1,@TIAWV
       MOV  R1,R2
       SWPB R2
       BL   @TIABYT            (the high byte: R2's low after the swap)
       MOV  @TIAWO,R0
       INC  R0
       MOV  @TIAWV,R2
       BL   @TIABYT
       MOV  @TIAWO,R0
       MOV  @TIAWV,R1
       MOV  @TIAWRT,R11
       RT
* TIABYT - the area's byte at offset R0 := R2's low byte.  Uses R0-R2.
TIABYT MOV  R11,@TIABRT
       MOV  R0,R1
       SRL  R0,12
       AI   R0,AREAPG
       BL   @EMAP
       ANDI R1,>0FFF
       SWPB R2
       MOVB R2,@>E000(R1)
       MOV  @TIABRT,R11
       RT
* TICOPY - the record (OUTPG, TILEN bytes) onto the area at TIAP.
TICOPY MOV  R11,@TICRET
       CLR  R4
TCP1   C    R4,@TILEN
       JHE  TCP9
       MOV  R4,R1              the record's byte (window F)
       MOV  R1,R0
       SRL  R0,12
       AI   R0,OUTPG
       MOV  R1,@TICTMP
       LI   R1,>F
       BL   @MAPPG
       MOV  @TICTMP,R1
       ANDI R1,>0FFF
       MOVB @>F000(R1),R2
       SRL  R2,8
       MOV  @TIAP,R0           onto the area
       BL   @TIABYT
       INC  @TIAP
       INC  R4
       JMP  TCP1
TCP9   SETO @XFPG
       MOV  @TICRET,R11
       RT
* TIWRIT - the area (TIAP bytes) written as PREFIXP01, P02 .. (4K each,
* through FBUF), then the next one deleted (a file left from an earlier
* build would be loaded after these).
TIWRIT MOV  R11,@TIWRET
       CLR  @TIWF              the file (from 0)
TW1    MOV  @TIWF,R4           its bytes: 4096, or what is left
       SLA  R4,12
       MOV  @TIAP,R5
       S    R4,R5
       JLT  TW8
       JEQ  TW8
       CI   R5,4096
       JLE  TW2
       LI   R5,4096
TW2    MOV  @TIWF,R0           the area's page into window E, to FBUF
       AI   R0,AREAPG
       BL   @EMAP
       LI   R0,FBUF
       LI   R1,>E000
       MOV  R5,R2
       BL   @VMBW
       MOV  @TIWF,R0
       BL   @TIPFN             FNBUF: device, prefix, P, two digits
       LI   R0,6               the DSR's SAVE
       MOV  R5,R1
       BL   @DSKCAL
       MOV  R0,R0
       JNE  TW9
       INC  @TIWF
       JMP  TW1
TW8    MOV  @TIWF,R0           the next one deleted (an error, none there,
       BL   @TIPFN             is fine)
       LI   R0,7
       CLR  R1
       BL   @DSKCAL
TW9    MOV  @TIWRET,R11
       RT
* TIPFN - FNBUF := the source's device, the prefix (WPFX), 'P' and file R0
* + 1 in two digits.  Uses R0-R4.
TIPFN  MOV  R0,R3
       INC  R3
       LI   R4,FNBUF+1
       MOV  @WBNLEN,R0
       CLR  R1
       CLR  R2
TQF1   C    R2,R0
       JL  $+6
       B    @TQF2
       CB   @WBNAME(R2),@QTIDOT
       JNE  TQF1A
       MOV  R2,R1
       INC  R1
TQF1A  INC  R2
       B    @TQF1
TQF2   CLR  R2
TQF3   C    R2,R1
       JHE  TQF4
       MOVB @WBNAME(R2),*R4+
       INC  R2
       B    @TQF3
TQF4   MOVB @WPFX,R0
       SRL  R0,8
       CLR  R2
TQF5   C    R2,R0
       JHE  TQF6
       MOVB @WPFX+1(R2),*R4+
       INC  R2
       JMP  TQF5
TQF6   LI   R0,'P'*256
       MOVB R0,*R4+
       CLR  R2                 two digits
       MOV  R3,R1
       CLR  R0
       DIV  @D10TI,R0          R0 tens, R1 ones
       AI   R0,'0'
       SWPB R0
       MOVB R0,*R4+
       AI   R1,'0'
       SWPB R1
       MOVB R1,*R4+
       MOV  R4,R0
       AI   R0,-FNBUF-1
       SWPB R0
       MOVB R0,@FNBUF
       RT

* TIPREV - the I key (overlay 12, >B008; overlay 8 has put the name in
* TINAME): the picture loaded and shown on the bitmap layer as a game shows
* it, cropped or squeezed as NAME_T says (or crop 48).  FCTN E and X move
* the crop's band by two rows, S switches crop and squeeze, ENTER writes
* the choice to NAME_T, FCTN 9 leaves without.  All 192 rows are cropped
* once at the start, so moving the band only copies them to VRAM; the
* squeeze is made the first time it is wanted.  The bitmap is at VRAM
* >2000 (over FBUF, the PAB and the bottom of the controller's buffers,
* which the next disk call's power-up makes again).
TIPREV LI   R10,STACKT
       LI   R4,1               rows 1-14 cleared
TPV0   MOV  R4,R0
       BL   @WCLR
       INC  R4
       CI   R4,15
       JL   TPV0
       LI   R1,QTPLD
       BL   @TIMSG
       BL   @TIFILE
       MOV  @TIRES,R0
       JEQ  TPV1
       LI   R1,QTPBAD          not loaded: say so, a key, the menu
       BL   @TIMSG
       LI   R1,TINAME
       CLR  R2
       BL   @TXSTR
       BL   @WKEY
       B    @MENUGO
TPV1   LI   R1,QTPCV
       BL   @TIMSG
       MOV  @TIMODE,@TIM0      NAME_T's choice kept
       MOV  @TIROW,@TIR0
       CLR  @TIMODE            all 192 rows, cropped
       CLR  @TIROW
       LI   R0,192
       MOV  R0,@TINROW
       LI   R0,FULLPG
       MOV  R0,@TIFPG
       BL   @TIFIT
       CLR  @TISQOK
       MOV  @TIR0,@TIROW
       MOV  @TIM0,@TIMODE
       JEQ  TPV1A
       BL   @TISQZ
TPV1A  LI   R0,32              the TI's colours into palette entries 32-47
       LI   R1,TIPAL
       LI   R2,16
       BL   @F18PAL
TPV2   BL   @TISHOW
       BL   @TISTAT
TPV2K  BL   @TIREL             (a key let go while the picture was copied)
       BL   @WKEY
       CI   R0,11              FCTN E: the band up
       JNE  TPV3
       MOV  @TIMODE,R1
       JNE  TPV2K
       MOV  @TIROW,R1
       JEQ  TPV2K
       DECT @TIROW
       JMP  TPV2
TPV3   CI   R0,12              FCTN X: down
       JNE  TPV4
       MOV  @TIMODE,R1
       JNE  TPV2K
       MOV  @TIROW,R1
       CI   R1,96
       JHE  TPV2K
       INCT @TIROW
       JMP  TPV2
TPV4   CI   R0,'S'             S: crop or squeeze
       JEQ  TPV4S
       CI   R0,'s'
       JNE  TPV5
TPV4S  MOV  @TIMODE,R1
       JEQ  TPV4A
       CLR  @TIMODE
       JMP  TPV2
TPV4A  MOV  @TISQOK,R1
       JNE  TPV4B
       LI   R1,QTPCV
       BL   @TIMSG
       BL   @TISQZ
TPV4B  LI   R0,1
       MOV  R0,@TIMODE
       JMP  TPV2
TPV5   CI   R0,13              ENTER: saved
       JNE  TPV6
       BL   @TISAVE
       JMP  TPV9
TPV6   CI   R0,15              FCTN 9: left
       JNE  TPV2K
TPV9   LI   R0,>9F00           the layer off
       BL   @VDPWR
       B    @MENUGO

* TIREL - one look at the keyboard: nothing pressed now, the last key is
* forgotten, as WKEY forgets it when it sees the keys let go.  (A key let
* go while the preview was busy would otherwise make the same key, pressed
* again, look like the same press still held.)  Uses R0-R5.
TIREL  MOV  R11,@TIRRT2
       BL   @KSCAN
       LI   R1,KEYMAP
       LI   R3,6
TIRL1  MOVB *R1+,R4
       INV  R4
       ANDI R4,>FF00
       CI   R3,6               column 0: = SPACE ENTER only
       JNE  TIRL2
       ANDI R4,>0700
TIRL2  MOV  R4,R4
       JNE  TIRL9              something held: the same press
       DEC  R3
       JNE  TIRL1
       CLR  @WKLST
TIRL9  MOV  @TIRRT2,R11
       RT
TIRRT2 DATA 0

* TISQZ - the squeeze, 96 rows into SQPG.  TIMODE is left 1.
TISQZ  MOV  R11,@TISRET
       LI   R0,1
       MOV  R0,@TIMODE
       LI   R0,96
       MOV  R0,@TINROW
       LI   R0,SQPG
       MOV  R0,@TIFPG
       BL   @TIFIT
       SETO @TISQOK
       MOV  @TISRET,R11
       RT

* TISHOW - the fitting shown: its 6144 bytes (the crop's band from all 192
* rows, or the squeeze) copied to VRAM >2000, and the layer on: 96 rows
* under the top row, 16 colours, palette 32-47, as the engine shows it.
TISHOW .enter
       MOV  @TIMODE,R0
       JNE  TSH1
       MOV  @TIROW,R4          the band's first byte
       SLA  R4,6
       LI   R5,FULLPG
       JMP  TSH2
TSH1   CLR  R4
       LI   R5,SQPG
TSH2   LI   R6,>2000
       LI   R7,6144
TSH3   MOV  R4,R0              this page's part
       SRL  R0,12
       A    R5,R0
       BL   @EMAP
       MOV  R4,R1
       ANDI R1,>0FFF
       LI   R2,4096
       S    R1,R2
       C    R2,R7
       JLE  TSH4
       MOV  R7,R2
TSH4   MOV  R2,R8
       AI   R1,>E000
       MOV  R6,R0
       BL   @VMBW
       A    R8,R6
       A    R8,R4
       S    R8,R7
       JNE  TSH3
       LI   R4,TILAYR          the layer's registers
TSH5   MOV  *R4+,R0
       JEQ  TSH9
       BL   @VDPWR
       JMP  TSH5
TSH9   .leave
       RT
TILAYR DATA >A080,>A100,>A208,>A300,>A460,>9FD8,0

* TISTAT - rows 13 and 14: the fitting, and the keys.
TISTAT .enter
       LI   R0,13
       BL   @WCLR
       LI   R0,13
       LI   R1,1
       BL   @TXAT
       MOV  @TIMODE,R0
       JNE  TST1
       LI   R1,QTPCR           Crop: rows N to N+95 of the 192.
       CLR  R2
       BL   @TXSTR
       MOV  @TIROW,R0
       CLR  R2
       BL   @TXDEC
       LI   R1,QTPTO
       CLR  R2
       BL   @TXSTR
       MOV  @TIROW,R0
       AI   R0,95
       CLR  R2
       BL   @TXDEC
       LI   R1,QTPOF
       JMP  TST2
TST1   LI   R1,QTPSQ
TST2   CLR  R2
       BL   @TXSTR
       LI   R0,14
       BL   @WCLR
       LI   R0,14
       LI   R1,1
       BL   @TXAT
       LI   R1,QTPKEY
       CLR  R2
       BL   @TXSTR
       .leave
       RT

* TIMSG - row 13: the message at R1.
TIMSG  .enter
       MOV  R1,R4
       LI   R0,13
       BL   @WCLR
       LI   R0,13
       LI   R1,1
       BL   @TXAT
       MOV  R4,R1
       CLR  R2
       BL   @TXSTR
       .leave
       RT

* TISAVE - NAME_T written: one record, "crop N" or "squeeze".
TISAVE .enter
       LI   R0,'T'
       BL   @TIFNAM
       LI   R0,>0012           a DV80 file for output
       MOV  R0,@DVFLG
       BL   @DVOPEN
       LI   R1,>0014
       MOV  R1,@DVFLG
       MOV  R0,R0
       JNE  TSV9
       LI   R4,TIBUF           the line
       MOV  @TIMODE,R0
       JEQ  TSV1
       LI   R1,QTSQZ
       JMP  TSV3
TSV1   LI   R1,QTCROP          "crop " and the row
TSV3   MOVB *R1+,R2
       SRL  R2,8
TSV4   MOVB *R1+,*R4+
       DEC  R2
       JNE  TSV4
       MOV  @TIMODE,R0
       JNE  TSV6
       MOV  @TIROW,R3
       CLR  R2
       DIV  @D10TI,R2          R2 tens, R3 ones
       MOV  R2,R2
       JEQ  TSV5
       AI   R2,'0'
       SWPB R2
       MOVB R2,*R4+
TSV5   AI   R3,'0'
       SWPB R3
       MOVB R3,*R4+
TSV6   MOV  R4,R5              its length
       AI   R5,-TIBUF
       LI   R0,FBUF
       LI   R1,TIBUF
       MOV  R5,R2
       BL   @VMBW
       LI   R0,PABADR+5        the character count
       MOV  R5,R1
       SWPB R1
       BL   @VSBW
       LI   R0,PABADR          opcode 3: WRITE (the file is open: no power-up)
       LI   R1,>0300
       BL   @VSBW
       SETO @DSRKEEP
       BL   @DVCALL
       BL   @DVCLOS
TSV9   .leave
       RT

* TICONV - the record from the staged picture: TILEN bytes at OUTPG.
TICONV .enter
       LI   R0,96              the fitted pixels into RAWPG
       MOV  R0,@TINROW
       LI   R0,RAWPG
       MOV  R0,@TIFPG
       BL   @TIFIT
       B    @TAC9
* TIFIT - TINROW rows of the fitting (TIMODE, TIROW), 64 bytes each, from
* page TIFPG on.  (TICONV: 96 into RAWPG; the preview: all 192, crop.)
TIFIT  .enter
       CLR  @TIRI
       CLR  @TIY
TAC1   CLR  @TIX
TAC2    MOV  @TIX,R8            the byte's two fat pixels: 2x and 2x+1
       SLA  R8,1
       BL   @TIFAT
       MOV  R6,R9
       SLA  R9,4
       INC  R8
       BL   @TIFAT
       SOC  R6,R9
       MOV  @TIRI,R1           the byte into its page
       MOV  R1,R0
       SRL  R0,12
       A    @TIFPG,R0
       BL   @EMAP
       ANDI R1,>0FFF
       SWPB R9
       MOVB R9,@>E000(R1)
       INC  @TIRI
       INC  @TIX
       MOV  @TIX,R0
       CI   R0,64
       JHE   $+6
       B    @TAC2
       INC  @TIY
       MOV  @TIY,R0
       C    R0,@TINROW
       JHE  $+6
       B    @TAC1
       .leave
       RT
TAC9   CLR  @TIOI              the record: its head, then the packed pixels
       SETO @TIOPG
       LI   R0,4
       BL   @TIOUT
       LI   R0,16
       BL   @TIOUT
       LI   R4,TIPAL
TAC3    MOVB *R4+,R0
       SRL  R0,8
       BL   @TIOUT
       CI   R4,TIPALX
       JHE   $+6
       B    @TAC3
       BL   @TIPACK
       MOV  @TIOI,@TILEN
       SETO @XFPG              (window F was the record's: the tree reader maps
       .leave                  its own again)
       RT

* TIFAT - R6 = fat pixel R8 (0-127) of row TIY, as TIMODE fits it.
* Uses R0-R7.
TIFAT  MOV  R11,@TIFRET
       MOV  @TIMODE,R0
       JNE  TAF2
       MOV  @TIY,R4            crop: row TIROW + y, pixels 2x and 2x+1
       A    @TIROW,R4
       MOV  R8,R5
       SLA  R5,1
       BL   @TIPX
       MOV  R0,R6
       INC  R5
       BL   @TIPX
       MOV  R0,R7
       BL   @TIPICK
       MOV  @TIFRET,R11
       RT
TAF2    MOV  @TIY,R4            squeeze: rows 2y and 2y+1, each column first
       SLA  R4,1
       MOV  R8,R5
       SLA  R5,1
       BL   @TIPX              the left column: down, then picked
       MOV  R0,R6
       INC  R4
       BL   @TIPX
       MOV  R0,R7
       BL   @TIPICK
       MOV  R6,@TIFLFT
       INC  R5                 the right column
       BL   @TIPX
       MOV  R0,R7
       DEC  R4
       BL   @TIPX
       MOV  R0,R6
       BL   @TIPICK            (the top first: rows 2y then 2y+1)
       MOV  R6,R7
       MOV  @TIFLFT,R6
       BL   @TIPICK            left, then right
       MOV  @TIFRET,R11
       RT

* TIPICK - R6 := the first of R6, R7, unless it is background (0, 1) and
* R7 is not.
TIPICK CI   R6,1
       JH   TIPK9
       CI   R7,1
       JLE  TIPK9
       MOV  R7,R6
TIPK9  RT

* TIPX - R0 = the colour of pixel (row R4, column R5).  Uses R0-R3.
TIPX   MOV  R11,@TIXRET
       MOV  R4,R1              the offset: (row / 8 x 32 + column / 8) x 8
       SRL  R1,3               + row mod 8; doubled (interleaved)
       SLA  R1,5
       MOV  R5,R2
       SRL  R2,3
       A    R2,R1
       SLA  R1,3
       MOV  R4,R2
       ANDI R2,7
       A    R2,R1
       SLA  R1,1
       MOV  R1,R0              its page into window D
       SRL  R0,12
       AI   R0,TIPG
       BL   @DMAP
       ANDI R1,>0FFF
       MOVB @>D000(R1),R2      the pattern byte
       MOVB @>D001(R1),R3      the colour byte
       MOV  R5,R1              the bit: >80 >> column mod 8 (R1: R0 cannot
       ANDI R1,7               index)
       CLR  R0                 (COC tests every bit of R0: the low byte clear)
       MOVB @TIBITS(R1),R0
       COC  R0,R2
       JEQ  TIPX1
       MOV  R3,R0              background: the low nybble
       SRL  R0,8
       ANDI R0,15
       MOV  @TIXRET,R11
       RT
TIPX1  MOV  R3,R0              foreground: the high nybble
       SRL  R0,12
       MOV  @TIXRET,R11
       RT

* TIOUT - byte R0 (low) onto the record (window F, from OUTPG).  Uses
* R0-R3.
TIOUT  MOV  R11,@TIORET
       MOV  @TIOI,R1
       MOV  R1,R2
       SRL  R2,12
       AI   R2,OUTPG
       C    R2,@TIOPG
       JEQ  TAIO1
       MOV  R2,@TIOPG          (MAPPG uses R0-R3: the byte and place kept)
       MOV  R0,@TIOBYT
       MOV  R1,@TIOTMP
       MOV  R2,R0
       LI   R1,>F
       BL   @MAPPG
       MOV  @TIOTMP,R1
       MOV  @TIOBYT,R0
TAIO1   ANDI R1,>0FFF
       SWPB R0
       MOVB R0,@>F000(R1)
       INC  @TIOI
       MOV  @TIORET,R11
       RT

* TIRAWB - R0 = raw byte R1 (0-6143).  Uses R0, R1.
TIRAWB MOV  R11,@TIRRET
       MOV  R1,R0
       SRL  R0,12
       AI   R0,RAWPG
       BL   @EMAP
       ANDI R1,>0FFF
       MOVB @>E000(R1),R0
       SRL  R0,8
       MOV  @TIRRET,R11
       RT

* TIPACK - the raw 6144 bytes packed onto the record, as rlepack.pack
* does: a run of three or more equal bytes (at most 129) a repeat (n +
* >7D, the byte), the rest gathered into literal runs (at most 128: n - 1,
* the bytes); >FF ends.
TIPACK MOV  R11,@TIPRET
       CLR  @TILC
       CLR  R7                 i
TAP1    CI   R7,6144
       JHE  TAP9
       MOV  R7,R1              the run at i: R8 = j
       BL   @TIRAWB
       MOV  R0,R6              (its byte)
       MOV  R7,R8
TAP2    CI   R8,6144
       JHE  TAP3
       MOV  R8,R0
       S    R7,R0
       CI   R0,129
       JHE  TAP3
       MOV  R8,R1
       BL   @TIRAWB
       C    R0,R6
       JNE  TAP3
       INC  R8
       JMP  TAP2
TAP3    MOV  R8,R0
       S    R7,R0
       CI   R0,3
       JL   TAP4
       BL   @TIFLSH            a repeat
       MOV  R8,R0
       S    R7,R0
       AI   R0,>7D
       BL   @TIOUT
       MOV  R6,R0
       BL   @TIOUT
       MOV  R8,R7
       B    @TAP1
TAP4    MOV  @TILC,R0           a literal byte
       JNE  TAP5
       MOV  R7,@TILS
TAP5    INC  @TILC
       INC  R7
       B    @TAP1
TAP9    BL   @TIFLSH
       LI   R0,>FF
       BL   @TIOUT
       MOV  @TIPRET,R11
       RT
* TIFLSH - the literal run (TILS, TILC) out, in pieces of at most 128.
* Keeps R6-R8.
TIFLSH MOV  R11,@TIFLRT
TAFL1   MOV  @TILC,R4
       JEQ  TAFL9
       CI   R4,128
       JLE  TAFL2
       LI   R4,128
TAFL2   S    R4,@TILC
       MOV  R4,R0
       DEC  R0
       BL   @TIOUT
TAFL3   MOV  @TILS,R1
       BL   @TIRAWB
       BL   @TIOUT
       INC  @TILS
       DEC  R4
       JNE  TAFL3
       JMP  TAFL1
TAFL9   MOV  @TIFLRT,R11
       RT

TIPAR  DATA 0
TISRET DATA 0
QTPLD  BYTE QTPLDX-QTPLD-1
       TEXT 'Loading the picture ...'
QTPLDX
QTPBAD BYTE QTPBADX-QTPBAD-1
       TEXT 'Could not load _P and _C (any key): '
QTPBADX
QTPCV  BYTE QTPCVX-QTPCV-1
       TEXT 'Converting it: about ten seconds ...'
QTPCVX
QTPCR  BYTE QTPCRX-QTPCR-1
       TEXT 'Crop: rows '
QTPCRX
QTPTO  BYTE QTPTOX-QTPTO-1
       TEXT ' to '
QTPTOX
QTPOF  BYTE QTPOFX-QTPOF-1
       TEXT ' of the 192.'
QTPOFX
QTPSQ  BYTE QTPSQX-QTPSQ-1
       TEXT 'Squeeze: the whole picture at half height.'
QTPSQX
QTPKEY BYTE QTPKEYX-QTPKEY-1
       TEXT 'FCTN E/X: move the band  S: crop or squeeze  ENTER: save NAME_T  FCTN 9: back'
QTPKEYX
QTCROP BYTE QTCROPX-QTCROP-1
       TEXT 'crop '
QTCROPX
QTSQZ  BYTE QTSQZX-QTSQZ-1
       TEXT 'squeeze'
QTSQZX
       EVEN
TIARET DATA 0
TIAPV  DATA 0
TIAWRT DATA 0
TIAWO  DATA 0
TIAWV  DATA 0
TIABRT DATA 0
TICRET DATA 0
TICTMP DATA 0
TIWRET DATA 0
TIPROG BYTE 8
       TEXT 'Picture '
QTIMIS BYTE 9
       TEXT 'Picture: '
QTIMS2 BYTE 25
       TEXT ' has no _P and _C files. '
QTIDOT BYTE '.'
       EVEN
TIBUF  BSS  16
D10TI  DATA 10
TIFRET DATA 0
TIFLFT DATA 0
TIXRET DATA 0
TIORET DATA 0
TIOTMP DATA 0
TIOBYT DATA 0
TIRRET DATA 0
TIPRET DATA 0
TIFLRT DATA 0
TIBITS BYTE >80,>40,>20,>10,>08,>04,>02,>01
* the TI's 16 colours, 12-bit RGB, big-endian (tiartist.TI_PALETTE)
TIPAL  DATA >0000,>0000,>02C3,>05D6,>054F,>076F,>0D54,>04EF
       DATA >0F54,>0F76,>0DC5,>0ED8,>02B3,>0C5B,>0CCC,>0FFF
TIPALX
