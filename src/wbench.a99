*======================================================================
* wbench.a99 - the TXA Workbench (M5): the native compiler's cartridge.
*
* Part 1, the skeleton: on the engine's kernel (80 columns, SAMS, disk),
* it asks for a source file and reads it, DIS/VAR 80 as Press 2.0 and
* TI-Writer write it, record by record into SAMS from page SRCPG, each
* record followed by a line feed.  The compiler's stages (lexer, parser,
* meaning, code, linking) come in the following parts.
*
* Memory (M5 part 4): the resident part, >A000->AFFF, holds the front end
* and what every stage shares; each stage is an overlay that runs at
* >B000->CFFF from two SAMS pages of its own (OVSEL maps them in).  The
* overlays are assembled at their run address with XORG, staged in the
* image at >4000 (not RAM here), and the cartridge loader copies each
* into its pages (tools/build.py, workbench_cart).  Overlay n uses pages
* OVPG+2(n-1) and OVPG+2(n-1)+1:
*   1  the lexer (wlex.a99)
*   2  the parser (wparse.a99)
*   3  the meaning stage, first half (wsema.a99; wsym.a99, resident, shared)
*   4  the meaning stage, second half (wsema2.a99)
* SAMS windows: >D000, >E000, >F000 are the stages' data windows.
* SAMS pages (512K, the least the workbench needs):
*   16-31   the overlays (two pages each)
*   32-47   a file's source text (SRCPG), while it is lexed
*   48-63   its tokens (TOKPG), while they are parsed
*   64-111  the trees, every file's after the last (TREEPG)
*   112-    the meaning stage's tables (DXPG: the declaration index first)
*======================================================================
       COPY "macros.a99"
       COPY "defs.a99"
       COPY "wsymdef.a99"

* The workbench's own variables, in RAM the engine uses only for UNDO's
* record index (URECS): the two never run together.  (defs.a99, shared
* with the engine, is checked for overlaps by build.py; these are not in it.)
SRCPG  EQU  32                 SAMS page where loaded source text starts
WBLNS  EQU  URECS+>00          lines read
WBLENL EQU  URECS+>02          bytes read (low word) ...
WBLENH EQU  URECS+>04          ... and high word
WBPAGE EQU  URECS+>06          the page being filled
WBOFF  EQU  URECS+>08          the next byte in it (0-4095)
WBDONE EQU  URECS+>0A          1 once a file has been read, -1 if it would not open
WBNLEN EQU  URECS+>0C          the name being typed: its length
WBRET  EQU  URECS+>0E          a saved return
WBRET2 EQU  URECS+>10          another
WBNAME EQU  URECS+>20          28 bytes: the name being typed
* the lexer (wlex.a99)
TOKPG  EQU  48                 SAMS page where the token stream starts
SRTOT  EQU  WBLENL             the text's length (low, high)
SRTOTH EQU  WBLENH
SRPAGE EQU  URECS+>40          the source page in window E
SROFF  EQU  URECS+>42          the next byte in it
SRDONE EQU  URECS+>44          bytes of text read (low, high)
SRDONH EQU  URECS+>46
LINENO EQU  URECS+>48          the line being lexed
TKPAGE EQU  URECS+>4A          the token page in window F
TKOFF  EQU  URECS+>4C          the next byte in it
LXTCNT  EQU  URECS+>4E          tokens written
LXHOK  EQU  URECS+>50          hex allowed next (an operand may start)
LXLTOK EQU  URECS+>52          tokens on this logical line
LXNUM  EQU  URECS+>54          a number's value
LXTMP  EQU  URECS+>56
LXTMP2 EQU  URECS+>58
LXRET  EQU  URECS+>5A
LXRET2 EQU  URECS+>5C
LXSTRL EQU  URECS+>5E          the line a string starts on
LXPOS  EQU  URECS+>60
WBERR  EQU  URECS+>62          an error's code (0: none)
WBERRL EQU  URECS+>64          its line
WBERRC EQU  URECS+>66          the unexpected character (high byte)
LXSV2  EQU  URECS+>68          R2 and R3 kept across MAPPG
LXSV3  EQU  URECS+>6A
WKLST  EQU  URECS+>6C          the key last reported (WKEY)
KWNUM  EQU  URECS+>6E          KWIN: the entry being compared
WBTREE EQU  URECS+>70          the tree's length
* the resident part (from GLOBRM: the engine's globals, unused here)
OVPG   EQU  16                 the first overlay's first SAMS page
OVCUR  EQU  GLOBRM+>00         the overlay mapped in (0: none)
OVRET  EQU  GLOBRM+>02
OVTMP  EQU  GLOBRM+>04
LINBUF EQU  >3300              256 bytes: the line being lexed (the font's
STRBUF EQU  >3400              1K: a token's text   / space, after startup)

       AORG >A000
WSTART LIMI 0
       LWPI WS
       LI   R10,STACKT
       LI   R1,RAMVAR          the variables cleared
       LI   R2,>700/2
WS1    CLR  *R1+
       DEC  R2
       JNE  WS1
       BL   @F18UNL
       BL   @F18DET
       BL   @AMSDET
       MOV  R0,R0
       JEQ  WS2
       BL   @AMSINI
WS2    LI   R0,30              80 columns, 30 rows, the font, colours
       MOV  R0,@ROWS
       BL   @T80ON
       BL   @TXCLS
       BL   @FONTLD
       LI   R0,ATRTAB
       LI   R1,ATNORM*256
       LI   R2,30*COLS
       BL   @VFILL
       LI   R0,>B202           position attributes (VR50)
       BL   @VDPWR
       LI   R0,14
       LI   R1,WBPAL
       LI   R2,2
       BL   @F18PAL
       LI   R0,SPRPAT          sprites off
       CLR  R1
       LI   R2,>800
       BL   @VFILL
       LI   R0,SPRATT
       LI   R1,>D000
       LI   R2,128
       BL   @VFILL
       LI   R0,ATRTAB          the title bar, in reverse
       LI   R1,ATREV*256
       LI   R2,COLS
       BL   @VFILL
       CLR  R0
       LI   R1,1
       BL   @TXAT
       LI   R1,STITLE
       CLR  R2
       BL   @TXSTR

* ---- the prompt -------------------------------------------------------------
WPROMP LI   R1,SDEFLT          the default name
       LI   R2,WBNAME
       MOVB *R1+,R0
       SRL  R0,8
       MOV  R0,@WBNLEN
WP1    MOVB *R1+,*R2+
       DEC  R0
       JNE  WP1
       SETO R9                 (the first key typed replaces the default)
WP2    LI   R0,2               draw "Source file: " and the name
       BL   @WCLR
       LI   R0,2
       LI   R1,1
       BL   @TXAT
       LI   R1,SASK
       CLR  R2
       BL   @TXSTR
       LI   R0,2*COLS+14
       LI   R1,WBNAME
       MOV  @WBNLEN,R2
       JEQ  WP3
       BL   @VMBW
WP3    BL   @WKEY              a key
       CI   R0,13
       JEQ  WLOAD
       CI   R0,8
       JNE  WP4
       MOV  @WBNLEN,R0         rub out
       JEQ  WP2
       DEC  @WBNLEN
       CLR  R9
       JMP  WP2
WP4    CI   R0,' '
       JLE  WP3
       CI   R0,'a'             upper case, as TI file names are
       JL   WP5
       CI   R0,'z'
       JH   WP5
       AI   R0,-32
WP5    MOV  R9,R9
       JEQ  WP6
       CLR  @WBNLEN
       CLR  R9
WP6    MOV  @WBNLEN,R1
       CI   R1,26
       JHE  WP2
       SWPB R0
       MOVB R0,@WBNAME(R1)
       INC  @WBNLEN
       JMP  WP2

* ---- compiling ---------------------------------------------------------------------
* WLOAD - the program named at the prompt: its first file read, lexed and
* parsed (LOADF), then (unless WBONLY) the declaration index (WALK),
* which loads each INCLUDEd file where it stands.
WLOAD  MOV  @WBNLEN,R0         FNBUF = the name, with its length byte
       JEQ  WP2
       SWPB R0
       MOVB R0,@FNBUF
       SWPB R0
       LI   R1,WBNAME
       LI   R2,FNBUF+1
WL1    MOVB *R1+,*R2+
       DEC  R0
       JNE  WL1
       LI   R0,4
       BL   @WCLR
       CLR  @NF
       CLR  @DXN
       CLR  @WBLTOT
       CLR  @WBERR
       CLR  @WBSTAG
       CLR  @XFPG
       CLR  @DFPG
       LI   R0,TREEPG
       MOV  R0,@TRNPG
       CLR  @TRNOF
       BL   @LOADF
       MOV  R0,R0
       JEQ  WL2
       JGT  WL3
       SETO @WBDONE            it would not open: say so, ask again
       LI   R0,4
       LI   R1,1
       BL   @TXAT
       LI   R1,SNOPEN
       CLR  R2
       BL   @TXSTR
       B    @WP2
WL3    MOV  @WBONLY,R0
       JEQ  WL3A
       B    @WL1E
WL3A   B    @WLERR
WL2    MOV  @WBONLY,R0         one file only: parts 1-3's results
       JEQ  WL2A
       B    @WL1F
WL2A   BL   @WALK              the declarations, every file
       MOV  R0,R0
       JEQ  WL2B
       B    @WLERR
WL2B   LI   R0,3               the meaning, first half (overlay 3)
       BL   @OVSEL
       BL   @SEMA1
       MOV  R0,R0
       JEQ  WL2C
       B    @WLERR
WL2C   LI   R0,4               the meaning, second half (overlay 4)
       BL   @OVSEL
       BL   @SEMA2
       MOV  R0,R0
       JEQ  WL4
       B    @WLERR
WL4    LI   R0,4               "Read n files, m lines."
       LI   R1,1
       BL   @TXAT
       LI   R1,SREAD1
       CLR  R2
       BL   @TXSTR
       MOV  @NF,R0
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,SFILES
       CLR  R2
       BL   @TXSTR
       MOV  @WBLTOT,R0
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,SLINES
       CLR  R2
       BL   @TXSTR
       LI   R0,6               "n declarations, m symbols, k objects."
       LI   R1,1
       BL   @TXAT
       MOV  @DXN,R0
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,SDECLS
       CLR  R2
       BL   @TXSTR
       MOV  @SN,R0
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,SSYMS
       CLR  R2
       BL   @TXSTR
       MOV  @ON,R0
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,SOBJS
       CLR  R2
       BL   @TXSTR
       LI   R0,4
       MOV  R0,@WBDONE         (4: every file loaded, the index made)
       B    @WL9
* WLERR - an error, with its stage, code, line and file.
WLERR  LI   R0,6
       LI   R1,1
       BL   @TXAT
       MOV  @WBSTAG,R1
       SLA  R1,1
       MOV  @STAGES-2(R1),R1
       CLR  R2
       BL   @TXSTR
       LI   R1,SERROR
       CLR  R2
       BL   @TXSTR
       MOV  @WBERR,R0
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,SLINE
       CLR  R2
       BL   @TXSTR
       MOV  @WBERRL,R0
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,SINF
       CLR  R2
       BL   @TXSTR
       MOV  @WBERRF,R0         the file's name
       MPY  @DFTSIZ,R0
       AI   R1,FTAB
       CLR  R2
       BL   @TXSTR
       B    @WL9

* One file only (WBONLY): the results as parts 1-3 gave them.
WL1E   MOV  @WBSTAG,R0         an error
       CI   R0,1
       JNE  WL1G
       LI   R0,6               the lexer's: its code and line
       LI   R1,1
       BL   @TXAT
       LI   R1,SLXERR
       JMP  WL1H
WL1G   BL   @WTOKS             the parser's: the tokens, then its code and line
       LI   R0,7
       LI   R1,1
       BL   @TXAT
       LI   R1,SPSERR
WL1H   CLR  R2
       BL   @TXSTR
       MOV  @WBERR,R0
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,SLINE
       CLR  R2
       BL   @TXSTR
       MOV  @WBERRL,R0
       CLR  R1
       CLR  R2
       BL   @TXDEC
       JMP  WL6A
WL1F   BL   @WTOKS
       LI   R0,7               "Parsed: n bytes of tree."
       LI   R1,1
       BL   @TXAT
       LI   R1,SPARSD
       CLR  R2
       BL   @TXSTR
       MOV  @TKPAGE,R0         (the tree's length: pages from TREEPG, offset)
       AI   R0,-TREEPG
       SLA  R0,12
       A    @TKOFF,R0
       MOV  R0,@WBTREE
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,STREE
       CLR  R2
       BL   @TXSTR
WL6A
       LI   R0,4               "Read n lines, m bytes."
       LI   R1,1
       BL   @TXAT
       LI   R1,SREAD1
       CLR  R2
       BL   @TXSTR
       MOV  @WBLNS,R0          (TXDEC: the number in R0, width R1, style R2)
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,SREAD2
       CLR  R2
       BL   @TXSTR
       MOV  @WBLENL,R0         (the low word: files up to 64K for now)
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,SREAD3
       CLR  R2
       BL   @TXSTR
WL9    LI   R0,8               then: say what a key does, wait for one,
       LI   R1,1               and clear the results for the next file
       BL   @TXAT
       LI   R1,SAGAIN
       CLR  R2
       BL   @TXSTR
       BL   @WKEY
       LI   R14,4
WL10   MOV  R14,R0
       BL   @WCLR
       INC  R14
       CI   R14,30
       JL   WL10
       B    @WPROMP
* WTOKS - row 6: "n tokens." (the last file's).
WTOKS  MOV  R11,@WBRET2
       LI   R0,6
       LI   R1,1
       BL   @TXAT
       MOV  @LXTCNT,R0
       CLR  R1
       CLR  R2
       BL   @TXDEC
       LI   R1,STOKS
       CLR  R2
       BL   @TXSTR
       MOV  @WBRET2,R11
       RT

* WPUT - the byte in R0's high byte into the source text.  Uses R0-R3, R12.
WPUT   MOV  R11,R13
       MOV  @WBOFF,R1
       MOVB R0,@>E000(R1)
       INC  @WBLENL
       JNC  WPU1
       INC  @WBLENH
WPU1   INC  R1
       CI   R1,4096
       JL   WPU2
       INC  @WBPAGE            the next page
       CLR  R1
       MOV  R1,@WBOFF
       BL   @WMAP
       B    *R13
WPU2   MOV  R1,@WBOFF
       B    *R13
* WMAP - window >E000 onto page WBPAGE.
WMAP   MOV  R11,R12
       MOV  R12,@WBRET
       MOV  @WBPAGE,R0
       LI   R1,>E
       BL   @MAPPG
       MOV  @WBRET,R11
       RT

* WKEY - R0 = the next key pressed, as a character code (ENTER 13, FCTN S
* the rub-out, 8).  Its own reading, as the engine's KEYGT2 does it: the
* modifiers (FCTN, SHIFT, CTRL in column 0) are set aside before the keys
* are scanned, so a modifier never hides the key pressed with it (the
* kernel's KEYGET stops at the first one).  Each press is reported once.
WKEY   MOV  R11,@WBRET2
WK1    BL   @KSCAN
       MOVB @KEYMAP,R5         column 0: the modifiers
       INV  R5
       ANDI R5,>7000           FCTN >1000, SHIFT >2000, CTRL >4000
       LI   R1,KEYMAP
       LI   R2,KTAB
       LI   R3,6
WK2    MOVB *R1+,R4
       INV  R4
       ANDI R4,>FF00
       CI   R3,6               column 0: = SPACE ENTER only
       JNE  WK3
       ANDI R4,>0700
WK3    MOV  R4,R4
       JNE  WK4
       AI   R2,8
       DEC  R3
       JNE  WK2
       CLR  @WKLST             nothing pressed: the next press is new
       JMP  WK1
WK4    SRL  R4,8               the first pressed row
       CLR  R0
WK5    SRL  R4,1
       JOC  WK6
       INC  R0
       JMP  WK5
WK6    A    R0,R2
       MOVB *R2,R0
       SRL  R0,8               the key's character (letters in capitals)
       JEQ  WK1
       MOV  R5,R1
       ANDI R1,>1000           FCTN S: the rub-out
       JEQ  WK7
       CI   R0,'S'
       JNE  WK1                (other FCTN keys: nothing, for now)
       LI   R0,8
WK7    C    R0,@WKLST          still the same press?
       JEQ  WK1
       MOV  R0,@WKLST
       MOV  @WBRET2,R11
       RT

* WCLR - row R0 blank, in normal colours.  Uses R0-R2.
WCLR   MOV  R11,@WBRET
       MPY  @D80W,R0           R1 = row * 80
       MOV  R1,R0
       MOV  R1,@WBRET2
       LI   R1,>2000
       LI   R2,COLS
       BL   @VFILL
       MOV  @WBRET2,R0
       AI   R0,ATRTAB
       LI   R1,ATNORM*256
       LI   R2,COLS
       BL   @VFILL
       MOV  @WBRET,R11
       RT
D80W   DATA 80

* ---- the token stream -------------------------------------------------------
* TPUT - R0's high byte onto the stream.  Uses R0, R1; keeps R2-R9.
TPUT   MOV  @TKOFF,R1
       MOVB R0,@>F000(R1)
       INC  R1
       CI   R1,4096
       JL   TPU1
       MOV  R11,@LXRET
       MOV  R2,@LXSV2          (MAPPG uses R2 and R3: TEMIT's text pointer
       MOV  R3,@LXSV3          and count must survive a page change)
       INC  @TKPAGE            the next token page
       CLR  @TKOFF
       MOV  @TKPAGE,R0
       LI   R1,>F
       BL   @MAPPG
       MOV  @LXSV2,R2
       MOV  @LXSV3,R3
       MOV  @LXRET,R11
       RT
TPU1   MOV  R1,@TKOFF
       RT
* TPUTW - R0 as a word, high byte first.
TPUTW  MOV  R11,@LXRET2
       MOV  R0,@LXTMP2
       BL   @TPUT
       MOV  @LXTMP2,R0
       SWPB R0
       BL   @TPUT
       MOV  @LXRET2,R11
       RT

* OVSEL - overlay R0 (1, 2 ...) into >B000->CFFF: map its two SAMS
* pages, unless it is the one there already.  Uses R0-R3, R12.
OVSEL  C    R0,@OVCUR
       JEQ  OVS9
       MOV  R0,@OVCUR
       MOV  R11,@OVRET
       SLA  R0,1
       AI   R0,OVPG-2
       MOV  R0,@OVTMP
       LI   R1,>B
       BL   @MAPPG
       MOV  @OVTMP,R0
       INC  R0
       LI   R1,>C
       BL   @MAPPG
       MOV  @OVRET,R11
OVS9   RT

* DSKFIX - nothing to repair after a disk call (no fast block here).
DSKFIX RT

WBPAL  DATA >0AAA,>0FFF        palette 14 (soft gray), 15 (white)
STITLE BYTE STITLX-STITLE-1
       TEXT 'TXA Workbench'
STITLX
SDEFLT BYTE SDEFLX-SDEFLT-1
       TEXT 'DSK1.LAMPLIGHT'
SDEFLX
SASK   BYTE SASKX-SASK-1
       TEXT 'Source file: '
SASKX
SNOPEN BYTE SNOPNX-SNOPEN-1
       TEXT 'Cannot open that file.'
SNOPNX
SREAD1 BYTE SREA1X-SREAD1-1
       TEXT 'Read '
SREA1X
SREAD2 BYTE SREA2X-SREAD2-1
       TEXT ' lines, '
SREA2X
SREAD3 BYTE SREA3X-SREAD3-1
       TEXT ' bytes.'
SREA3X
STOKS  BYTE STOKSX-STOKS-1
       TEXT ' tokens.'
STOKSX
SLXERR BYTE SLXERX-SLXERR-1
       TEXT 'Lexer error '
SLXERX
SAGAIN BYTE SAGAIX-SAGAIN-1
       TEXT 'Press a key to choose another file.'
SAGAIX
SPSERR BYTE SPSERX-SPSERR-1
       TEXT 'Parse error '
SPSERX
SPARSD BYTE SPARSX-SPARSD-1
       TEXT 'Parsed: '
SPARSX
STREE  BYTE STREEX-STREE-1
       TEXT ' bytes of tree.'
STREEX
SLINE  BYTE SLINEX-SLINE-1
       TEXT ' at line '
SLINEX
SFILES BYTE SFILEX-SFILES-1
       TEXT ' files, '
SFILEX
SLINES BYTE SLINSX-SLINES-1
       TEXT ' lines.'
SLINSX
SDECLS BYTE SDECLX-SDECLS-1
       TEXT ' declarations, '
SDECLX
SSYMS  BYTE SSYMSX-SSYMS-1
       TEXT ' symbols, '
SSYMSX
SOBJS  BYTE SOBJSX-SOBJS-1
       TEXT ' objects.'
SOBJSX
SERROR BYTE SERRX-SERROR-1
       TEXT ' error '
SERRX
SINF   BYTE SINFX-SINF-1
       TEXT ' in '
SINFX
       EVEN
STAGES DATA SSTLEX,SSTPAR,SSTLOD,SSTMNG
SSTLEX BYTE 5
       TEXT 'Lexer'
SSTPAR BYTE 5
       TEXT 'Parse'
SSTLOD BYTE 4
       TEXT 'Load'
SSTMNG BYTE 7
       TEXT 'Meaning'
       EVEN
       COPY "wload.a99"
WBEND
* ---- the overlays: each runs at >B000 (XORG), staged from >4000 ----------
       AORG >4000
       XORG >B000
       COPY "wlex.a99"
OV1END
       XORG >B000
       COPY "wparse.a99"
OV2END
       XORG >B000
       COPY "wsema.a99"
OV3END
       XORG >B000
       COPY "wsema2.a99"
OV4END

       AORG >2000
WENTRY B    @WSTART
       COPY "vdp.a99"
       COPY "f18a.a99"
       COPY "pager.a99"
       COPY "keys.a99"
       COPY "text80.a99"
       COPY "disk.a99"
       COPY "diskrec.a99"
       COPY "wsym.a99"
WKEND
       AORG >3000
       COPY "gen/font.a99"
       END  WSTART
