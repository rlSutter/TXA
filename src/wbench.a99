*======================================================================
* wbench.a99 - the TXA Workbench (M5): the native compiler's cartridge.
*
* Part 1, the skeleton: on the engine's kernel (80 columns, SAMS, disk),
* it asks for a source file and reads it, DIS/VAR 80 as Press 2.0 and
* TI-Writer write it, record by record into SAMS from page SRCPG, each
* record followed by a line feed.  The compiler's stages (lexer, parser,
* meaning, code, linking) come in the following parts.
*
* Memory (M5 part 4; M6): the resident part, >A000->AFFF, holds the front
* end and what every stage shares; each stage is an overlay that runs at
* >B000->CFFF.  The overlays are assembled at their run address with
* XORG and staged at >4000 (not RAM here); tools/build.py
* (workbench_cart) puts overlay n in cartridge bank n, and OVSEL copies it
* to >B000 when a stage needs it (M6: until then each had two SAMS pages,
* copied there by the cartridge loader; RAM and those pages were full).  Overlays 5 on are
* assembled apart (wovl.a99), with this file's symbols, and staged from
* >0000 in their own image; the resident part enters them at OVENT
* (>B000), where each begins with a branch to its entry.  Overlay n uses
*   1  the lexer (wlex.a99)
*   2  the parser (wparse.a99)
*   3  the meaning stage, first half (wsema.a99; wsym.a99, resident, shared)
*   4  the meaning stage, second half (wsema2.a99)
*   5  the code generator (wcode.a99)
*   6  the linker, first half (wlink.a99): substitutions, the first tables
*   7  the linker, second half (wlink2.a99): the rest, the story files
*   8  the front end (wfront.a99): the main menu, the project's settings
* SAMS windows: >D000, >E000, >F000 are the stages' data windows.
* SAMS pages (512K, the least the workbench needs):
*   16-31   free (the overlays' until M6; they live in the cartridge now)
*   32-47   a file's source text (SRCPG), while it is lexed
*   48-63   its tokens (TOKPG), while they are parsed
*   64-111  the trees, every file's after the last (TREEPG)
*   112-    the meaning stage's tables (DXPG: the declaration index first)
*======================================================================
       COPY "macros.a99"
       COPY "defs.a99"
       COPY "wsymdef.a99"
       COPY "gen/opcodes.a99"

* The workbench's own variables, in RAM the engine uses only for UNDO's
* record index (URECS): the two never run together.  (defs.a99, shared
* with the engine, is checked for overlaps by build.py; these are not in it.)
SRCPG  EQU  32                 SAMS page where loaded source text starts
WBLNS  EQU  URECS+>00          lines read
WBLENL EQU  URECS+>02          bytes read (low word) ...
WBLENH EQU  URECS+>04          ... and high word
WBPAGE EQU  URECS+>06          the page being filled
WBOFF  EQU  URECS+>08          the next byte in it (0-4095)
WBDONE EQU  URECS+>0A          1 once a file has been read, -1 if it would not open
WBNLEN EQU  URECS+>0C          the name being typed: its length
WBRET  EQU  URECS+>0E          a saved return
WBRET2 EQU  URECS+>10          another
WBNAME EQU  URECS+>20          28 bytes: the name being typed
* the lexer (wlex.a99)
TOKPG  EQU  48                 SAMS page where the token stream starts
SRTOT  EQU  WBLENL             the text's length (low, high)
SRTOTH EQU  WBLENH
SRPAGE EQU  URECS+>40          the source page in window E
SROFF  EQU  URECS+>42          the next byte in it
SRDONE EQU  URECS+>44          bytes of text read (low, high)
SRDONH EQU  URECS+>46
LINENO EQU  URECS+>48          the line being lexed
TKPAGE EQU  URECS+>4A          the token page in window F
TKOFF  EQU  URECS+>4C          the next byte in it
LXTCNT  EQU  URECS+>4E          tokens written
LXHOK  EQU  URECS+>50          hex allowed next (an operand may start)
LXLTOK EQU  URECS+>52          tokens on this logical line
LXNUM  EQU  URECS+>54          a number's value
LXTMP  EQU  URECS+>56
LXTMP2 EQU  URECS+>58
LXRET  EQU  URECS+>5A
LXRET2 EQU  URECS+>5C
LXSTRL EQU  URECS+>5E          the line a string starts on
LXPOS  EQU  URECS+>60
WBERR  EQU  URECS+>62          an error's code (0: none)
WBERRL EQU  URECS+>64          its line
WBERRC EQU  URECS+>66          the unexpected character (high byte)
LXSV2  EQU  URECS+>68          R2 and R3 kept across MAPPG
LXSV3  EQU  URECS+>6A
WKLST  EQU  URECS+>6C          the key last reported (WKEY)
KWNUM  EQU  URECS+>6E          KWIN: the entry being compared
WBTREE EQU  URECS+>70          the tree's length
* the resident part (from GLOBRM: the engine's globals, unused here)
OVENT  EQU  >B000              overlays 5 on: their entry is their first word
OVCUR  EQU  GLOBRM+>00         the overlay mapped in (0: none)
LINBUF EQU  >3300              256 bytes: the line being lexed (the font's
STRBUF EQU  >3400              1K: a token's text   / space, after startup)

       AORG >A000
WSTART LIMI 0
       LWPI WS
       LI   R10,STACKT
       LI   R1,RAMVAR          the variables cleared
       LI   R2,>700/2
WS1    CLR  *R1+
       DEC  R2
       JNE  WS1
       BL   @F18UNL
       BL   @F18DET
       BL   @AMSDET
       MOV  R0,R0
       JEQ  WS2
       BL   @AMSINI
WS2    LI   R0,30              80 columns, 30 rows, the font, colours
       MOV  R0,@ROWS
       BL   @T80ON
       BL   @TXCLS
       BL   @FONTLD
       LI   R0,ATRTAB
       LI   R1,ATNORM*256
       LI   R2,30*COLS
       BL   @VFILL
       LI   R0,>B202           position attributes (VR50)
       BL   @VDPWR
       LI   R0,14
       LI   R1,WBPAL
       LI   R2,2
       BL   @F18PAL
       LI   R0,SPRPAT          sprites off
       CLR  R1
       LI   R2,>800
       BL   @VFILL
       LI   R0,SPRATT
       LI   R1,>D000
       LI   R2,128
       BL   @VFILL
       LI   R0,ATRTAB          the title bar, in reverse
       LI   R1,ATREV*256
       LI   R2,COLS
       BL   @VFILL
       CLR  R0
       LI   R1,1
       BL   @TXAT
       LI   R1,STITLE
       CLR  R2
       BL   @TXSTR

       LI   R0,>0014           DVOPEN: DV80 input (the engine writes too)
       MOV  R0,@DVFLG
       LI   R1,SDEFLT          the default source file
       LI   R2,WBNAME
       MOVB *R1+,R0
       SRL  R0,8
       MOV  R0,@WBNLEN
WS3    MOVB *R1+,*R2+
       DEC  R0
       JNE  WS3
* MENUGO - the main menu (overlay 8): at start-up, and after each compile.
MENUGO LI   R0,8
* OVGO - overlay R0, entered at OVENT (an overlay passing control to another
* branches here: OVSEL overwrites the caller).
OVGO   BL   @OVSEL
       B    @OVENT
* OVGO4 - the same, entered at OVENT+4 (an overlay's second entry).
OVGO4  BL   @OVSEL
       B    @OVENT+4

* ---- an error's fields (M6 part 6): what its message names, in VRAM at
* EFN1 .. (below the PAB; nothing else uses it), for overlay 11 ---------------
* EFSET - field R0 (EFN1, EFN2) := the string at R1 (a length byte first,
* at most 39).  EFNUM - field R0 (EFA, EFB, EFF, EFL) := R1.  Use R0-R2.
EFSET  MOVB *R1,R2
       SRL  R2,8
       CI   R2,39
       JLE  EFS1
       LI   R2,39
EFS1   INC  R2
       B    @VMBW
* EFNAMB - field R0 := the name being looked up, as written (NAMB, KEYL
* long).  Uses R0; keeps R1-R3.
EFNAMB MOV  R11,@EFRET
       MOV  R1,@EFSAV          (R1-R3 kept: an error site may have set its
       MOV  R2,@EFSAV+2        line, file or declaration already)
       MOV  R3,@EFSAV+4
       MOV  R0,R3
       MOV  @KEYL,R2
       CI   R2,39
       JLE  EFB1
       LI   R2,39
EFB1   SWPB R2
       MOVB R2,@EFTMP
       LI   R1,EFTMP
       LI   R2,1
       BL   @VMBW
       MOV  R3,R0
       INC  R0
       LI   R1,NAMB
       MOV  @KEYL,R2
       CI   R2,39
       JLE  EFB2
       LI   R2,39
EFB2   MOV  R2,R2
       JEQ  EFB3
       BL   @VMBW
EFB3   MOV  @EFSAV,R1
       MOV  @EFSAV+2,R2
       MOV  @EFSAV+4,R3
       MOV  @EFRET,R11
       RT
* EFDWB - field EFN1 := the dictionary word last read (DWB, lower case,
* at most 12; DWB-1 takes its length).  Uses R0-R2.
EFDWB  MOV  @DWL,R2
       CI   R2,12
       JLE  EFW1
       LI   R2,12
EFW1   SWPB R2
       MOVB R2,@DWB-1
       LI   R0,EFN1
       LI   R1,DWB-1
       B    @EFSET
* DWERR - a bad dictionary word (DWORD, wsym.a99): its error, the word
* recorded for the message (here: the kernel window is full).
DWERR  BL   @EFDWB
       LI   R0,SE.DWD
       B    @SERRE
EFNUM  MOV  R1,@EFTMP
       LI   R1,EFTMP
       LI   R2,2
       B    @VMBW

* ---- compiling ---------------------------------------------------------------------
* WLOAD - the program named at the prompt: its first file read, lexed and
* parsed (LOADF), then (unless WBONLY) the declaration index (WALK),
* which loads each INCLUDEd file where it stands.
WLOAD  MOV  @WBNLEN,R0         FNBUF = the name, with its length byte
       JNE  $+6
       B    @MENUGO
       SWPB R0
       MOVB R0,@FNBUF
       SWPB R0
       LI   R1,WBNAME
       LI   R2,FNBUF+1
WL1    MOVB *R1+,*R2+
       DEC  R0
       JNE  WL1
       LI   R14,4              rows 4-9 cleared: the last results
WL1A   MOV  R14,R0
       BL   @WCLR
       INC  R14
       CI   R14,10
       JL   WL1A
       LI   R0,EFN1            no error's fields yet
       CLR  R1
       LI   R2,EFEND-EFN1
       BL   @VFILL
       CLR  @NF
       CLR  @DXN
       CLR  @WBLTOT
       CLR  @WBERR
       CLR  @WBSTAG
       CLR  @XFPG
       CLR  @DFPG
       LI   R0,TREEPG
       MOV  R0,@TRNPG
       CLR  @TRNOF
       BL   @LOADF
       MOV  R0,R0
       JEQ  WL2
       JGT  WL3
       BL   @PCLEAR
       SETO @WBDONE            it would not open: say so, ask again
       LI   R0,4
       LI   R1,1
       BL   @TXAT
       LI   R1,SNOPEN
       CLR  R2
       BL   @TXSTR
       B    @MENUGO
WL3    MOV  @WBONLY,R0
       JEQ  WL3A
       B    @WL1E
WL3A   B    @WLERR
WL2    MOV  @WBONLY,R0         one file only: parts 1-3's results
       JEQ  WL2A
       B    @WL1F
WL2A   BL   @WALK              the declarations, every file
       MOV  R0,R0
       JEQ  WL2B
       B    @WLERR
WL2B   LI   R0,3               the meaning, first half (overlay 3)
       BL   @OVSEL
       BL   @SEMA1
       MOV  R0,R0
       JEQ  WL2C
       B    @WLERR
WL2C   LI   R0,4               the meaning, second half (overlay 4)
       BL   @OVSEL
       BL   @SEMA2
       MOV  R0,R0
       JEQ  WL2D
       B    @WLERR
WL2D   LI   R0,5               the code (overlay 5)
       BL   @OVSEL
       BL   @OVENT
       MOV  R0,R0
       JEQ  WL2E
       B    @WLERR
WL2E   LI   R0,6               the linker, first half (overlay 6)
       BL   @OVSEL
       BL   @OVENT
       MOV  R0,R0
       JEQ  WL2F
       B    @WLERR
WL2F   LI   R0,7               the linker, second half, the files (overlay 7)
       BL   @OVSEL
       BL   @OVENT
       MOV  R0,R0
       JEQ  WL4
       B    @WLERR
* The results and errors (M6 optimization pass): drawn by overlay 11, which
* has room (entries: >B000 an error, >B004 the results, >B008 one file's
* error, >B00C one file's results).
WLERR  LI   R0,11
       B    @OVGO
WL4    LI   R0,11
       BL   @OVSEL
       B    @OVENT+4
WL1E   LI   R0,11
       BL   @OVSEL
       B    @OVENT+8
WL1F   LI   R0,11
       BL   @OVSEL
       B    @OVENT+12

WL9    MOV  @WBBLD,R1          a compile that worked, for B (1: the engine's
       JEQ  WL9A               files, overlay 9) or T (2: test-play, overlay
       CLR  @WBBLD             10's second entry)
       C    @WBDONE,@D4W
       JNE  WL9A
       LI   R0,9
       CI   R1,2
       JNE  WL9B
       LI   R0,10
       BL   @OVSEL
       B    @OVENT+4
WL9B   BL   @OVSEL
       B    @OVENT
WL9A   B    @MENUGO            the menu again (the results stay on rows 4-8)
D4W    DATA 4
* WPUT - the byte in R0's high byte into the source text.  Uses R0-R3, R12.
WPUT   MOV  R11,R13
       MOV  @WBOFF,R1
       MOVB R0,@>E000(R1)
       INC  @WBLENL
       JNC  WPU1
       INC  @WBLENH
WPU1   INC  R1
       CI   R1,4096
       JL   WPU2
       INC  @WBPAGE            the next page
       CLR  R1
       MOV  R1,@WBOFF
       BL   @WMAP
       B    *R13
WPU2   MOV  R1,@WBOFF
       B    *R13
* WMAP - window >E000 onto page WBPAGE.
WMAP   MOV  R11,R12
       MOV  R12,@WBRET
       MOV  @WBPAGE,R0
       LI   R1,>E
       BL   @MAPPG
       MOV  @WBRET,R11
       RT

* WKEY - R0 = the next key pressed, as a character code (ENTER 13, FCTN S
* the rub-out, 8).  Its own reading, as the engine's KEYGT2 does it: the
* modifiers (FCTN, SHIFT, CTRL in column 0) are set aside before the keys
* are scanned, so a modifier never hides the key pressed with it (the
* kernel's KEYGET stops at the first one).  Each press is reported once.
WKEY   MOV  R11,@WBRET2
WK1    BL   @KSCAN
       MOVB @KEYMAP,R5         column 0: the modifiers
       INV  R5
       ANDI R5,>7000           FCTN >1000, SHIFT >2000, CTRL >4000
       LI   R1,KEYMAP
       LI   R2,KTAB
       LI   R3,6
WK2    MOVB *R1+,R4
       INV  R4
       ANDI R4,>FF00
       CI   R3,6               column 0: = SPACE ENTER only
       JNE  WK3
       ANDI R4,>0700
WK3    MOV  R4,R4
       JNE  WK4
       AI   R2,8
       DEC  R3
       JNE  WK2
       CLR  @WKLST             nothing pressed: the next press is new
       JMP  WK1
WK4    SRL  R4,8               the first pressed row
       CLR  R0
WK5    SRL  R4,1
       JOC  WK6
       INC  R0
       JMP  WK5
WK6    A    R0,R2
       MOVB *R2,R0
       SRL  R0,8               the key's character (letters in capitals)
       JEQ  WK1
       MOV  R5,R1
       ANDI R1,>1000           FCTN S: the rub-out
       JEQ  WK7
       CI   R0,'S'
       JNE  WK1                (other FCTN keys: nothing, for now)
       LI   R0,8
WK7    C    R0,@WKLST          still the same press?
       JEQ  WK1
       MOV  R0,@WKLST
       MOV  @WBRET2,R11
       RT

* WCLR - row R0 blank, in normal colours.  Uses R0-R2.
WCLR   MOV  R11,@WBRET
       MPY  @D80W,R0           R1 = row * 80
       MOV  R1,R0
       MOV  R1,@WBRET2
       LI   R1,>2000
       LI   R2,COLS
       BL   @VFILL
       MOV  @WBRET2,R0
       AI   R0,ATRTAB
       LI   R1,ATNORM*256
       LI   R2,COLS
       BL   @VFILL
       MOV  @WBRET,R11
       RT
D80W   DATA 80

* ---- the token stream -------------------------------------------------------
* TPUT - R0's high byte onto the stream.  Uses R0, R1; keeps R2-R9.
TPUT   MOV  @TKOFF,R1
       MOVB R0,@>F000(R1)
       INC  R1
       CI   R1,4096
       JL   TPU1
       MOV  R11,@LXRET
       MOV  R2,@LXSV2          (MAPPG uses R2 and R3: TEMIT's text pointer
       MOV  R3,@LXSV3          and count must survive a page change)
       INC  @TKPAGE            the next token page
       CLR  @TKOFF
       MOV  @TKPAGE,R0
       LI   R1,>F
       BL   @MAPPG
       MOV  @LXSV2,R2
       MOV  @LXSV3,R3
       MOV  @LXRET,R11
       RT
TPU1   MOV  R1,@TKOFF
       RT
* TPUTW - R0 as a word, high byte first.
TPUTW  MOV  @TKOFF,R1           both bytes on this page: written here (the
       CI   R1,4093            optimization pass), R0 left swapped as below
       JH   TPW2
       MOVB R0,@>F000(R1)
       SWPB R0
       MOVB R0,@>F001(R1)
       INCT R1
       MOV  R1,@TKOFF
       RT
TPW2   MOV  R11,@LXRET2
       MOV  R0,@LXTMP2
       BL   @TPUT
       MOV  @LXTMP2,R0
       SWPB R0
       BL   @TPUT
       MOV  @LXRET2,R11
       RT

* OVSEL - overlay R0 (1, 2 ...) into >B000->CFFF, unless it is there
* already: its 8K copied from cartridge bank R0 (the workbench runs from
* RAM, so it can switch the cartridge's banks and read them directly).
* Uses R0-R3.
OVSEL  C    R0,@OVCUR
       JEQ  OVS9
       MOV  R0,@OVCUR
       SLA  R0,1               the bank: a write to >6000 + 2 x its number
       AI   R0,>6000
       CLR  *R0
       LI   R1,>6000
       LI   R2,>B000
       LI   R3,4096            (words)
OVS1   MOV  *R1+,*R2+
       DEC  R3
       JNE  OVS1
       CLR  @>6000             bank 0 again: a console reset keeps the bank
*                              selected, and only bank 0 has the header (else
*                              the workbench leaves the console's menu)
OVS9   RT

* DSKFIX - nothing to repair after a disk call (no fast block here).
DSKFIX RT

WBPAL  DATA >0AAA,>0FFF        palette 14 (soft gray), 15 (white)
STITLE BYTE STITLX-STITLE-1
       TEXT 'TXA Workbench'
STITLX
SDEFLT BYTE SDEFLX-SDEFLT-1
       TEXT 'DSK1.LAMPLIGHT'
SDEFLX
SNOPEN BYTE SNOPNX-SNOPEN-1
       TEXT 'Cannot open that file.'
SNOPNX
       EVEN
       EVEN
       COPY "wload.a99"
WBEND
* ---- the overlays: each runs at >B000 (XORG), staged from >4000 ----------
       AORG >4000
       XORG >B000
       COPY "wlex.a99"
OV1END
       XORG >B000
       COPY "wparse.a99"
OV2END
       XORG >B000
       COPY "wsema.a99"
OV3END
       XORG >B000
       COPY "wsema2.a99"
OV4END
* (overlays 5 on are assembled apart, in wovl.a99: these four already
* fill most of the >4000->9FFF staging room)

       AORG >2000
WENTRY B    @WSTART
       COPY "vdp.a99"
       COPY "f18a.a99"
       COPY "pager.a99"
       COPY "keys.a99"
       COPY "text80.a99"
       COPY "disk.a99"
       COPY "diskrec.a99"
       COPY "wsym.a99"
WKEND
       AORG >3000
       COPY "gen/font.a99"
       END  WSTART
