*======================================================================
* engine.a99 - the TXA engine: boot, load the story, run it.
*
* M1 form: the story image travels in the cartridge after the engine
* (tools/build.py puts it there and writes gen/storysrc.a99 saying
* where).  The engine copies it into SAMS from page STPAGE, checks the
* checksum against the header, keeps a pristine copy of the dynamic
* area for RESTART, and calls Main.  M4 loads the same image from disk
* files instead.
*
* Screen: 80 columns, 30 rows; the status line (row 0) shows the title;
* the text window is rows 1-29.  The picture pane comes in M4.
*======================================================================

START  LIMI 0
       LWPI WS
       LI   R10,STACKT
       LI   R1,RAMVAR          clear the variables (>3800->3EFF)
       LI   R2,>700/2
STR1   CLR  *R1+
       DEC  R2
       JNE  STR1
       BL   @F18UNL
       BL   @F18DET
       BL   @AMSDET
       MOV  R0,R0
       JEQ  STR2
       BL   @AMSINI
       BL   @AMSSIZ
STR2   MOV  @F18FLG,R0
       JNE  STR3
       B    @NOF18
STR3   LI   R0,30              the screen
       MOV  R0,@ROWS
       BL   @T80ON
       BL   @TXCLS
       BL   @FONTLD
       LI   R0,SPRPAT          sprites off for good (see probe.a99)
       CLR  R1
       LI   R2,>800
       BL   @VFILL
       LI   R0,SPRATT
       LI   R1,>D000
       LI   R2,128
       BL   @VFILL
       C    @AMSPGS,@D128
       JHE  STR4
       LI   R1,SNOSMS
       B    @FATAL
STR4   BL   @LOADST            the story into SAMS
       BL   @CHKST             header and checksum
       BL   @KEEPDY            the pristine dynamic area
       CLR  R0                 the status line: the title
       BL   @TXBAR
       CLR  R0
       LI   R1,1
       BL   @TXAT
       LI   R1,TITLEB
       LI   R2,>8000
       BL   @TXSTR
       LI   R0,1
       MOV  R0,@TXTTOP
       MOV  R0,@CROW
       CLR  @LLEN
       CLR  @MORECT
       LI   R0,1
       MOV  R0,@SEED

* VMRUN - start the story: empty stacks, call Main with no arguments.
* Main's frame returns to page -1, which RETV takes as the game's end.
VMRUN  LI   R6,VSTK
       LI   R0,FRAMES
       MOV  R0,@FREND
       MOV  R0,R7
       CLR  R8
       SETO @NEWSLF
       SETO @CURB
       SETO R5                 "return" page: the end
       CLR  R4
       MOV  @H.ENTR,R15
       CLR  R14
       B    @GOCALL

* LOADST - copy the story from the cartridge banks into SAMS: each 8K
* bank fills two pages, through windows A and B (>E000->FFFF).  The
* engine runs from RAM, so switching cartridge banks is safe here.
LOADST .enter
       MOV  @STLENH,R0         banks = (length + 8191) / 8192
       MOV  @STLENL,R1
       AI   R1,>1FFF
       JNC  LDS0
       INC  R0
LDS0   SRL  R1,13
       SLA  R0,3
       SOC  R0,R1
       MOV  R1,@VT1            banks to copy
       CLR  @VT2               bank index
LDS1   MOV  @VT2,R2            story pages 2k and 2k+1
       SLA  R2,1
       LI   R3,MAPRGA
       BL   @MAPWIN
       MOV  @VT2,R2
       SLA  R2,1
       INC  R2
       LI   R3,MAPRGB
       BL   @MAPWIN
       MOV  @VT2,R0            select the bank: write to >6000 + 2n
       A    @STBNK1,R0
       SLA  R0,1
       AI   R0,>6000
       CLR  *R0
       LI   R0,>6000
       LI   R1,WINA
       LI   R2,4096
LDS2   MOV  *R0+,*R1+
       DEC  R2
       JNE  LDS2
       CLR  @>6000             bank 0 again
       INC  @VT2
       C    @VT2,@VT1
       JL   LDS1
       SETO @CURB
       .leave
       RT

* CHKST - the header into HDRCPY, then check the magic and the
* checksum (all bytes after the header, mod 65536).
CHKST  .enter
       CLR  R1                 header: 32 words
       LI   R14,HDRCPY
CHK1   BL   @RDW
       MOV  R0,*R14+
       INCT R1
       CI   R1,64
       JL   CHK1
       LI   R0,>1000           the title's length byte for TXSTR (over
       MOVB R0,@TITLEB         the copy's last date byte, not used)
       C    @HDRCPY,@MAGIC1
       JNE  CHK8
       C    @HDRCPY+2,@MAGIC2
       JNE  CHK8
       CLR  R14                sum
       MOV  @H.LENH,R0         pages = length / 4096 (+1 for a part)
       MOV  @H.LENL,R1
       MOV  R1,R15
       ANDI R15,>0FFF          bytes in the last page
       SRL  R1,12
       SLA  R0,4
       SOC  R0,R1
       MOV  R1,@VT1            full pages
       CLR  @VT2               page
CHK2   MOV  @VT2,R2
       LI   R3,MAPRGB
       BL   @MAPWIN
       LI   R1,WINB
       LI   R2,>1000           a full page ...
       C    @VT2,@VT1
       JL   CHK3
       MOV  R15,R2             ... or the part of the last one
       JEQ  CHK6
CHK3   MOV  @VT2,R0
       JNE  CHK4
       AI   R1,64              page 0: the header is not counted
       AI   R2,-64
CHK4   CLR  R0
CHK5   MOVB *R1+,R0
       SWPB R0
       A    R0,R14
       CLR  R0
       DEC  R2
       JNE  CHK5
       INC  @VT2
       C    @VT2,@VT1
       JLE  CHK2
CHK6   SETO @CURB
       C    R14,@H.CSUM
       JNE  CHK9
       .leave
       RT
CHK8   LI   R1,SNOTST
       B    @FATAL
CHK9   LI   R1,SBADCK
       B    @FATAL
MAGIC1 TEXT 'TX'
MAGIC2 TEXT 'A1'

* KEEPDY / PRISTN - copy the dynamic area (at most 16K: story pages 0-3)
* to pages PRPAGE on, or back.  Window A shows the story page, window B
* the copy's page; MAPWIN adds STPAGE, so the copy's pages are named
* PRPAGE-STPAGE+i.
KEEPDY .enter
       CLR  R15                0 = to the copy
       JMP  KPD0
PRISTN .enter
       SETO R15                -1 = back from the copy
KPD0   CLR  @VT2
KPD1   MOV  @VT2,R2
       LI   R3,MAPRGA
       BL   @MAPWIN
       MOV  @VT2,R2
       AI   R2,PRPAGE-STPAGE
       LI   R3,MAPRGB
       BL   @MAPWIN
       LI   R0,WINA
       LI   R1,WINB
       MOV  R15,R15
       JEQ  KPD2
       LI   R0,WINB
       LI   R1,WINA
KPD2   LI   R2,2048
KPD3   MOV  *R0+,*R1+
       DEC  R2
       JNE  KPD3
       INC  @VT2
       MOV  @VT2,R0
       CI   R0,4
       JL   KPD1
       SETO @CURB
       .leave
       RT

* VMERR - a run-time error: R1 = the message (a length byte, then text
* in which bytes 1, 2, 3 stand for ERRN1-3 printed as numbers).  The
* wording matches txvm.py, so the transcripts agree.  Then the end.
VMERR  MOV  R1,@VT1
       LI   R1,SERR1
       BL   @CHSTR
       MOV  @VT1,R1
       MOVB *R1+,R0
       SRL  R0,8
       MOV  R0,@VT2
       MOV  R1,@VT1
VME1   MOV  @VT2,R0
       JEQ  VME3
       MOV  @VT1,R1
       MOVB *R1+,R0
       SRL  R0,8
       MOV  R1,@VT1
       DEC  @VT2
       CI   R0,4
       JHE  VME2
       MOV  R0,R2              1, 2, 3: a number
       DEC  R2
       SLA  R2,1
       MOV  @ERRN1(R2),R1
       BL   @PRNUM
       JMP  VME1
VME2   BL   @CHOUT
       JMP  VME1
VME3   LI   R1,SERR2
       BL   @CHSTR

* VMEND - the game is over: write the last line, say so, wait for a
* key, and go back to the title screen.  VMHALT is where the tests stop.
VMEND  BL   @FLUSH
VMHALT BL   @ROWFIT
       MOV  @CROW,R0
       LI   R1,0
       BL   @TXAT
       LI   R1,SENDGM
       LI   R2,>8000
       BL   @TXSTR
       BL   @WAITKY
       B    @QUIT

* FATAL - a message on row 2 and the end (before the story runs).
FATAL  MOV  R1,@VT1
       LI   R0,2
       LI   R1,2
       BL   @TXAT
       MOV  @VT1,R1
       CLR  R2
       BL   @TXSTR
       BL   @WAITKY
       B    @QUIT

* NOF18 - no F18A: Graphics I, which every VDP shows.
NOF18  LI   R1,NOFREG
NOF1   MOV  *R1+,R0
       JEQ  NOF2
       BL   @VDPWR
       JMP  NOF1
NOF2   LI   R0,NAMTAB
       LI   R1,>2000
       LI   R2,768
       BL   @VFILL
       LI   R0,GM1COL
       LI   R1,>F100
       LI   R2,32
       BL   @VFILL
       LI   R0,PATTAB+(32*8)
       LI   R1,FONT
       LI   R2,95*8
       BL   @VMBW
       LI   R0,NAMTAB+(10*32)+2
       LI   R1,SNOF18+1
       LI   R2,SNOF18X-SNOF18-1
       BL   @VMBW
       BL   @WAITKY
       B    @QUIT
NOFREG DATA >8000,>81E0,>8200,>8300+(GM1COL/>40),>8402,>8530,>8604,>8701,0

* QUIT - the hardware back as the console expects it, then its title.
QUIT   MOV  @F18FLG,R0
       JEQ  QT1
       BL   @F18RST
QT1    BL   @AMSOFF
       BLWP @>0000

D128   DATA 128
SERR1  BYTE SERR1X-SERR1-1
       BYTE 10
       TEXT '[TXA run-time error: '
SERR1X
SERR2  BYTE SERR2X-SERR2-1
       TEXT ']'
       BYTE 10
SERR2X
SENDGM BYTE SENDGMX-SENDGM-1
       TEXT '[End of story: press a key]'
SENDGMX
SNOSMS BYTE SNOSMSX-SNOSMS-1
       TEXT 'TXA needs a SAMS card of 512K or more on this TI.'
SNOSMSX
SNOTST BYTE SNOTSTX-SNOTST-1
       TEXT 'There is no TXA story in this cartridge.'
SNOTSTX
SBADCK BYTE SBADCKX-SBADCK-1
       TEXT 'The story is damaged: its checksum does not match.'
SBADCKX
SNOF18 BYTE SNOF18X-SNOF18-1
       TEXT 'TXA NEEDS AN F18A OR PICO9918'
SNOF18X
* run-time error messages (bytes 1-3: ERRN1-3)
EDIV0  BYTE EDIV0X-EDIV0-1
       TEXT 'division by zero'
EDIV0X
ENOOBJ BYTE ENOOBJX-ENOOBJ-1
       TEXT 'object '
       BYTE 1
       TEXT ' does not exist'
ENOOBJX
EINSLF BYTE EINSLFX-EINSLF-1
       TEXT 'cannot move object '
       BYTE 1
       TEXT ' inside itself'
EINSLFX
ENOPRP BYTE ENOPRPX-ENOPRP-1
       TEXT 'object '
       BYTE 1
       TEXT ' has no property '
       BYTE 2
       TEXT ' to change'
ENOPRPX
EINDEX BYTE EINDEXX-EINDEX-1
       TEXT 'index '
       BYTE 1
       TEXT ' is outside array '
       BYTE 2
       TEXT ' (0 to '
       BYTE 3
       TEXT ')'
EINDEXX
ENOARR BYTE ENOARRX-ENOARR-1
       TEXT 'array '
       BYTE 1
       TEXT ' does not exist'
ENOARRX
ENEST  BYTE ENESTX-ENEST-1
       TEXT 'routines nested too deeply'
ENESTX
ELOCAL BYTE ELOCALX-ELOCAL-1
       TEXT 'local '
       BYTE 1
       TEXT ' does not exist in this routine'
ELOCALX
EBADOP BYTE EBADOPX-EBADOP-1
       TEXT 'unknown opcode '
       BYTE 1
EBADOPX
       EVEN
TITLEB EQU  H.TITL-1           a length byte (16), set by CHKST, then the title
