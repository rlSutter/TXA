*======================================================================
* engine.a99 - the TXA engine: boot, load the story, run it.
*
* M1 form: the story image travels in the cartridge after the engine
* (tools/build.py puts it there and writes gen/storysrc.a99 saying
* where).  The engine copies it into SAMS from page STPAGE, checks the
* checksum against the header, keeps a pristine copy of the dynamic
* area for RESTART, and calls Main.  M4 loads the same image from disk
* files instead.
*
* Screen: 80 columns, 30 rows; the status line (row 0) shows the title;
* the text window is rows 1-29.  The picture pane comes in M4.
*======================================================================


* VMRUN - start the story: empty stacks, call Main with no arguments.
* Main's frame returns to page -1, which RETV takes as the game's end.
* START (startup.a99) branches here once everything is loaded.
VMRUN  LI   R6,VSTK
       LI   R0,FRAMES
       MOV  R0,@FREND
       MOV  R0,R7
       CLR  R8
       SETO @NEWSLF
       SETO @CURBH
       SETO R5                 "return" page: the end
       CLR  R4
       MOV  @H.ENTR,R15
       CLR  R14
       B    @GOCALL

* LOADST - copy the story from the cartridge banks into SAMS: each 8K
* bank fills two pages, through windows A and B (>E000->FFFF).  The
* engine runs from RAM, so switching cartridge banks is safe here.
KEEPDY .enter
       CLR  R15                0 = to the copy
       JMP  KPD0
PRISTN .enter
       SETO R15                -1 = back from the copy
KPD0   CLR  @VT2
KPD1   MOV  @VT2,R2
       LI   R3,MAPRGA
       BL   @MAPWIN
       MOV  @VT2,R2
       AI   R2,PRPAGE-STPAGE
       LI   R3,MAPRGB
       BL   @MAPWIN
       LI   R0,WINA
       LI   R1,WINB
       MOV  R15,R15
       JEQ  KPD2
       LI   R0,WINB
       LI   R1,WINA
KPD2   LI   R2,2048
KPD3   MOV  *R0+,*R1+
       DEC  R2
       JNE  KPD3
       INC  @VT2
       MOV  @VT2,R0
       CI   R0,4
       JL   KPD1
       SETO @CURBH
       .leave
       RT

* GLOAD - copy the 240 globals from the story (SAMS) into GLOBRM.
* GSYNC - copy them back, before anything copies the dynamic area.
GLOAD  .enter
       CLR  @VT1
       MOV  @H.GLOB,R1
GLD1   BL   @RDW
       MOV  @VT1,R2
       MOV  R0,@GLOBRM(R2)
       INCT R1
       INCT @VT1
       MOV  @VT1,R2
       CI   R2,480
       JL   GLD1
       .leave
       RT
GSYNC  .enter
       CLR  @VT1
       MOV  @H.GLOB,R1
GSY1   MOV  @VT1,R2
       MOV  @GLOBRM(R2),R0
       BL   @WRW
       INCT R1
       INCT @VT1
       MOV  @VT1,R2
       CI   R2,480
       JL   GSY1
       .leave
       RT

* VMERR - a run-time error: R1 = the message (a length byte, then text
* in which bytes 1, 2, 3 stand for ERRN1-3 printed as numbers).  The
* wording matches txvm.py, so the transcripts agree.  Then the end.
VMERR  MOV  R1,@VT1
       LI   R1,SERR1
       BL   @CHSTR
       MOV  @VT1,R1
       MOVB *R1+,R0
       SRL  R0,8
       MOV  R0,@VT2
       MOV  R1,@VT1
VME1   MOV  @VT2,R0
       JEQ  VME3
       MOV  @VT1,R1
       MOVB *R1+,R0
       SRL  R0,8
       MOV  R1,@VT1
       DEC  @VT2
       CI   R0,4
       JHE  VME2
       MOV  R0,R2              1, 2, 3: a number
       DEC  R2
       SLA  R2,1
       MOV  @ERRN1(R2),R1
       BL   @PRNUM
       JMP  VME1
VME2   BL   @CHOUT
       JMP  VME1
VME3   LI   R1,SERR2
       BL   @CHSTR

* VMEND - the game is over: write the last line, say so, wait for a
* key, and go back to the title screen.  VMHALT is where the tests stop.
VMEND  BL   @FLUSH
VMHALT BL   @ROWFIT
       MOV  @CROW,R0
       LI   R1,0
       BL   @TXAT
       LI   R1,SENDGM
       CLR  R2
       BL   @TXSTR
       MOV  @CROW,R0           in reverse colours
       MPY  @D80,R0
       MOV  R1,R0
       LI   R2,SENDGMX-SENDGM-1
       BL   @REVSPN
       BL   @WAITKY
       B    @QUIT

* FATAL - a message on row 2 and the end (before the story runs).
QUIT   MOV  @F18FLG,R0
       JEQ  QT1
       BL   @F18RST
QT1    BLWP @SOFFV            the chip quiet
       BL   @AMSOFF
       CLR  @>6000             the cartridge on bank 0, its header's: the
*                              console's reset keeps the bank last selected
*                              (a cartridge game reads its story from other
*                              banks; Run leaves the workbench on its own)
       LI   R0,>8320           the scratchpad above this workspace cleared:
QT2    CLR  *R0+               the fast block lives there, over the console's
       CI   R0,>8400           user interrupt hook (>83C4) and sound count
       JL   QT2                (>83CE); the console's power-up enables
*                              interrupts before it clears them, and a stale
*                              hook hangs it (the screen stays on the game's
*                              text, in 40 columns: Rebecca, js99er)
       BLWP @>0000

D128   DATA 128
TXTPAL DATA >0BBB,>0FFF        14: soft light gray (normal), 15: white (bold)
SERR1  BYTE SERR1X-SERR1-1
       BYTE 10
       TEXT '[TXA run-time error: '
SERR1X
SERR2  BYTE SERR2X-SERR2-1
       TEXT ']'
       BYTE 10
SERR2X
SENDGM BYTE SENDGMX-SENDGM-1
       TEXT '[End of story: press a key]'
SENDGMX
EDIV0  BYTE EDIV0X-EDIV0-1
       TEXT 'division by zero'
EDIV0X
ENOOBJ BYTE ENOOBJX-ENOOBJ-1
       TEXT 'object '
       BYTE 1
       TEXT ' does not exist'
ENOOBJX
EINSLF BYTE EINSLFX-EINSLF-1
       TEXT 'cannot move object '
       BYTE 1
       TEXT ' inside itself'
EINSLFX
ENOPRP BYTE ENOPRPX-ENOPRP-1
       TEXT 'object '
       BYTE 1
       TEXT ' has no property '
       BYTE 2
       TEXT ' to change'
ENOPRPX
EINDEX BYTE EINDEXX-EINDEX-1
       TEXT 'index '
       BYTE 1
       TEXT ' is outside array '
       BYTE 2
       TEXT ' (0 to '
       BYTE 3
       TEXT ')'
EINDEXX
ENOARR BYTE ENOARRX-ENOARR-1
       TEXT 'array '
       BYTE 1
       TEXT ' does not exist'
ENOARRX
EATTR  BYTE EATTRX-EATTR-1
       TEXT 'attribute '
       BYTE 1
       TEXT ' does not exist'
EATTRX
ENEST  BYTE ENESTX-ENEST-1
       TEXT 'routines nested too deeply'
ENESTX
ELOCAL BYTE ELOCALX-ELOCAL-1
       TEXT 'local '
       BYTE 1
       TEXT ' does not exist in this routine'
ELOCALX
EBADOP BYTE EBADOPX-EBADOP-1
       TEXT 'unknown opcode '
       BYTE 1
EBADOPX
       EVEN
TITLEB EQU  H.TITL-1           a length byte (16), set by CHKST, then the title

* DSKFIX - after a disk call (disk.a99): the fast block back into the
* scratchpad, which a DSR overwrites from >834A.
DSKFIX LI   R1,FSTSRC
       LI   R2,NEXT
       LI   R3,(FASTND-NEXT)/2
DFX1   MOV  *R1+,*R2+
       DEC  R3
       JNE  DFX1
       RT
